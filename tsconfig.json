{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "backend/*": [
        "src/backend/*"
      ],
      "public/*": [
        "src/public/*"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "types/**/*.d.ts"
  ]
}
