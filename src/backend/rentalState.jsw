import wixData from "wix-data";
import wixUsersBackend from "wix-users-backend";

const ALLOWED = new Set(["Booking", "Active Rental", "Pre Check-In", "Closed Rental"]);

export async function setRentalState({ bookingId, rentalState, note }) {
  try {
    if (!bookingId) return { success: false, message: "Missing bookingId" };
    if (!ALLOWED.has(String(rentalState))) return { success: false, message: "Invalid rentalState" };

    const b = await wixData.get("Bookings", bookingId, { suppressAuth: true });
    if (!b) return { success: false, message: "Booking not found" };

    // Δεν αλλάζουμε canceled από εδώ (ασφάλεια)
    if (String(b.status || "Pending") === "Canceled") {
      return { success: false, message: "Canceled booking cannot change rentalState" };
    }

    const userId = wixUsersBackend.currentUser?.id || null;
    const now = new Date();

    b.rentalState = String(rentalState);
    b.rentalStateChangedAt = now;
    b.rentalStateChangedBy = userId;
    b.rentalStateNote = note ? String(note) : "";

    await wixData.update("Bookings", b, { suppressAuth: true });
    return { success: true };
  } catch (err) {
    return { success: false, message: err?.message || String(err) };
  }
}