import wixData from 'wix-data';
import * as bookingConfig from 'backend/bookingConfig.js';

export const PRICING_COLLECTIONS = {
  businessSettings: 'BusinessSettings',
  insurancePlans: 'InsurancePlans',
  extraServices: 'ExtraServices',
  feeRules: 'FeeRules',
  pricingSeasons: 'PricingSeasons',
  categoryRateRules: 'CategoryRateRules',
  pickupLocations: 'PickupLocations'
};

const CACHE_TTL_MS = 60 * 1000;
let cache = { public: null, all: null };

function now(){ return Date.now(); }
function hasFresh(entry){ return !!entry && (now() - Number(entry.ts || 0) < CACHE_TTL_MS); }
function readBool(value, fallback = false){ if (typeof value === 'boolean') return value; if (typeof value === 'number') return value !== 0; const raw = String(value ?? '').trim().toLowerCase(); if (!raw) return fallback; return ['1','true','yes','y','on'].includes(raw); }
function toNumber(value, fallback = 0){ const num = Number(value); return Number.isFinite(num) ? num : fallback; }
function text(value, fallback = ''){ const out = String(value ?? '').trim(); return out || fallback; }
function sortByOrder(a, b){ const sa = toNumber(a?.sortOrder, 9999); const sb = toNumber(b?.sortOrder, 9999); if (sa !== sb) return sa - sb; return text(a?.label).localeCompare(text(b?.label), 'el'); }
async function safeQuery(collectionName, queryBuilder){ try { const q = typeof queryBuilder === 'function' ? queryBuilder(wixData.query(collectionName)) : wixData.query(collectionName); const res = await q.limit(1000).find({ suppressAuth: true }); return Array.isArray(res?.items) ? res.items : []; } catch (_) { return []; } }

