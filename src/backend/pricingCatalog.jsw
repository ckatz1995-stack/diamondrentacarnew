function normalizeKey(value){ return text(value, '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9]+/g, '_').replace(/^_+|_+$/g, '').replace(/_{2,}/g, '_').toLowerCase(); }
function normalizeStationProfiles(rows = []){
  const list = Array.isArray(rows) ? rows : [];
  const out = [];
  list.forEach((row) => {
    const key = normalizeKey(row?.key || row?.stationKey || row?.label || row?.stationLabel || 'default') || 'default';
    const label = text(row?.label || row?.stationLabel || row?.station || '', 'Κεντρικός σταθμός');
    const description = text(row?.description || '');
    const city = text(row?.city || row?.stationCity || '');
    const address = text(row?.address || row?.stationAddress || '');
    const sortOrder = toNumber(row?.sortOrder, 9999);
    const active = readBool(row?.active, true);
    if (!out.some((it) => it.key === key)) out.push({ key, label, description, city, address, sortOrder, active });
  });
  if (!out.length) out.push({ key:'default', label:'Κεντρικός σταθμός', description:'' });
  return out;
}
function normalizeStationSettingsMap(value){
  const input = value && typeof value === 'object' && !Array.isArray(value) ? value : {};
  const out = {};
  Object.keys(input).forEach((rawKey) => {
    const key = normalizeKey(rawKey) || 'default';
    const row = input[rawKey];
    if (!row || typeof row !== 'object' || Array.isArray(row)) return;
    out[key] = { ...row };
  });
  return out;
}

function normalizeBusinessSettings(item){
  const vatRate = toNumber(item?.vatRate, DEFAULT_BUSINESS_SETTINGS.vatRate);
  return {
    ...DEFAULT_BUSINESS_SETTINGS,
    _id: item?._id || '',
    title: text(item?.title, DEFAULT_BUSINESS_SETTINGS.title),
    currency: text(item?.currency, DEFAULT_BUSINESS_SETTINGS.currency),
    vatRate,
    vatRateDecimal: vatRate > 1 ? vatRate / 100 : vatRate || VAT_RATE,
    nightStartHour: toNumber(item?.nightStartHour, DEFAULT_BUSINESS_SETTINGS.nightStartHour),
    nightEndHour: toNumber(item?.nightEndHour, DEFAULT_BUSINESS_SETTINGS.nightEndHour),
    defaultDeposit: toNumber(item?.defaultDeposit, DEFAULT_BUSINESS_SETTINGS.defaultDeposit),
    companyName: text(item?.companyName, DEFAULT_BUSINESS_SETTINGS.companyName),
    companyTagline: text(item?.companyTagline, DEFAULT_BUSINESS_SETTINGS.companyTagline),
    companyPhone: text(item?.companyPhone, DEFAULT_BUSINESS_SETTINGS.companyPhone),
    companyEmail: text(item?.companyEmail, DEFAULT_BUSINESS_SETTINGS.companyEmail),
    operatingHoursLabel: text(item?.operatingHoursLabel, DEFAULT_BUSINESS_SETTINGS.operatingHoursLabel),
    afterHoursNotice: text(item?.afterHoursNotice, DEFAULT_BUSINESS_SETTINGS.afterHoursNotice),
    allowOverbooking: readBool(item?.allowOverbooking, DEFAULT_BUSINESS_SETTINGS.allowOverbooking),
    enableTriggeredEmails: readBool(item?.enableTriggeredEmails, DEFAULT_BUSINESS_SETTINGS.enableTriggeredEmails),
    bookingConfirmedTriggerId: text(item?.bookingConfirmedTriggerId, DEFAULT_BUSINESS_SETTINGS.bookingConfirmedTriggerId),
    bookingCanceledTriggerId: text(item?.bookingCanceledTriggerId, DEFAULT_BUSINESS_SETTINGS.bookingCanceledTriggerId),
    vehiclesPageDisplayMode: ['models', 'categories'].includes(text(item?.vehiclesPageDisplayMode, '').toLowerCase()) ? text(item?.vehiclesPageDisplayMode, DEFAULT_BUSINESS_SETTINGS.vehiclesPageDisplayMode).toLowerCase() : DEFAULT_BUSINESS_SETTINGS.vehiclesPageDisplayMode,
    vehiclesPageModelsSource: ['vehicles', 'fleet'].includes(text(item?.vehiclesPageModelsSource, '').toLowerCase()) ? text(item?.vehiclesPageModelsSource, DEFAULT_BUSINESS_SETTINGS.vehiclesPageModelsSource).toLowerCase() : DEFAULT_BUSINESS_SETTINGS.vehiclesPageModelsSource,
    companyAddress: text(item?.companyAddress, DEFAULT_BUSINESS_SETTINGS.companyAddress),
    companyCity: text(item?.companyCity, DEFAULT_BUSINESS_SETTINGS.companyCity),
    footerNote: text(item?.footerNote, DEFAULT_BUSINESS_SETTINGS.footerNote),
    insuranceTermsTitle: text(item?.insuranceTermsTitle, DEFAULT_BUSINESS_SETTINGS.insuranceTermsTitle),
    insuranceTermsIntro: text(item?.insuranceTermsIntro, DEFAULT_BUSINESS_SETTINGS.insuranceTermsIntro),
    insuranceTermsBody: text(item?.insuranceTermsBody, DEFAULT_BUSINESS_SETTINGS.insuranceTermsBody),
    insuranceDetailsTitle: text(item?.insuranceDetailsTitle, DEFAULT_BUSINESS_SETTINGS.insuranceDetailsTitle),
    insuranceDetailsIntro: text(item?.insuranceDetailsIntro, DEFAULT_BUSINESS_SETTINGS.insuranceDetailsIntro),
    insuranceDetailsBody: text(item?.insuranceDetailsBody, DEFAULT_BUSINESS_SETTINGS.insuranceDetailsBody),
    rentalTermsTitle: text(item?.rentalTermsTitle, DEFAULT_BUSINESS_SETTINGS.rentalTermsTitle),
    rentalTermsIntro: text(item?.rentalTermsIntro, DEFAULT_BUSINESS_SETTINGS.rentalTermsIntro),
    rentalTermsBody: text(item?.rentalTermsBody, DEFAULT_BUSINESS_SETTINGS.rentalTermsBody),
    rentalRequirementsBody: text(item?.rentalRequirementsBody, DEFAULT_BUSINESS_SETTINGS.rentalRequirementsBody),
    rentalPoliciesBody: text(item?.rentalPoliciesBody, DEFAULT_BUSINESS_SETTINGS.rentalPoliciesBody),
    rentalPrivacyBody: text(item?.rentalPrivacyBody, DEFAULT_BUSINESS_SETTINGS.rentalPrivacyBody),
    stationProfiles: normalizeStationProfiles(item?.stationProfiles),
    stationSettings: normalizeStationSettingsMap(item?.stationSettings),
    dailyRateLabel: text(item?.dailyRateLabel, ''),
    daysLabel: text(item?.daysLabel, ''),
    bookingSummaryLabel: text(item?.bookingSummaryLabel, ''),
    baseChargeLabel: text(item?.baseChargeLabel, ''),
    insuranceLabel: text(item?.insuranceLabel, ''),
    extrasLabel: text(item?.extrasLabel, ''),
    locationFeeLabel: text(item?.locationFeeLabel, ''),
    ageFeeLabel: text(item?.ageFeeLabel, ''),
    nightFeeLabel: text(item?.nightFeeLabel, ''),
    grandTotalLabel: text(item?.grandTotalLabel, ''),
    noExtrasLabel: text(item?.noExtrasLabel, ''),
    active: readBool(item?.active, true)
  };
}
function normalizeInsurance(item, fallbackSort = 9999){ return { _id: item?._id || '', key: normalizeKey(item?.key || item?.slug || item?.code || item?.label || item?.title), label: text(item?.label || item?.title, ''), description: text(item?.description, ''), pricePerDay: toNumber(item?.pricePerDay ?? item?.price, 0), billingMode: 'perDay', active: readBool(item?.active, true), publicVisible: readBool(item?.publicVisible, true), sortOrder: toNumber(item?.sortOrder, fallbackSort) }; }
function normalizeExtra(item, fallbackSort = 9999){ return { _id: item?._id || '', key: normalizeKey(item?.key || item?.slug || item?.code || item?.label || item?.title), label: text(item?.label || item?.title, ''), description: text(item?.description, ''), price: toNumber(item?.price ?? item?.pricePerDay, 0), billingMode: text(item?.billingMode || item?.mode, 'perDay') === 'perBooking' ? 'perBooking' : 'perDay', active: readBool(item?.active, true), publicVisible: readBool(item?.publicVisible, true), sortOrder: toNumber(item?.sortOrder, fallbackSort) }; }
function normalizeFeeRule(item, fallbackSort = 9999){ return { _id: item?._id || '', key: normalizeKey(item?.key || item?.slug || item?.code || item?.label || item?.title), label: text(item?.label || item?.title, ''), description: text(item?.description, ''), ruleType: text(item?.ruleType, 'manual'), audienceGroup: text(item?.audienceGroup, ''), amount: toNumber(item?.amount ?? item?.price, 0), billingMode: text(item?.billingMode || item?.mode, 'perBooking') === 'perDay' ? 'perDay' : 'perBooking', active: readBool(item?.active, true), publicVisible: readBool(item?.publicVisible, true), sortOrder: toNumber(item?.sortOrder, fallbackSort) }; }
function normalizeSeason(item, fallbackSort = 9999){
  const startDate = text(item?.startDate || item?.start || item?.fromDate, '');
  const endDate = text(item?.endDate || item?.end || item?.toDate, '');
  return {
    _id: item?._id || '',
    key: normalizeKey(item?.key || item?.slug || item?.code || item?.label || item?.title || `${startDate}_${endDate}`),
    label: text(item?.label || item?.title, ''),
    description: text(item?.description, ''),
    startDate,
    endDate,
    active: readBool(item?.active, true),
    publicVisible: readBool(item?.publicVisible, true),
    sortOrder: toNumber(item?.sortOrder, fallbackSort),
    priority: toNumber(item?.priority, 0),
    repeatYearly: readBool(item?.repeatYearly, false)
  };
}
function normalizeCategoryRateRule(item, fallbackSort = 9999){
  return {
    _id: item?._id || '',
    key: normalizeKey(item?.key || item?.slug || item?.code || item?.label || item?.title || `${item?.categoryCode || ''}_${item?.seasonKey || ''}_${item?.minDays || ''}_${item?.maxDays || ''}`),
    label: text(item?.label || item?.title, ''),
    description: text(item?.description, ''),
    categoryCode: text(item?.categoryCode || item?.category || item?.Category, '').toUpperCase(),
    vehicleCategoryId: text(item?.vehicleCategoryId || item?.categoryId || item?.vehicleId, ''),
    seasonKey: normalizeKey(item?.seasonKey || item?.season || item?.seasonCode || item?.seasonId || ''),
    minDays: Math.max(1, Math.floor(toNumber(item?.minDays, 1))),
    maxDays: Math.max(0, Math.floor(toNumber(item?.maxDays, 0))),
    pricePerDay: toNumber(item?.pricePerDay ?? item?.dailyPrice ?? item?.price, 0),
    active: readBool(item?.active, true),
    publicVisible: readBool(item?.publicVisible, true),
    sortOrder: toNumber(item?.sortOrder, fallbackSort)
  };
}

function normalizePickupLocation(item, fallbackSort = 9999){
  return {
    _id: item?._id || '',
    key: normalizeKey(item?.key || item?.slug || item?.code || item?.label || item?.title || item?.address || ''),
    label: text(item?.label || item?.title, ''),
    description: text(item?.description, ''),
    locationType: text(item?.locationType || item?.type, 'both') || 'both',
    address: text(item?.address, ''),
    stationKey: normalizeKey(item?.stationKey || item?.stationCode || item?.station || item?.hub || item?.group || 'default') || 'default',
    stationLabel: text(item?.stationLabel || item?.station || item?.hubLabel || item?.hub || item?.groupLabel || item?.group, 'Κεντρικός σταθμός') || 'Κεντρικός σταθμός',
    mapUrl: text(item?.mapUrl || item?.mapsUrl || item?.googleMapsUrl, ''),
    extraFee: toNumber(item?.extraFee ?? item?.fee ?? item?.price, 0),
    active: readBool(item?.active, true),
    publicVisible: readBool(item?.publicVisible, true),
    sortOrder: toNumber(item?.sortOrder, fallbackSort)
  };
}

function parseDateOnly(value){
  const raw = text(value, '');
  if (!raw) return null;
  const dt = new Date(raw);
  if (Number.isNaN(dt.getTime())) return null;
  dt.setHours(0,0,0,0);
  return dt;
}
function seasonMatchesDate(date, season){
  if (!(date instanceof Date) || Number.isNaN(date.getTime())) return false;
  const start = parseDateOnly(season?.startDate);
  const end = parseDateOnly(season?.endDate);
  if (!start || !end) return false;
  const check = new Date(date);
  check.setHours(0,0,0,0);
  if (season?.repeatYearly) {
    const monthDay = (d) => ({ m: d.getUTCMonth() + 1, day: d.getUTCDate() });
    const s = monthDay(start);
    const e = monthDay(end);
    const c = monthDay(check);
    const cv = c.m * 100 + c.day;
    const sv = s.m * 100 + s.day;
    const ev = e.m * 100 + e.day;
    return sv <= ev ? (cv >= sv && cv <= ev) : (cv >= sv || cv <= ev);
  }
  return check >= start && check <= end;
}
function findActiveSeason(pricingSeasons = [], pickupDateTime){
  const rows = Array.isArray(pricingSeasons) ? pricingSeasons.filter((row) => row && row.active !== false) : [];
  const matches = rows.filter((row) => seasonMatchesDate(pickupDateTime, row));
  matches.sort((a, b) => {
    const pa = toNumber(b?.priority, 0) - toNumber(a?.priority, 0);
    if (pa !== 0) return pa;
    return sortByOrder(a, b);
  });
  return matches[0] || null;
}

function mergeRowsByKey(defaultRows, cmsRows){
  const map = new Map();
  defaultRows.forEach((row) => { const key = normalizeKey(row?.key); if (key) map.set(key, { ...row, key }); });
  cmsRows.forEach((row) => {
    const key = normalizeKey(row?.key);
    if (!key) return;
    const base = map.get(key) || {};
    const merged = { ...base, ...row, key, _id: row._id || base._id || '' };
    map.set(key, merged);
  });
  return Array.from(map.values()).filter((item) => item.key && item.label);
}

function buildInsuranceMap(rows = []){ const out = {}; rows.forEach((item) => { if (item?.key) out[item.key] = toNumber(item.pricePerDay, 0); }); return out; }
function buildExtraMap(rows = []){ const out = {}; rows.forEach((item) => { if (item?.key) out[item.key] = { price: toNumber(item.price, 0), mode: text(item.billingMode, 'perDay') === 'perBooking' ? 'perBooking' : 'perDay', label: text(item.label || item.key) }; }); return out; }

async function readBusinessSettings(){ const items = await safeQuery(PRICING_COLLECTIONS.businessSettings, (q) => q.ascending('_createdDate')); return normalizeBusinessSettings(items[0] || DEFAULT_BUSINESS_SETTINGS); }
async function readInsurancePlans(scope = 'public'){ const items = await safeQuery(PRICING_COLLECTIONS.insurancePlans, (q) => q.ascending('sortOrder')); const defaults = FALLBACK_INSURANCE_OPTIONS.map((item, index) => normalizeInsurance(item, (index + 1) * 10)); const cmsRows = items.map((item, index) => normalizeInsurance(item, (index + 1) * 10)); let rows = mergeRowsByKey(defaults, cmsRows).filter((item) => item.active !== false); if (scope === 'public') rows = rows.filter((item) => item.publicVisible !== false); return rows.sort(sortByOrder); }
async function readExtraServices(scope = 'public'){ const items = await safeQuery(PRICING_COLLECTIONS.extraServices, (q) => q.ascending('sortOrder')); const defaults = FALLBACK_EXTRA_OPTIONS.map((item, index) => normalizeExtra(item, (index + 1) * 10)); const cmsRows = items.map((item, index) => normalizeExtra(item, (index + 1) * 10)); let rows = mergeRowsByKey(defaults, cmsRows).filter((item) => item.active !== false); if (scope === 'public') rows = rows.filter((item) => item.publicVisible !== false); return rows.sort(sortByOrder); }
async function readFeeRules(scope = 'public'){ const items = await safeQuery(PRICING_COLLECTIONS.feeRules, (q) => q.ascending('sortOrder')); const defaults = FALLBACK_FEE_RULES.map((item, index) => normalizeFeeRule(item, (index + 1) * 10)); const cmsRows = items.map((item, index) => normalizeFeeRule(item, (index + 1) * 10)); let rows = mergeRowsByKey(defaults, cmsRows).filter((item) => item.active !== false); if (scope === 'public') rows = rows.filter((item) => item.publicVisible !== false); return rows.sort(sortByOrder); }
async function readPricingSeasons(scope = 'all'){ const items = await safeQuery(PRICING_COLLECTIONS.pricingSeasons, (q) => q.ascending('sortOrder')); let rows = items.map((item, index) => normalizeSeason(item, (index + 1) * 10)).filter((item) => item.active !== false); if (scope === 'public') rows = rows.filter((item) => item.publicVisible !== false); return rows.sort(sortByOrder); }
async function readCategoryRateRules(scope = 'all'){ const items = await safeQuery(PRICING_COLLECTIONS.categoryRateRules, (q) => q.ascending('sortOrder')); let rows = items.map((item, index) => normalizeCategoryRateRule(item, (index + 1) * 10)).filter((item) => item.active !== false); if (scope === 'public') rows = rows.filter((item) => item.publicVisible !== false); return rows.sort(sortByOrder); }
async function readPickupLocations(scope = 'all'){ const items = await safeQuery(PRICING_COLLECTIONS.pickupLocations, (q) => q.ascending('sortOrder')); let rows = items.map((item, index) => normalizePickupLocation(item, (index + 1) * 10)).filter((item) => item.active !== false); if (scope === 'public') rows = rows.filter((item) => item.publicVisible !== false); return rows.sort(sortByOrder); }

function buildCatalogSnapshot({ businessSettings, insurancePlans, extraServices, feeRules, pricingSeasons, categoryRateRules, pickupLocations }){
  return {
    businessSettings,
    insurancePlans,
    extraServices,
    feeRules,
    pricingSeasons,
    categoryRateRules,
    pickupLocations,
    maps: {
      insurance: buildInsuranceMap(insurancePlans),
      extras: buildExtraMap(extraServices),
      fees: feeRules.reduce((acc, rule) => { if (rule.key) acc[rule.key] = rule; return acc; }, {}),
      pricingSeasons: (pricingSeasons || []).reduce((acc, season) => { if (season.key) acc[season.key] = season; return acc; }, {}),
      categoryRateRules: categoryRateRules || [],
      pickupLocations: pickupLocations || []
    }
  };
}

export async function getPricingCatalog(options = {}){
  const scope = options?.scope === 'all' ? 'all' : 'public';
  if (!options?.force && hasFresh(cache[scope])) return JSON.parse(JSON.stringify(cache[scope].value));
  const [businessSettings, insurancePlans, extraServices, feeRules, pricingSeasons, categoryRateRules, pickupLocations] = await Promise.all([
    readBusinessSettings(),
    readInsurancePlans(scope),
    readExtraServices(scope),
    readFeeRules(scope),
    readPricingSeasons(scope === 'public' ? 'public' : 'all'),
    readCategoryRateRules(scope === 'public' ? 'public' : 'all'),
    readPickupLocations(scope === 'public' ? 'public' : 'all')
  ]);
  const value = buildCatalogSnapshot({ businessSettings, insurancePlans, extraServices, feeRules, pricingSeasons, categoryRateRules, pickupLocations });
  cache[scope] = { ts: now(), value };
  return JSON.parse(JSON.stringify(value));
}
export async function getPublicPricingCatalog(){ return getPricingCatalog({ scope: 'public' }); }
export async function getPricingMaps(options = {}){ const catalog = await getPricingCatalog({ scope: options?.scope === 'all' ? 'all' : 'public', force: options?.force }); return { businessSettings: catalog.businessSettings, insurancePlans: catalog.insurancePlans, extraServices: catalog.extraServices, feeRules: catalog.feeRules, pricingSeasons: catalog.pricingSeasons || [], categoryRateRules: catalog.categoryRateRules || [], pickupLocations: catalog.pickupLocations || [], insuranceMap: catalog.maps.insurance, extrasMap: catalog.maps.extras, feeRulesMap: catalog.maps.fees, pickupLocationsMap: catalog.maps.pickupLocations || [] }; }
function athensHour(date, timeZone = 'Europe/Athens'){ const dtf = new Intl.DateTimeFormat('en-GB', { timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }); const parts = dtf.formatToParts(date); const lookup = (type) => Number((parts.find((part) => part.type === type) || {}).value || 0); return { hour: lookup('hour'), minute: lookup('minute') }; }
function isNightShift(date, businessSettings){ if (!(date instanceof Date) || Number.isNaN(date.getTime())) return false; const startHour = toNumber(businessSettings?.nightStartHour, DEFAULT_BUSINESS_SETTINGS.nightStartHour); const endHour = toNumber(businessSettings?.nightEndHour, DEFAULT_BUSINESS_SETTINGS.nightEndHour); const { hour } = athensHour(date, 'Europe/Athens'); return startHour > endHour ? (hour >= startHour || hour < endHour) : (hour >= startHour && hour < endHour); }
function feeRuleAmount(rule, fallback = 0){ return toNumber(rule?.amount, fallback); }
export function computeAutomaticFees({ driverAge, pickupDateTime, dropoffDateTime, businessSettings, feeRules = [] } = {}){ const settings = businessSettings || DEFAULT_BUSINESS_SETTINGS; const rules = Array.isArray(feeRules) ? feeRules : []; const ageText = text(driverAge, ''); const ageRule = rules.find((rule) => rule.ruleType === 'ageRange' && text(rule.audienceGroup) === ageText) || null; const ageFeeFallback = ageText === '19-22' ? 16 : (ageText === '70+' ? 10 : 0); const ageFee = feeRuleAmount(ageRule, ageFeeFallback); const nightPickupRule = rules.find((rule) => rule.ruleType === 'nightPickup') || rules.find((rule) => rule.ruleType === 'night'); const nightDropoffRule = rules.find((rule) => rule.ruleType === 'nightDropoff') || rules.find((rule) => rule.ruleType === 'night'); const pickupNight = isNightShift(pickupDateTime, settings) ? feeRuleAmount(nightPickupRule, 15) : 0; const dropoffNight = isNightShift(dropoffDateTime, settings) ? feeRuleAmount(nightDropoffRule, 15) : 0; return { ageFee: Number(ageFee.toFixed(2)), nightFee: Number((pickupNight + dropoffNight).toFixed(2)), appliedRules: { ageRule: ageRule ? { key: ageRule.key, label: ageRule.label, amount: ageFee } : null, pickupNight: pickupNight ? { key: nightPickupRule?.key || 'nightPickup', label: nightPickupRule?.label || 'Νυχτερινή χρέωση παραλαβής', amount: pickupNight } : null, dropoffNight: dropoffNight ? { key: nightDropoffRule?.key || 'nightDropoff', label: nightDropoffRule?.label || 'Νυχτερινή χρέωση επιστροφής', amount: dropoffNight } : null } }; }
export function getFallbackCatalogSnapshot(){ return buildCatalogSnapshot({ businessSettings: normalizeBusinessSettings(DEFAULT_BUSINESS_SETTINGS), insurancePlans: FALLBACK_INSURANCE_OPTIONS.map((item, index) => normalizeInsurance(item, (index + 1) * 10)), extraServices: FALLBACK_EXTRA_OPTIONS.map((item, index) => normalizeExtra(item, (index + 1) * 10)), feeRules: FALLBACK_FEE_RULES.map((item, index) => normalizeFeeRule(item, (index + 1) * 10)), pricingSeasons: [], categoryRateRules: [], pickupLocations: [] }); }
export function clearPricingCatalogCache(){ cache = { public: null, all: null }; return true; }

export function resolveDynamicPricingRate({ categoryCode = '', vehicleCategoryId = '', billableDays = 1, pickupDateTime = null, dropoffDateTime = null, catalog = null, fallbackPricePerDay = 0 } = {}) {
  void dropoffDateTime;
  const safeCatalog = catalog || {};
  const seasons = Array.isArray(safeCatalog.pricingSeasons) ? safeCatalog.pricingSeasons : [];
  const rules = Array.isArray(safeCatalog.categoryRateRules) ? safeCatalog.categoryRateRules : [];
  const resolvedSeason = findActiveSeason(seasons, pickupDateTime);
  const code = text(categoryCode, '').toUpperCase();
  const categoryId = text(vehicleCategoryId, '');
  const days = Math.max(1, Math.floor(toNumber(billableDays, 1)));
  const candidates = rules.filter((rule) => {
    if (!rule || rule.active === false) return false;
    if (code && text(rule.categoryCode, '').toUpperCase() && text(rule.categoryCode, '').toUpperCase() !== code) return false;
    if (!code && categoryId && text(rule.vehicleCategoryId, '') && text(rule.vehicleCategoryId, '') !== categoryId) return false;
    const minDays = Math.max(1, Math.floor(toNumber(rule.minDays, 1)));
    const maxDays = Math.max(0, Math.floor(toNumber(rule.maxDays, 0)));
    if (days < minDays) return false;
    if (maxDays > 0 && days > maxDays) return false;
    const ruleSeasonKey = normalizeKey(rule.seasonKey || '');
    if (resolvedSeason?.key) return !ruleSeasonKey || ruleSeasonKey === normalizeKey(resolvedSeason.key);
    return !ruleSeasonKey;
  });
  candidates.sort((a, b) => {
    const seasonMatchDiff = Number(normalizeKey(a?.seasonKey || '') === normalizeKey(resolvedSeason?.key || '')) - Number(normalizeKey(b?.seasonKey || '') === normalizeKey(resolvedSeason?.key || ''));
    if (seasonMatchDiff !== 0) return -seasonMatchDiff;
    const minA = Math.max(1, Math.floor(toNumber(a?.minDays, 1)));
    const minB = Math.max(1, Math.floor(toNumber(b?.minDays, 1)));
    if (minA !== minB) return minB - minA;
    const rangeA = Math.max(0, Math.floor(toNumber(a?.maxDays, 0))) || 999999;
    const rangeB = Math.max(0, Math.floor(toNumber(b?.maxDays, 0))) || 999999;
    const widthA = rangeA - minA;
    const widthB = rangeB - minB;
    if (widthA !== widthB) return widthA - widthB;
    return sortByOrder(a, b);
  });
  const rule = candidates[0] || null;
  const pricePerDay = rule ? toNumber(rule.pricePerDay, fallbackPricePerDay) : toNumber(fallbackPricePerDay, 0);
  return {
    pricePerDay,
    source: rule ? 'dynamicRule' : 'vehicleBasePrice',
    season: resolvedSeason ? { key: resolvedSeason.key, label: resolvedSeason.label, startDate: resolvedSeason.startDate, endDate: resolvedSeason.endDate } : null,
    rule: rule ? { key: rule.key, label: rule.label, minDays: rule.minDays, maxDays: rule.maxDays, seasonKey: rule.seasonKey, categoryCode: rule.categoryCode || code || '', pricePerDay: toNumber(rule.pricePerDay, 0) } : null
  };
}

