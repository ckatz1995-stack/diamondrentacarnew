import wixTriggeredEmails from 'wix-triggered-emails';
import { getPricingCatalog } from 'backend/pricingCatalog.jsw';

function normalizeTriggerId(value) {
    const out = String(value || '').trim();
    return out && !out.startsWith('PASTE_') ? out : '';
}

async function resolveTriggerIds() {
    try {
        const catalog = await getPricingCatalog({ scope: 'all' });
        const settings = catalog?.businessSettings || {};
        return {
            enabled: !!settings.enableTriggeredEmails,
            confirmed: normalizeTriggerId(settings.bookingConfirmedTriggerId),
            canceled: normalizeTriggerId(settings.bookingCanceledTriggerId)
        };
    } catch (err) {
        return { enabled: false, confirmed: '', canceled: '' };
    }
}

export async function sendEmail(toEmail, subject, message) {
    try {
        const subj = String(subject || '').toLowerCase();
        const triggerIds = await resolveTriggerIds();

        if (!triggerIds.enabled) {
            return { success: true, skipped: true, reason: 'Triggered emails disabled' };
        }

        let triggerId = '';
        if (subj.includes('confirm')) triggerId = triggerIds.confirmed;
        else if (subj.includes('cancel')) triggerId = triggerIds.canceled;

        if (!triggerId) {
            return { success: true, skipped: true, reason: 'Missing Trigger IDs' };
        }

        await wixTriggeredEmails.emailContact(triggerId, toEmail, {
            variables: {
                subject: subject || '',
                message: message || '',
                email: toEmail
            }
        });

        return { success: true };

    } catch (err) {
        return { success: false, message: (err && err.message) ? err.message : String(err) };
    }
}
