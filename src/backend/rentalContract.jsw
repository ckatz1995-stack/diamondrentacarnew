  if (type === 'receipt') base.document = { termsFocus:'receipt_ready_payload', paidTotal:300, balance:150 };
  return base;
}

async function runDocumentTemplateRegressionHarnessInternal(){
  const documentTypes = ['agreement', 'voucher', 'invoice', 'receipt'];
  const results = [];
  for (const type of documentTypes) {
    const pkg = buildSyntheticDocumentPackage(type);
    const printable = buildPrintableDocumentModelFromPackage(pkg);
    const html = renderContractDocumentHtmlFromPrintable({ packageData: pkg, printable });
    const checks = {
      hasWrapper: html.includes('class="doc-wrap"'),
      hasReadiness: html.includes('Readiness checks'),
      hasIdentity: html.includes('Customer / Driver'),
      hasMovement: html.includes('Rental movement'),
      hasVehicle: html.includes('Vehicle'),
      hasTypeClass: html.includes(`doc-type-${type}`),
      typeSpecific: type === 'agreement'
        ? html.includes('Signature')
        : (type === 'voucher' ? html.includes('Voucher confirmation') : (type === 'invoice' ? html.includes('Billing') : html.includes('Financial summary')))
    };
    const failed = Object.entries(checks).filter(([, ok]) => !ok).map(([name]) => name);
    let pdfSmoke = { attempted:false, ok:false, engine:'', fidelity:'', error:'' };
    try {
      const pdf = await renderPdfBufferFromHtmlAdapter(html, { title:`Regression ${type}` });
      pdfSmoke = {
        attempted: true,
        ok: !!(pdf?.buffer && pdf.buffer.length > 0),
        engine: safeText(pdf?.engine),
        fidelity: safeText(pdf?.fidelity),
        error: ''
      };
    } catch (e) {
      pdfSmoke = { attempted:true, ok:false, engine:'', fidelity:'', error:safeText(e?.message || e || '') };
    }
    results.push({
      documentType: type,
      checks,
      failedChecks: failed,
      htmlLength: safeText(html).length,
      printableSections: Array.isArray(printable?.sections) ? printable.sections.length : 0,
      pdfSmoke
    });
  }
  const failedDocs = results.filter((r) => r.failedChecks.length || !r.pdfSmoke.ok).map((r) => r.documentType);
  return {
    success: failedDocs.length === 0,
    checkedAt: new Date().toISOString(),
    capabilitySnapshot: getRendererCapabilitySnapshot(),
    results,
    failedDocuments: failedDocs
  };
}

async function renderPdfBufferFromHtmlAdapter(html, options = {}){
  const started = Date.now();
  const capabilitySnapshot = getRendererCapabilitySnapshot();
  const attemptedEngines = [];
  let fallbackUsed = false;
  let fallbackReason = '';
  try {
    attemptedEngines.push('puppeteer_html_pdf');
    const buffer = await renderPdfBufferFromHtmlHighFidelity(html, options);
    if (buffer && buffer.length) {
      return {
        success: true,
        buffer,
        engine: 'puppeteer_html_pdf',
        fidelity: 'high',
        fallbackUsed,
        fallbackReason,
        attemptedEngines,
        durationMs: Date.now() - started,
        capabilitySnapshot,
        warnings: capabilitySnapshot.runtimeLimitations || []
      };
    }
    fallbackUsed = true;
    fallbackReason = 'HIGH_FIDELITY_EMPTY_BUFFER';
  } catch (e) {
    fallbackUsed = true;
    fallbackReason = `HIGH_FIDELITY_ERROR:${safeText(e?.message || e || 'unknown')}`;
  }
  attemptedEngines.push('pdfkit_text_fallback');
  const buffer = await renderPdfBufferFromHtml(html, options);
  return {
    success: true,
    buffer,
    engine: 'pdfkit_text_fallback',
    fidelity: 'baseline',
    fallbackUsed,
    fallbackReason,
    attemptedEngines,
    durationMs: Date.now() - started,
    capabilitySnapshot,
    warnings: capabilitySnapshot.runtimeLimitations || []
  };
}

function computePricingDrift(snapshot = {}, working = {}){
  const keys = ['rental','insurance','options','ageFee','nightFee','transport','damages','surcharges','discount','gross'];
  const lineItems = keys.map((key) => {
    const snapshotValue = round2(snapshot?.[key]);
    const workingValue = round2(working?.[key]);
    const delta = round2(workingValue - snapshotValue);
    return { key, snapshot: snapshotValue, working: workingValue, delta, changed: Math.abs(delta) >= 0.01 };
  });
  const deltaGross = round2((working?.gross || 0) - (snapshot?.gross || 0));
  return {
    hasDelta: lineItems.some((item) => item.changed),
    deltaGross,
    lineItems
  };
}

function buildPricingReview(booking = {}, rental = {}){
  const snapshot = cloneJson(booking?.pricingSnapshot || rental?.pricingSnapshot || buildPricingSnapshot(booking, rental));
  const working = buildPricingSnapshot(booking, rental);
  const drift = computePricingDrift(snapshot, working);
  const override = cloneJson(rental?.pricingOverride || booking?.pricingOverride || {});
  return { snapshot, working, drift, override };
}

function normalizeSelectedExtras(raw){
  if (Array.isArray(raw)) {
    return raw.map((item) => {
      if (typeof item === "string") {
        const label = safeText(item).trim();
        return label ? { label, price: 0 } : null;
      }
      if (item && typeof item === "object") {
        const label = safeText(item.label || item.title || item.name || item.code || item._id).trim();
        const price = safeNum(item.price || item.amount || item.value || 0);
        return label ? { ...item, label, price } : null;
      }
      return null;
    }).filter(Boolean);
  }
  const text = safeText(raw).trim();
  if (!text) return [];
  return text.split(',').map((part) => part.trim()).filter(Boolean).map((label) => ({ label, price: 0 }));
}

// --------------------
// Fleet map
// --------------------
async function getFleetMapByIds(ids){
  const fleetMap = new Map();
  const uniq = Array.from(new Set((ids || []).filter(Boolean).map(String)));
  if (!uniq.length) return fleetMap;

  const mapFromItems = (items = []) => {
    (items || []).forEach((f) => {
      const recordId = String(f._id || "");
      if (!recordId) return;
      const plate = safeText(f.plate || f.Plate).trim();
      const model = safeText(f.model || f.Model || f.title || f.Title).trim();
      const assignedCategoryCode = extractCode(f.categoryCode || f.categoryLabel || f.category || f.Category || f.assignedCategoryCode || "");
      const label = safeText(f.vehicleLabel || (plate ? (model ? `${plate} - ${model}` : plate) : (model || recordId))).trim();
      fleetMap.set(recordId, {
        plate,
        model,
        label,
        assignedCategoryCode,
        currentStationCode: safeText(f.currentStationCode || ''),
        currentStationLabel: safeText(f.currentStationLabel || ''),
        mileage: safeNum(f.mileage),
        fuelLevel: safeNum(f.fuelLevel),
        excess: safeNum(f.excess),
        operationalStatus: safeText(f.operationalStatus || f.status || ''),
        readyToGo: f.readyToGo === true || safeText(f.readyToGo).toLowerCase() === 'true',
        hardHold: f.hardHold === true || safeText(f.hardHold).toLowerCase() === 'true'
      });
    });
  };

  try {
    const resNew = await wixData.query(VEHICLE_FLEET_COLLECTION).hasSome("_id", uniq).limit(FLEET_LIMIT).find({ suppressAuth:true });
    mapFromItems(resNew.items || []);
  } catch (_) {}

  const remaining = uniq.filter((id) => !fleetMap.has(String(id)));
  if (remaining.length) {
    try {
      const resOld = await wixData.query("FleetNew").hasSome("_id", remaining).include("category").limit(FLEET_LIMIT).find({ suppressAuth:true });
      mapFromItems((resOld.items || []).map((f) => ({
        ...f,
        categoryCode: (f.category && typeof f.category === "object") ? (f.category.category || f.category.code || f.category.title || f.category.name || "") : (f.category || "")
      })));
    } catch (_) {}
  }

  return fleetMap;
}


function looksLikeOpaqueId(value){
  const s = safeText(value).trim();
  return !!s && /[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/i.test(s);
}

function bookingCategoryCode(booking = {}){
  const assigned = extractCode(booking.assignedCategoryCode || "");
  if (assigned) return assigned;
  const categoryText = safeText(booking.category || "").trim();
  const categoryIdText = safeText(booking.categoryId || "").trim();
  if (categoryText) return extractCode(categoryText);
  if (categoryIdText && !looksLikeOpaqueId(categoryIdText)) return extractCode(categoryIdText);
  return "";
}

function buildCategoryLabel(code, rawLabel, title){
  const c = extractCode(code || rawLabel || title || "");
  const raw = safeText(rawLabel || title || "").trim();
  if (!c) return raw;
  if (!raw) return c;
  if (raw === c) return c;
  if (raw.startsWith(`${c} -`) || raw.startsWith(`${c}-`)) return raw;
  if (extractCode(raw) === c && raw.includes('-')) return raw;
  return `${c} - ${raw}`;
}

function rangesOverlap(startA, endA, startB, endB){
  const a1 = asDate(startA); const a2 = asDate(endA); const b1 = asDate(startB); const b2 = asDate(endB);
  if (!a1 || !a2 || !b1 || !b2) return false;
  return a1 < b2 && b1 < a2;
}

async function findBusyAssignedVehicleIds(start, end, excludeBookingId){
  const busy = new Set();
  if (!asDate(start) || !asDate(end)) return busy;
  try {
    const res = await wixData.query("BookingsNew").limit(BOOKING_LIMIT).find({ suppressAuth:true });
    for (const item of (res.items || [])) {
      if (!item?._id || String(item._id) === String(excludeBookingId || "")) continue;
      const vehicleId = safeText(item.assignedVehicle || "").trim();
      if (!vehicleId) continue;
      const status = safeText(item.status || "").toLowerCase();
      const rentalState = safeText(item.rentalState || "").toLowerCase();
      if (status === 'canceled' || rentalState === 'closed rental') continue;
      if (!rangesOverlap(start, end, item.pickupDateTime, item.dropoffDateTime)) continue;
      busy.add(vehicleId);
    }
  } catch (_) {}
  return busy;
}

// --------------------
// Rentals helpers
// --------------------
async function getRentalByBookingId(bookingId){
  const res = await wixData.query("RentalsNew")
    .eq("bookingId", String(bookingId))
    .limit(1)
    .find({ suppressAuth:true });

  return (res.items && res.items[0]) ? res.items[0] : null;
}

function buildRentalDraftFromBooking(booking = {}){
  const fallbackCharges = deriveChargeLines(booking, {
    rental: booking.baseCost,
    insurance: booking.insuranceCost,
    options: booking.extrasTotal,
    ageFee: booking.ageFee,
    nightFee: booking.nightFee,
    transport: 0,
    damages: 0,
    surcharges: 0,
    discount: 0
  });
  return {
    bookingId: safeText(booking?._id),
    rentalState: safeText(booking?.rentalState || 'Booking'),
    assignedVehicleLabel: safeText(booking?.assignedVehicleLabel || booking?.assignedVehiclePlate || ''),
    assignedVehiclePlate: safeText(booking?.assignedVehiclePlate || ''),
    assignedVehicleModel: safeText(booking?.assignedVehicleModel || ''),
    assignedCategoryCode: safeText(booking?.assignedCategoryCode || booking?.categoryId || ''),
    assignedVehicleStationCode: safeText(booking?.assignedVehicleStationCode || ''),
    assignedVehicleStationLabel: safeText(booking?.assignedVehicleStationLabel || ''),
    mainDriver: booking?.mainDriver || null,
    additionalDrivers: Array.isArray(booking?.additionalDrivers) ? booking.additionalDrivers : [],
    charges: fallbackCharges,
    chargeLines: Array.isArray(booking?.chargeLines) ? booking.chargeLines : buildChargeLinesFromCharges(fallbackCharges, []),
    billing: mergeBillingFallback(booking, {}),
    financials: mergeFinancialsFallback(booking, {}),
    financialTransactions: Array.isArray(booking?.financialTransactions) ? booking.financialTransactions : [],
    commercialState: booking?.commercialState || {},
    financialSnapshot: booking?.financialSnapshot || null,
    documentPipeline: booking?.documentPipeline || null,
    signatureState: booking?.signatureState || null
  };
}

async function ensureRentalForBooking(booking){
  const bookingId = String(booking._id);
  let rental = await getRentalByBookingId(bookingId);
  if (rental) return rental;

  const bookedCode = extractCode(booking.categoryId || booking.category || "");
  const rentalState = safeText(booking.rentalState || "Booking") || "Booking";

  rental = await wixData.insert("RentalsNew", {
    bookingId,
    rentalState,
    bookedCategoryCode: bookedCode,
    assignedVehicleLabel: safeText(booking.assignedVehicleLabel || booking.assignedVehiclePlate || ""),
    assignedCategoryCode: safeText(booking.assignedCategoryCode || ""),
    checkoutFuelLevel: 1,
    checkinFuelLevel: 1,
    mainDriver: null,
    additionalDrivers: [],
    charges: deriveChargeLines(booking, {
      rental: booking.baseCost,
      insurance: booking.insuranceCost,
      options: booking.extrasTotal,
      ageFee: booking.ageFee,
      nightFee: booking.nightFee,
      transport: 0,
      damages: 0,
      surcharges: 0,
      discount: 0
    }),
    billing: {
      vatRate: 0.24,
      vatInclusive: true
    },
    financials: {
      paymentMethod: safeText(booking.paymentMethod || "cash") || "cash",
      paymentStatus: safeText(booking.paymentStatus || "pending") || "pending",
      collectionMode: safeText(booking.collectionMode || "pay_arrival") || "pay_arrival",
      prepaid: safeNum(booking.prepaidAmount || 0),
      paidNow: safeNum(booking.paidNowAmount || 0),
      deposit: safeNum(booking.depositAmount || 0)
    },
    financialTransactions: Array.isArray(booking.financialTransactions) ? booking.financialTransactions : [],
    paymentMethod: safeText(booking.paymentMethod || "cash") || "cash",
    paymentStatus: safeText(booking.paymentStatus || "pending") || "pending",
    collectionMode: safeText(booking.collectionMode || "pay_arrival") || "pay_arrival",
    prepaidAmount: safeNum(booking.prepaidAmount || 0),
    paidNowAmount: safeNum(booking.paidNowAmount || 0),
    depositAmount: safeNum(booking.depositAmount || 0),
    internalMemo: ""
  }, { suppressAuth:true });

  return rental;
}

async function mirrorToBooking(booking, rental){
  const b = booking;

  b.assignedVehicleLabel = safeText(rental.assignedVehicleLabel || b.assignedVehicleLabel || "");
  if (rental.mainDriver) b.mainDriver = rental.mainDriver;
  if (Array.isArray(rental.additionalDrivers)) b.additionalDrivers = rental.additionalDrivers;

  b.checkoutAt = rental.checkoutAt || b.checkoutAt || null;
  b.checkinAt = rental.checkinAt || b.checkinAt || null;

  b.checkoutOdometer = rental.checkoutOdometer ?? b.checkoutOdometer;
  b.checkinOdometer = rental.checkinOdometer ?? b.checkinOdometer;
  b.checkoutFuelLevel = rental.checkoutFuelLevel ?? b.checkoutFuelLevel;
  b.checkinFuelLevel = rental.checkinFuelLevel ?? b.checkinFuelLevel;

  b.checkoutNotes = safeText(rental.checkoutNotes || b.checkoutNotes || "");
  b.checkinNotes  = safeText(rental.checkinNotes  || b.checkinNotes  || "");
  b.damagesNotes = safeText(rental.damagesNotes || b.damagesNotes || "");

  b.photos = Array.isArray(rental.photos) ? rental.photos : (b.photos || []);
  b.charges = rental.charges || b.charges || null;
  syncBookingChargeFields(b, rental);
  b.billing = rental.billing || b.billing || null;
  b.financials = rental.financials || b.financials || null;
  if (rental.financials && typeof rental.financials === "object") {
    b.paymentMethod = safeText(rental.financials.paymentMethod || b.paymentMethod || "cash") || "cash";
    b.paymentStatus = safeText(rental.financials.paymentStatus || b.paymentStatus || "pending") || "pending";
    b.collectionMode = safeText(rental.financials.collectionMode || b.collectionMode || "pay_arrival") || "pay_arrival";
    b.prepaidAmount = safeNum(rental.financials.prepaid ?? b.prepaidAmount ?? 0);
    b.paidNowAmount = safeNum(rental.financials.paidNow ?? b.paidNowAmount ?? 0);
    b.depositAmount = safeNum(rental.financials.deposit ?? b.depositAmount ?? 0);
  }
  b.financialTransactions = Array.isArray(rental.financialTransactions) ? rental.financialTransactions : (Array.isArray(b.financialTransactions) ? b.financialTransactions : []);
  b.internalMemo = safeText(rental.internalMemo || b.internalMemo || "");

  if (rental.checkinStage) b.checkinStage = rental.checkinStage;
  if (rental.rentalState) b.rentalState = safeText(rental.rentalState);

  await wixData.update("BookingsNew", b, { suppressAuth:true });
  return b;
}

function applyChargesPayload(rental, payload){
  const ch = (payload && typeof payload.charges === "object") ? payload.charges : null;
  const chargeLinesPayload = Array.isArray(payload?.chargeLines) ? payload.chargeLines : null;
  if (!ch && !chargeLinesPayload) return;

  const cur = (rental.charges && typeof rental.charges === "object") ? rental.charges : {};
  const nextCharges = {
    rental: safeNum(ch.rental ?? cur.rental ?? 0),
    insurance: safeNum(ch.insurance ?? cur.insurance ?? 0),
    options: safeNum(ch.options ?? cur.options ?? 0),
    ageFee: safeNum(ch.ageFee ?? cur.ageFee ?? 0),
    nightFee: safeNum(ch.nightFee ?? cur.nightFee ?? 0),
    transport: safeNum(ch.transport ?? cur.transport ?? 0),
    damages: safeNum(ch.damages ?? cur.damages ?? 0),
    surcharges: safeNum(ch.surcharges ?? cur.surcharges ?? 0),
    discount: safeNum(ch.discount ?? cur.discount ?? 0),
  };
  rental.charges = nextCharges;
  const suppliedLines = normalizeChargeLinesPayload(chargeLinesPayload || rental.chargeLines || []);
  rental.chargeLines = buildChargeLinesFromCharges(nextCharges, suppliedLines);
}

function applyBillingPayload(rental, payload){
  const b = (payload && typeof payload.billing === "object") ? payload.billing : null;
  if (!b) return;

  const cur = (rental.billing && typeof rental.billing === "object") ? rental.billing : {};
  rental.billing = {
    vatRate: clamp(safeNum(b.vatRate ?? cur.vatRate ?? 0.24), 0, 1),
    vatInclusive: (b.vatInclusive ?? cur.vatInclusive ?? true) ? true : false,
    invoiceType: safeText(b.invoiceType ?? cur.invoiceType ?? ""),
    vatNumber: safeText(b.vatNumber ?? cur.vatNumber ?? ""),
    companyName: safeText(b.companyName ?? cur.companyName ?? ""),
    tradeName: safeText(b.tradeName ?? cur.tradeName ?? ""),
    profession: safeText(b.profession ?? cur.profession ?? ""),
    taxOffice: safeText(b.taxOffice ?? cur.taxOffice ?? ""),
    address: safeText(b.address ?? cur.address ?? ""),
    city: safeText(b.city ?? cur.city ?? ""),
    zip: safeText(b.zip ?? cur.zip ?? ""),
    country: safeText(b.country ?? cur.country ?? ""),
    phone: safeText(b.phone ?? cur.phone ?? ""),
    companyEmail: safeText(b.companyEmail ?? cur.companyEmail ?? ""),
    contactPerson: safeText(b.contactPerson ?? cur.contactPerson ?? ""),
    notes: safeText(b.notes ?? cur.notes ?? ""),
  };
}

function applyFinancialsPayload(booking, rental, payload){
  const f = (payload && typeof payload.financials === "object") ? payload.financials : null;
  if (!f) return;

  const cur = (rental.financials && typeof rental.financials === "object") ? rental.financials : {};
  rental.financials = {
    paymentMethod: safeText(f.paymentMethod ?? cur.paymentMethod ?? rental.paymentMethod ?? booking.paymentMethod ?? "cash") || "cash",
    paymentStatus: safeText(f.paymentStatus ?? cur.paymentStatus ?? rental.paymentStatus ?? booking.paymentStatus ?? "pending") || "pending",
    collectionMode: safeText(f.collectionMode ?? cur.collectionMode ?? rental.collectionMode ?? booking.collectionMode ?? "pay_arrival") || "pay_arrival",
    prepaid: safeNum(f.prepaid ?? cur.prepaid ?? rental.prepaidAmount ?? booking.prepaidAmount ?? 0),
    paidNow: safeNum(f.paidNow ?? cur.paidNow ?? rental.paidNowAmount ?? booking.paidNowAmount ?? 0),
    deposit: safeNum(f.deposit ?? cur.deposit ?? rental.depositAmount ?? booking.depositAmount ?? 0)
  };

  rental.paymentMethod = rental.financials.paymentMethod;
  rental.paymentStatus = rental.financials.paymentStatus;
  rental.collectionMode = rental.financials.collectionMode;
  rental.prepaidAmount = rental.financials.prepaid;
  rental.paidNowAmount = rental.financials.paidNow;
  rental.depositAmount = rental.financials.deposit;

  booking.financials = { ...(booking.financials || {}), ...rental.financials };
  booking.paymentMethod = rental.financials.paymentMethod;
  booking.paymentStatus = rental.financials.paymentStatus;
  booking.collectionMode = rental.financials.collectionMode;
  booking.prepaidAmount = rental.financials.prepaid;
  booking.paidNowAmount = rental.financials.paidNow;
  booking.depositAmount = rental.financials.deposit;
}

function applyFinancialTransactionsPayload(booking, rental, payload){
  const rows = Array.isArray(payload?.financialTransactions) ? payload.financialTransactions : null;
  if (!rows) return;
  rental.financialTransactions = rows
    .map((row) => {
      if (!row || typeof row !== "object") return null;
      const amount = safeNum(row.amount);
      if (!(amount > 0)) return null;
      const type = safeText(row.type);
      const category = safeText(row.category || (
        type.includes('guarantee') ? 'guarantee'
        : type.includes('preauth') ? 'preauth'
        : type === 'refund' ? 'refund'
        : 'payment'
      ));
      return {
        id: safeText(row.id) || `${Date.now()}_${Math.random().toString(16).slice(2,8)}`,
        type,
        category,
        amount,
        signedAmount: ['refund','guarantee_refund','preauth_void'].includes(type) ? -Math.abs(amount) : Math.abs(amount),
        at: asDate(row.at) || new Date(),
        method: safeText(row.method),
        party: safeText(row.party),
        reference: safeText(row.reference),
        receiptNo: safeText(row.receiptNo),
        terminal: safeText(row.terminal),
        station: safeText(row.station),
        user: safeText(row.user),
        notes: safeText(row.notes),
        status: safeText(row.status || 'posted')
      };
    })
    .filter(Boolean)
    .slice(0, 400);
  booking.financialTransactions = rental.financialTransactions;
}

async function buildContractLookups(booking = {}){
  const categoryMap = new Map();
  const addCategory = (rawCode, rawLabel = '', title = '', recordId = '') => {
    const code = extractCode(rawCode || rawLabel || title || '');
    if (!code) return;
    const label = buildCategoryLabel(code, rawLabel, title);
    const existing = categoryMap.get(code);
    if (!existing || (safeText(label).length > safeText(existing.label).length)) {
      categoryMap.set(code, { code, label, title: safeText(title || rawLabel || '').trim(), recordId: safeText(recordId) });
    }
  };

  try {
    const categoryRes = await wixData.query(VEHICLE_CATEGORY_COLLECTION).limit(BOOKING_LIMIT).find({ suppressAuth:true });
    for (const item of (categoryRes.items || [])) {
      addCategory(item.categoryCode || item.categoryLabel || item.categoryRecordId || item._id || '', item.categoryLabel || item.categoryCode || '', item.categoryLabel || '', item._id || item.categoryRecordId || '');
    }
  } catch (_) {
    try {
      const categoryRes = await wixData.query("VehiclesNew").limit(BOOKING_LIMIT).find({ suppressAuth:true });
      for (const item of (categoryRes.items || [])) {
        const rawCode = item.categoryId || item.category || item.label || item.name || item.title || item._id || '';
        const rawLabel = item.category || item.label || item.name || item.title || '';
        addCategory(rawCode, rawLabel, item.name || item.title || '', item._id || '');
      }
    } catch (_) {}
  }

  const vehicles = [];
  const bookingStart = asDate(booking.pickupDateTime);
  const bookingEnd = asDate(booking.dropoffDateTime);
  const busyVehicleIds = await findBusyAssignedVehicleIds(bookingStart, bookingEnd, booking._id);
  const currentAssignedId = safeText(booking.assignedVehicle || '').trim();
  const requestedStationRaw = pickLabel(booking.pickuppoint || '');

  const pushVehicleRow = (item = {}) => {
      const recordId = String(item._id || '');
      if (!recordId) return;
      const plate = safeText(item.plate || "");
      const model = safeText(item.model || "");
      const categoryObj = item.category && typeof item.category === 'object' ? item.category : null;
      const categoryCode = extractCode(item.categoryCode || item.categoryLabel || item.category || item.Category || item.assignedCategoryCode || categoryObj?.category || categoryObj?.code || categoryObj?.title || categoryObj?.name || '');
      const categoryLabel = safeText(item.categoryLabel || item.category || item.Category || categoryObj?.category || categoryObj?.title || categoryObj?.name || categoryCode);
      addCategory(categoryCode, categoryLabel, categoryLabel, item.categoryId || categoryObj?._id || '');
      const operationalStatus = safeText(item.operationalStatus || item.status || 'available');
      const status = safeText(item.status || 'available');
      const activeValue = item.active;
      const activeLower = safeText(activeValue).trim().toLowerCase();
      const activeFlag = activeValue !== false && activeLower !== 'false' && activeLower !== '0' && activeLower !== 'no';
      const currentStationCode = safeText(item.currentStationCode || '');
      const currentStationLabel = safeText(item.currentStationLabel || '');
      const readyToGo = item.readyToGo === true || safeText(item.readyToGo).toLowerCase() === 'true';
      const hardHold = item.hardHold === true || safeText(item.hardHold).toLowerCase() === 'true';
      const assignedThis = !!currentAssignedId && currentAssignedId === recordId;
      const serviceBlocked = !activeFlag || ['service','blocked','inactive'].includes(operationalStatus.toLowerCase()) || ['service','blocked','inactive'].includes(status.toLowerCase());
      const hardUnavailable = ['assigned','unavailable','out'].includes(operationalStatus.toLowerCase()) || ['assigned','unavailable','out'].includes(status.toLowerCase());
      const busyConflict = !assignedThis && (busyVehicleIds.has(recordId) || hardUnavailable);
      const wrongStation = !assignedThis && !busyConflict && !serviceBlocked && !stationMatchesBooking(requestedStationRaw, currentStationCode, currentStationLabel);
      const readinessBlocked = !assignedThis && !serviceBlocked && !busyConflict && !wrongStation && !readyToGo;
      const holdBlocked = !assignedThis && !serviceBlocked && hardHold;

      let selectorStatusKey = 'available';
      let selectorStatusLabel = 'Available';
      let selectorTone = 'ok';
      let selectorStatusReason = 'Ready for assign in this booking window.';
      let assignable = true;

      if (assignedThis) {
        selectorStatusKey = 'assignedThis';
        selectorStatusLabel = 'Assigned here';
        selectorTone = 'info';
        selectorStatusReason = 'This vehicle is already assigned to the current booking.';
        assignable = true;
      } else if (serviceBlocked) {
        selectorStatusKey = 'service';
        selectorStatusLabel = 'Service / blocked';
        selectorTone = 'danger';
        selectorStatusReason = 'Vehicle is not operationally available.';
        assignable = false;
      } else if (holdBlocked) {
        selectorStatusKey = 'hardHold';
        selectorStatusLabel = 'Hard hold';
        selectorTone = 'danger';
        selectorStatusReason = 'Vehicle is under hard hold and cannot be assigned.';
        assignable = false;
      } else if (busyConflict) {
        selectorStatusKey = 'busy';
        selectorStatusLabel = 'Busy / conflict';
        selectorTone = 'danger';
        selectorStatusReason = 'Overlaps with another booking or rental window.';
        assignable = false;
      } else if (wrongStation) {
        selectorStatusKey = 'wrongStation';
        selectorStatusLabel = 'Wrong station';
        selectorTone = 'warn';
        selectorStatusReason = `Vehicle currently belongs to ${currentStationLabel || currentStationCode || 'another station'}.`;
        assignable = false;
      } else if (readinessBlocked) {
        selectorStatusKey = 'notReady';
        selectorStatusLabel = 'Not ready';
        selectorTone = 'warn';
        selectorStatusReason = 'Vehicle is not marked ready-to-go for checkout.';
        assignable = false;
      }

      vehicles.push({
        _id: recordId,
        fleetVehicleId: safeText(item.fleetVehicleId || ''),
        plate,
        model,
        label: safeText(item.vehicleLabel || (plate ? (model ? `${plate} - ${model}` : plate) : (model || recordId))),
        categoryCode,
        categoryLabel,
        currentStationCode,
        currentStationLabel,
        status,
        operationalStatus,
        mileage: safeNum(item.mileage),
        fuelLevel: safeNum(item.fuelLevel),
        fuelType: safeText(item.fuelType || ''),
        excess: safeNum(item.excess),
        ownershipState: safeText(item.ownershipState || ''),
        poolType: safeText(item.poolType || ''),
        readyToGo,
        hardHold,
        available: selectorStatusKey === 'available',
        assignable,
        thisBookingAssigned: assignedThis,
        selectorStatusKey,
        selectorStatusLabel,
        selectorTone,
        selectorStatusReason
      });
  };

  try {
    const fleetRes = await wixData.query(VEHICLE_FLEET_COLLECTION).limit(FLEET_LIMIT).find({ suppressAuth:true });
    for (const item of (fleetRes.items || [])) pushVehicleRow(item);
  } catch (_) {}

  if (!vehicles.length) {
    try {
      const fleetLegacyRes = await wixData.query("FleetNew").include("category").limit(FLEET_LIMIT).find({ suppressAuth:true });
      for (const rawItem of (fleetLegacyRes.items || [])) {
        const categoryObj = rawItem.category && typeof rawItem.category === 'object' ? rawItem.category : null;
        pushVehicleRow({
          ...rawItem,
          categoryCode: rawItem.categoryCode || rawItem.Category || categoryObj?.category || categoryObj?.code || categoryObj?.title || categoryObj?.name || '',
          categoryLabel: rawItem.categoryLabel || categoryObj?.category || categoryObj?.title || categoryObj?.name || '',
          categoryId: rawItem.categoryId || categoryObj?._id || '',
          plate: rawItem.plate || rawItem.Plate || '',
          model: rawItem.model || rawItem.Model || rawItem.title || rawItem.Title || '',
          vehicleLabel: rawItem.vehicleLabel || rawItem.label || rawItem.title || rawItem.Title || '',
          currentStationCode: rawItem.currentStationCode || rawItem.stationCode || '',
          currentStationLabel: rawItem.currentStationLabel || rawItem.stationLabel || rawItem.station || '',
          operationalStatus: rawItem.operationalStatus || rawItem.status || rawItem.vehicleStatus || '',
          status: rawItem.status || rawItem.operationalStatus || '',
          mileage: rawItem.mileage || rawItem.kilometers || rawItem.km || 0,
          fuelLevel: rawItem.fuelLevel || rawItem.fuel || 0,
          excess: rawItem.excess || rawItem.excessAmount || 0
        });
      }
    } catch (_) {}
  }

  if (!categoryMap.size && booking) {
    const fallbackCode = bookingCategoryCode(booking);
    if (fallbackCode) addCategory(fallbackCode, safeText(booking.category || fallbackCode), safeText(booking.category || fallbackCode));
  }

  const categories = Array.from(categoryMap.values()).sort((a, b) => String(a.code).localeCompare(String(b.code), 'el', { numeric:true, sensitivity:'base' }));
  vehicles.sort((a, b) => {
    const score = (v) => v.thisBookingAssigned ? 4 : v.assignable ? 3 : v.selectorStatusKey === 'wrongStation' ? 2 : v.selectorStatusKey === 'busy' ? 1 : 0;
    if (score(a) !== score(b)) return score(b) - score(a);
    return String(a.label).localeCompare(String(b.label), 'el', { numeric:true, sensitivity:'base' });
  });

  const customers = [];

  try {
    const customerRes = await wixData.query("Customers").eq("isActive", true).ascending("fullName").limit(500).find({ suppressAuth:true });
    for (const item of (customerRes.items || [])) {
      const name = safeText(item.fullName || item.title || [item.firstName, item.lastName].filter(Boolean).join(" "));
      const email = safeText(item.email || "");
      const phone = safeText(item.mobilePhone || item.phone || "");
      const mobile = safeText(item.secondaryPhone || "");
      const address = safeText(item.address || "");
      const residenceCity = safeText(item.city || "");
      const originCity = safeText(item.city || "");
      const idNo = safeText(item.idNumber || item.passportNumber || "");
      const idCountry = safeText(item.country || item.nationality || "");
      const licenseNo = safeText(item.licenseNumber || "");
      const licenseCountry = safeText(item.licenseCountry || "");
      const licenseExpiry = toDateInputValue(item.licenseExpiry || "");
      const licenseIssueDate = toDateInputValue(item.licenseIssueDate || "");
      const idIssueDate = toDateInputValue(item.idIssueDate || "");
      const idExpiry = toDateInputValue(item.idExpiry || "");
      const dob = toDateInputValue(item.dateOfBirth || "");
      const notes = safeText(item.notes || "");
      const customerId = safeText(item._id || "");
      const customerCode = safeText(item.customerCode || "");
      const searchBlob = safeText(item.searchBlob || "").toLowerCase();
      if (!name && !email && !phone && !idNo && !licenseNo) continue;
      customers.push({ customerId, customerCode, name, email, phone, mobile, address, residenceCity, originCity, idNo, idCountry, licenseNo, licenseCountry, licenseIssueDate, licenseExpiry, idIssueDate, idExpiry, dob, notes, searchBlob });
    }
  } catch (_) {}

  const companies = [];
  try {
    const companyRes = await wixData.query("Companies").eq("isActive", true).ascending("companyName").limit(300).find({ suppressAuth:true });
    for (const item of (companyRes.items || [])) {
      const companyId = safeText(item._id || "");
      const companyName = safeText(item.companyName || item.title || "");
      const tradeName = safeText(item.tradeName || "");
      const vatNumber = safeText(item.vatNumber || "");
      const taxOffice = safeText(item.taxOffice || "");
      const phone = safeText(item.phone || "");
      const email = safeText(item.email || "");
      const address = safeText(item.address || "");
      const city = safeText(item.city || "");
      const zip = safeText(item.zipCode || "");
      const country = safeText(item.country || "");
      const contactPerson = safeText(item.contactPerson || "");
      const poNumberDefault = safeText(item.poNumberDefault || "");
      const notes = safeText(item.notes || "");
      const searchBlob = safeText(item.searchBlob || "").toLowerCase();
      if (!companyName && !vatNumber && !email && !phone) continue;
      companies.push({ companyId, companyName, tradeName, vatNumber, taxOffice, phone, email, address, city, zip, country, contactPerson, poNumberDefault, notes, searchBlob });
    }
  } catch (_) {}

  return { categories, vehicles, customers, companies };
}

export async function searchContractCustomers({ authToken, query = "", limit = 50 }) {
  await requireStaffAccess({ sessionToken: authToken, area: "rentals", action: "View" });
  try {
    const q = safeText(query).trim().toLowerCase();
    let items = [];
    if (!q) {
      const res = await wixData.query("Customers").eq("isActive", true).ascending("fullName").limit(Math.min(Math.max(Number(limit) || 50, 1), 200)).find({ suppressAuth:true });
      items = res.items || [];
    } else {
      const res = await wixData.query("Customers").eq("isActive", true).contains("searchBlob", q).limit(Math.min(Math.max(Number(limit) || 50, 1), 200)).find({ suppressAuth:true });
      items = res.items || [];
    }
    return {
      success: true,
      items: items.map((item) => ({
        customerId: safeText(item._id || ""),
        customerCode: safeText(item.customerCode || ""),
        name: safeText(item.fullName || item.title || [item.firstName, item.lastName].filter(Boolean).join(" ")),
        email: safeText(item.email || ""),
        phone: safeText(item.mobilePhone || item.phone || ""),
        mobile: safeText(item.secondaryPhone || ""),
        address: safeText(item.address || ""),
        residenceCity: safeText(item.city || ""),
        originCity: safeText(item.city || ""),
        idNo: safeText(item.idNumber || item.passportNumber || ""),
        idCountry: safeText(item.country || item.nationality || ""),
        licenseNo: safeText(item.licenseNumber || ""),
        licenseCountry: safeText(item.licenseCountry || ""),
        licenseIssueDate: toDateInputValue(item.licenseIssueDate || ""),
        licenseExpiry: toDateInputValue(item.licenseExpiry || ""),
        idIssueDate: toDateInputValue(item.idIssueDate || ""),
        idExpiry: toDateInputValue(item.idExpiry || ""),
        dob: toDateInputValue(item.dateOfBirth || ""),
        notes: safeText(item.notes || ""),
        searchBlob: safeText(item.searchBlob || "").toLowerCase(),
      }))
    };
  } catch (e) {
    return { success:false, message:e?.message || String(e), items: [] };
  }
}

