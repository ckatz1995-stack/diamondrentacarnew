// backend/rentalContract.jsw
import wixData from "wix-data";
import { getSecret } from "wix-secrets-backend";
import { confirmAndAutoAssign } from "backend/fleetCalendar";
import { requireStaffAccess } from "backend/staffAccess.jsw";
import { asDate, extractCode, pickLabel, safeNum } from "backend/utils";

const FLEET_LIMIT = 1000;
const BOOKING_LIMIT = 1000;
const VEHICLE_CATEGORY_COLLECTION = "Vehicles";
const VEHICLE_FLEET_COLLECTION = "Fleet";

// --------------------
// Utils
// --------------------
function safeText(x){ return (x ?? "").toString(); }
function clamp(n,a,b){ return Math.min(b, Math.max(a,n)); }

function deriveStationCode(raw){
  const source = pickLabel(raw);
  const code = extractCode(source).toUpperCase();
  if (!code) return "";
  if (!/^[A-Z0-9]{2,6}$/.test(code)) return "";
  return code;
}

function stationMatchesBooking(requestedRaw, currentCode, currentLabel){
  const requestedCode = deriveStationCode(requestedRaw);
  if (!requestedCode) return true;
  const current = deriveStationCode(currentCode || currentLabel || "");
  if (!current) return true;
  return requestedCode === current;
}

function parsePhotosField(v){
  if (Array.isArray(v)) return v.map(x => safeText(x).trim()).filter(Boolean);
  const s = safeText(v).trim();
  if (!s) return [];
  return s.split(",").map(x => x.trim()).filter(Boolean);
}

function normalizeDriversPayload(payload){
  const normDriver = (d) => {
    if (!d || typeof d !== "object") return null;
    return {
      customerId: safeText(d.customerId),
      fullName: safeText(d.fullName),
      phone: safeText(d.phone),
      email: safeText(d.email),
      licenseNo: safeText(d.licenseNo),
      licenseCountry: safeText(d.licenseCountry),
      licenseIssueDate: toDateInputValue(d.licenseIssueDate),
      licenseExpiry: toDateInputValue(d.licenseExpiry),
      idNo: safeText(d.idNo),
      idCountry: safeText(d.idCountry),
      idIssueDate: toDateInputValue(d.idIssueDate),
      idExpiry: toDateInputValue(d.idExpiry),
      dob: toDateInputValue(d.dob),
      city: safeText(d.city),
      address: safeText(d.address),
      notes: safeText(d.notes),
    };
  };

  const main = normDriver(payload?.mainDriver);
  const additional = Array.isArray(payload?.additionalDrivers)
    ? payload.additionalDrivers.map(normDriver).filter(Boolean)
    : [];

  return { mainDriver: main, additionalDrivers: additional };
}


function toDateInputValue(value){
  const raw = safeText(value);
  if (!raw) return "";
  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw;
  const d = asDate(raw);
  if (!d) return "";
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}

function computeVatBreakdown(gross, vatRate = 0.24){
  const g = safeNum(gross);
  const r = safeNum(vatRate);
  if (g <= 0 || r <= 0) return { gross: g, net: g, vat: 0, vatRate: r };
  const net = g / (1 + r);
  const vat = g - net;
  const round2 = (x) => Math.round(x * 100) / 100;
  return { gross: round2(g), net: round2(net), vat: round2(vat), vatRate: r };
}

function billableDaysFromBooking(booking){
  const pickup = asDate(booking?.pickupDateTime);
  const dropoff = asDate(booking?.dropoffDateTime);
  if (!pickup || !dropoff) return 1;
  const diffMs = Math.max(0, dropoff.getTime() - pickup.getTime());
  const hours = diffMs / (1000 * 60 * 60);
  return Math.max(1, Math.ceil(hours / 24));
}

function deriveChargeLines(booking = {}, charges = {}){
  const days = billableDaysFromBooking(booking);
  const hasBookingBase = Number.isFinite(Number(booking.baseCost));
  const hasBookingInsurance = Number.isFinite(Number(booking.insuranceCost));
  const hasBookingExtras = Number.isFinite(Number(booking.extrasTotal));
  const hasBookingAge = Number.isFinite(Number(booking.ageFee));
  const hasBookingNight = Number.isFinite(Number(booking.nightFee));

  const base = hasBookingBase ? safeNum(booking.baseCost) : safeNum(charges.rental || (safeNum(booking.basePricePerDay) * days));
  const insurance = hasBookingInsurance ? safeNum(booking.insuranceCost) : safeNum(charges.insurance || (safeNum(booking.insuranceExtraPerDay) * days));
  const options = hasBookingExtras ? safeNum(booking.extrasTotal) : safeNum(charges.options);
  const ageFee = hasBookingAge ? safeNum(booking.ageFee) : safeNum(charges.ageFee);
  const nightFee = hasBookingNight ? safeNum(booking.nightFee) : safeNum(charges.nightFee);
  const transport = safeNum(charges.transport);
  const damages = safeNum(charges.damages);
  const surcharges = safeNum(charges.surcharges);
  const discount = safeNum(charges.discount);
  const gross = Math.round((base + insurance + options + ageFee + nightFee + transport + damages + surcharges - discount) * 100) / 100;
  return { rental: base, insurance, options, ageFee, nightFee, transport, damages, surcharges, discount, gross, days };
}

const CHARGE_LINE_SPECS = [
  { code:'rental_base', key:'rental', label:'Rental base', category:'rental', derived:true, sign:1, order:10 },
  { code:'insurance', key:'insurance', label:'Insurance / protection', category:'insurance', derived:true, sign:1, order:20 },
  { code:'extras', key:'options', label:'Extras / services', category:'extras', derived:true, sign:1, order:30 },
  { code:'age_fee', key:'ageFee', label:'Age fee', category:'fee', derived:true, sign:1, order:40 },
  { code:'night_fee', key:'nightFee', label:'Night fee', category:'fee', derived:true, sign:1, order:50 },
  { code:'transport_fee', key:'transport', label:'Transport fee', category:'fee', derived:false, sign:1, order:60 },
  { code:'damage_fee', key:'damages', label:'Damages', category:'damage', derived:false, sign:1, order:70 },
  { code:'surcharge', key:'surcharges', label:'Surcharges', category:'fee', derived:false, sign:1, order:80 },
  { code:'discount', key:'discount', label:'Discount', category:'discount', derived:false, sign:-1, order:90 }
];

function buildChargeLinesFromCharges(charges = {}, existing = []){
  const previous = Array.isArray(existing) ? existing : [];
  return CHARGE_LINE_SPECS.map((spec) => {
    const match = previous.find((row) => safeText(row?.code) === spec.code) || {};
    const rawValue = safeNum(charges?.[spec.key]);
    const amount = spec.sign < 0 ? -Math.abs(rawValue) : Math.abs(rawValue);
    return {
      id: safeText(match.id || `${spec.code}_line`),
      code: spec.code,
      key: spec.key,
      label: safeText(match.label || spec.label),
      category: safeText(match.category || spec.category),
      amount: round2(amount),
      absAmount: round2(Math.abs(amount)),
      sign: spec.sign,
      derived: spec.derived,
      editable: match.editable === false ? false : true,
      source: safeText(match.source || (spec.derived ? 'derived' : 'manual')),
      notes: safeText(match.notes || ''),
      order: safeNum(match.order || spec.order || 0),
      taxable: match.taxable !== false
    };
  }).filter((line) => line.absAmount > 0 || line.code === 'discount');
}

function normalizeChargeLinesPayload(rawLines = []){
  const rows = Array.isArray(rawLines) ? rawLines : [];
  return rows.map((line) => {
    if (!line || typeof line !== "object") return null;
    const code = safeText(line.code || line.key || '').trim();
    const amountRaw = safeNum(line.amount ?? line.value ?? line.absAmount ?? 0);
    const sign = safeNum(line.sign) || (code === 'discount' || safeText(line.category).toLowerCase() === 'discount' ? -1 : 1);
    const amount = sign < 0 ? -Math.abs(amountRaw) : Math.abs(amountRaw);
    return {
      id: safeText(line.id || `${Date.now()}_${Math.random().toString(16).slice(2,8)}`),
      code,
      key: safeText(line.key || ''),
      label: safeText(line.label || line.name || code || 'Line'),
      category: safeText(line.category || ''),
      amount: round2(amount),
      absAmount: round2(Math.abs(amount)),
      sign: sign < 0 ? -1 : 1,
      derived: !!line.derived,
      editable: line.editable !== false,
      source: safeText(line.source || (line.derived ? 'derived' : 'manual')),
      notes: safeText(line.notes || ''),
      order: safeNum(line.order || 0),
      taxable: line.taxable !== false
    };
  }).filter(Boolean).slice(0, 200);
}

function buildFinancialSnapshot({ booking = {}, rental = {}, totals = null } = {}){
  const lines = totals || deriveChargeLines(booking, rental?.charges || {});
  const billing = mergeBillingFallback(booking, rental);
  const transactions = Array.isArray(rental?.financialTransactions) ? rental.financialTransactions : [];
  const vatRate = safeNum(billing?.vatRate ?? 0.24);
  const gross = round2(lines.gross);
  const vat = computeVatBreakdown(gross, vatRate);

  let rentalFlow = 0;
  let guaranteeHeld = 0;
  let preauthActive = 0;
  let refunds = 0;
  let paymentsReceived = 0;

  transactions.forEach((tx) => {
    const type = safeText(tx?.type);
    const amount = round2(Math.abs(safeNum(tx?.amount)));
    if (!(amount > 0)) return;
    if (type === 'payment') {
      rentalFlow = round2(rentalFlow + amount);
      paymentsReceived = round2(paymentsReceived + amount);
    } else if (type === 'refund') {
      rentalFlow = round2(rentalFlow - amount);
      refunds = round2(refunds + amount);
    } else if (type === 'guarantee_hold') {
      guaranteeHeld = round2(guaranteeHeld + amount);
    } else if (type === 'guarantee_refund') {
      guaranteeHeld = round2(guaranteeHeld - amount);
    } else if (type === 'preauth_hold') {
      preauthActive = round2(preauthActive + amount);
    } else if (type === 'preauth_void') {
      preauthActive = round2(preauthActive - amount);
    }
  });

  const fallbackFinancials = mergeFinancialsFallback(booking, rental);
  const hasLedger = transactions.length > 0;
  const prepaid = hasLedger
    ? round2(transactions.filter((tx) => safeText(tx?.type) === 'payment' && safeText(tx?.method) === 'voucher').reduce((sum, tx) => sum + safeNum(tx?.amount), 0))
    : round2(safeNum(fallbackFinancials.prepaid));
  const paidNow = hasLedger ? round2(Math.max(0, rentalFlow - prepaid)) : round2(safeNum(fallbackFinancials.paidNow));
  const deposit = hasLedger ? round2(Math.max(0, guaranteeHeld)) : round2(safeNum(fallbackFinancials.deposit));
  const paidTotal = round2(prepaid + paidNow);
  const balance = round2(gross - paidTotal);

  let paymentStatus = 'pending';
  if (gross <= 0 || balance <= 0) paymentStatus = 'paid';
  else if (paidTotal > 0) paymentStatus = 'partial';

  return {
    generatedAt: new Date().toISOString(),
    charges: {
      rental: round2(lines.rental),
      insurance: round2(lines.insurance),
      options: round2(lines.options),
      ageFee: round2(lines.ageFee),
      nightFee: round2(lines.nightFee),
      transport: round2(lines.transport),
      damages: round2(lines.damages),
      surcharges: round2(lines.surcharges),
      discount: round2(lines.discount)
    },
    totals: {
      gross: round2(vat.gross),
      net: round2(vat.net),
      vat: round2(vat.vat),
      vatRate: round2(vatRate)
    },
    ledger: {
      transactions: transactions.length,
      paymentsReceived,
      refunds,
      rentalFlow: round2(rentalFlow),
      guaranteeHeld: round2(Math.max(0, guaranteeHeld)),
      preauthActive: round2(Math.max(0, preauthActive))
    },
    settlement: {
      prepaid,
      paidNow,
      paidTotal,
      balance,
      deposit,
      paymentStatus
    }
  };
}

function syncBookingChargeFields(booking, rental){
  const ch = deriveChargeLines(booking, rental?.charges || {});
  booking.baseCost = ch.rental;
  booking.insuranceCost = ch.insurance;
  booking.extrasTotal = ch.options;
  booking.ageFee = ch.ageFee;
  booking.nightFee = ch.nightFee;
  booking.totalPrice = ch.gross;
  if (!safeNum(booking.basePricePerDay) && ch.days > 0) booking.basePricePerDay = Math.round((ch.rental / ch.days) * 100) / 100;
  if (!safeNum(booking.insuranceExtraPerDay) && ch.days > 0) booking.insuranceExtraPerDay = Math.round((ch.insurance / ch.days) * 100) / 100;
  if (rental) {
    rental.charges = { ...(rental.charges || {}), ...ch };
  }
  return ch;
}


function round2(value){ return Math.round(Number(value || 0) * 100) / 100; }

function cloneJson(value){
  return JSON.parse(JSON.stringify(value == null ? null : value));
}

function buildPricingSnapshot(booking = {}, rental = {}){
  const lines = deriveChargeLines(booking, rental?.charges || {});
  return {
    rental: round2(lines.rental),
    insurance: round2(lines.insurance),
    options: round2(lines.options),
    ageFee: round2(lines.ageFee),
    nightFee: round2(lines.nightFee),
    transport: round2(lines.transport),
    damages: round2(lines.damages),
    surcharges: round2(lines.surcharges),
    discount: round2(lines.discount),
    gross: round2(lines.gross),
    days: safeNum(lines.days || billableDaysFromBooking(booking)),
    capturedAt: new Date().toISOString()
  };
}

function normalizePricingOverridePayload(raw){
  const payload = raw && typeof raw === 'object' ? raw : {};
  return {
    reason: safeText(payload.reason),
    note: safeText(payload.note),
    requestApproval: !!payload.requestApproval,
    approveNow: !!payload.approveNow
  };
}

function normalizeCheckoutGuardrailOverride(raw){
  const payload = raw && typeof raw === 'object' ? raw : {};
  const reason = safeText(payload.reason || payload.note).trim();
  if (!reason) return null;
  return {
    reason,
    actor: safeText(payload.actor || payload.user).trim(),
    updatedAt: asDate(payload.updatedAt || payload.at) || new Date()
  };
}

function normalizeSignatureState(raw){
  const payload = raw && typeof raw === 'object' ? raw : {};
  const statusRaw = safeText(payload.status || payload.state || '').trim().toLowerCase();
  const allowed = new Set(['not_started', 'pending', 'captured', 'waived']);
  const status = allowed.has(statusRaw) ? statusRaw : 'not_started';
  return {
    status,
    signerName: safeText(payload.signerName || payload.customerName || '').trim(),
    signedAt: asDate(payload.signedAt || payload.at) || null,
    note: safeText(payload.note || payload.reason || '').trim(),
    actor: safeText(payload.actor || payload.user || '').trim(),
    updatedAt: asDate(payload.updatedAt) || new Date()
  };
}

function buildDocumentPipelineSnapshot({ booking = {}, rental = {}, financialSnapshot = null } = {}){
  const snapshot = financialSnapshot || rental?.financialSnapshot || booking?.financialSnapshot || buildFinancialSnapshot({ booking, rental });
  const billing = mergeBillingFallback(booking, rental);
  const mainDriver = rental?.mainDriver && typeof rental.mainDriver === 'object' ? rental.mainDriver : {};
  const signatureState = normalizeSignatureState(rental?.signatureState || booking?.signatureState || {});
  const guardrailOverride = normalizeCheckoutGuardrailOverride(rental?.checkoutGuardrailOverride || booking?.checkoutGuardrailOverride || null);
  const hasFinancialOverride = !!guardrailOverride;
  const finBalance = safeNum(snapshot?.settlement?.balance);
  const paidTotal = safeNum(snapshot?.settlement?.paidTotal);
  const hasVehicle = !!safeText(booking?.assignedVehicleLabel || booking?.assignedVehiclePlate || rental?.assignedVehicleLabel || rental?.assignedVehiclePlate).trim();
  const hasMovement = !!asDate(booking?.pickupDateTime) && !!asDate(booking?.dropoffDateTime) && !!safeText(booking?.pickuppoint).trim() && !!safeText(booking?.dropoffpoint).trim();
  const hasCustomer = !!safeText(booking?.customerName).trim();
  const hasDriverIdentity = !!safeText(mainDriver?.fullName).trim() && (!!safeText(mainDriver?.idNo).trim() || !!safeText(mainDriver?.licenseNo).trim());
  const billingCompanyMode = !/^receipt$/i.test(safeText(billing?.invoiceType).trim());

  const buildStatus = (blockers = [], warnings = []) => {
    if (blockers.length) return 'blocked';
    if (warnings.length) return 'review';
    return 'ready';
  };

  const agreementBlockers = [];
  const agreementWarnings = [];
  if (!hasCustomer) agreementBlockers.push('Missing customer name.');
  if (!hasMovement) agreementBlockers.push('Missing pickup/dropoff movement details.');
  if (!hasVehicle) agreementBlockers.push('Missing assigned vehicle.');
  if (!hasDriverIdentity) agreementWarnings.push('Main driver identity is incomplete.');

  const voucherBlockers = [];
  const voucherWarnings = [];
  if (!safeText(booking?.bookingNumber).trim()) voucherBlockers.push('Missing booking number.');
  if (!hasCustomer) voucherBlockers.push('Missing customer name.');
  if (!hasMovement) voucherBlockers.push('Missing movement details.');
  if (!safeText(booking?.voucherNumber).trim() && !safeText(booking?.confirmationNumber).trim()) voucherWarnings.push('Voucher/confirmation reference missing.');

  const invoiceBlockers = [];
  const invoiceWarnings = [];
  if (!snapshot) invoiceWarnings.push('Financial snapshot unavailable.');
  if (billingCompanyMode) {
    if (!safeText(billing?.companyName).trim()) invoiceBlockers.push('Company name required for invoice mode.');
    if (!safeText(billing?.vatNumber).trim()) invoiceWarnings.push('VAT number missing.');
    if (!safeText(billing?.address).trim()) invoiceWarnings.push('Billing address missing.');
  }
  if (finBalance > 0.01 && !hasFinancialOverride) invoiceWarnings.push(`Outstanding balance ${round2(finBalance)} remains.`);

  const receiptBlockers = [];
  const receiptWarnings = [];
  if (!snapshot) receiptBlockers.push('Financial snapshot unavailable.');
  if (paidTotal <= 0.01 && finBalance > 0.01) receiptBlockers.push('No posted payment captured for receipt.');
  if (finBalance > 0.01 && !hasFinancialOverride) receiptWarnings.push('Receipt can be issued only as partial settlement.');

  const signatureBlockers = [];
  const signatureWarnings = [];
  if (buildStatus(agreementBlockers, agreementWarnings) === 'blocked') signatureBlockers.push('Agreement data is blocked.');
  if (!hasDriverIdentity) signatureBlockers.push('Main driver identity incomplete for signature.');
  if (signatureState.status === 'waived') signatureWarnings.push('Signature waived; keep explicit waiver note.');
  if (signatureState.status === 'not_started' || signatureState.status === 'pending') signatureWarnings.push('Signature not captured yet.');

  const docs = {
    agreement: { status: buildStatus(agreementBlockers, agreementWarnings), blockers: agreementBlockers, warnings: agreementWarnings },
    voucher: { status: buildStatus(voucherBlockers, voucherWarnings), blockers: voucherBlockers, warnings: voucherWarnings },
    invoice: { status: buildStatus(invoiceBlockers, invoiceWarnings), blockers: invoiceBlockers, warnings: invoiceWarnings },
    receipt: { status: buildStatus(receiptBlockers, receiptWarnings), blockers: receiptBlockers, warnings: receiptWarnings },
    signature: {
      status: signatureState.status === 'captured'
        ? 'ready'
        : buildStatus(signatureBlockers, signatureWarnings),
      blockers: signatureState.status === 'captured' ? [] : signatureBlockers,
      warnings: signatureState.status === 'captured' ? [] : signatureWarnings
    }
  };

  const statusOrder = { ready: 0, review: 1, blocked: 2 };
  const overallStatus = Object.values(docs).reduce((acc, d) => (statusOrder[d.status] > statusOrder[acc] ? d.status : acc), 'ready');
  const missing = [];
  Object.entries(docs).forEach(([key, doc]) => {
    doc.blockers.forEach((item) => missing.push({ type: key, severity: 'blocker', reason: item }));
    doc.warnings.forEach((item) => missing.push({ type: key, severity: 'warning', reason: item }));
  });

  return {
    generatedAt: new Date().toISOString(),
    source: 'contract_document_pipeline_v1',
    overallStatus,
    signatureState,
    docs,
    missing: missing.slice(0, 40),
    blocks: {
      identity: {
        customerName: safeText(booking?.customerName).trim(),
        mainDriverName: safeText(mainDriver?.fullName).trim(),
        mainDriverIdNo: safeText(mainDriver?.idNo).trim(),
        mainDriverLicenseNo: safeText(mainDriver?.licenseNo).trim()
      },
      movement: {
        pickupDateTime: asDate(booking?.pickupDateTime),
        dropoffDateTime: asDate(booking?.dropoffDateTime),
        pickupPoint: safeText(booking?.pickuppoint).trim(),
        dropoffPoint: safeText(booking?.dropoffpoint).trim()
      },
      vehicle: {
        label: safeText(booking?.assignedVehicleLabel || rental?.assignedVehicleLabel).trim(),
        plate: safeText(booking?.assignedVehiclePlate || rental?.assignedVehiclePlate).trim()
      },
      financial: {
        gross: round2(snapshot?.totals?.gross),
        paidTotal: round2(snapshot?.settlement?.paidTotal),
        balance: round2(snapshot?.settlement?.balance),
        paymentStatus: safeText(snapshot?.settlement?.paymentStatus).trim(),
        guardrailOverride: guardrailOverride ? { reason: guardrailOverride.reason, actor: guardrailOverride.actor, updatedAt: guardrailOverride.updatedAt } : null
      },
      billing: {
        invoiceType: safeText(billing?.invoiceType).trim(),
        companyName: safeText(billing?.companyName).trim(),
        vatNumber: safeText(billing?.vatNumber).trim(),
        address: safeText(billing?.address).trim(),
        city: safeText(billing?.city).trim()
      }
    }
  };
}

function getDocumentReadinessSlice(documentPipeline = {}, documentType = 'agreement'){
  const pipeline = documentPipeline && typeof documentPipeline === 'object' ? documentPipeline : {};
  const docs = pipeline.docs && typeof pipeline.docs === 'object' ? pipeline.docs : {};
  const keyMap = { agreement:'agreement', voucher:'voucher', invoice:'invoice', receipt:'receipt' };
  const key = keyMap[safeText(documentType).toLowerCase()] || 'agreement';
  const doc = docs[key] && typeof docs[key] === 'object' ? docs[key] : { status:'review', blockers:['Readiness not computed.'], warnings:[] };
  return {
    requestedType: key,
    overallStatus: safeText(pipeline.overallStatus || doc.status || 'review'),
    status: safeText(doc.status || 'review'),
    blockers: Array.isArray(doc.blockers) ? doc.blockers.map((x) => safeText(x)).filter(Boolean) : [],
    warnings: Array.isArray(doc.warnings) ? doc.warnings.map((x) => safeText(x)).filter(Boolean) : []
  };
}

function buildContractDocumentPackage({ booking = {}, rental = {}, documentType = 'agreement' } = {}){
  const type = safeText(documentType || 'agreement').toLowerCase();
  const supported = new Set(['agreement', 'voucher', 'invoice', 'receipt']);
  const normalizedType = supported.has(type) ? type : 'agreement';
  const billing = mergeBillingFallback(booking, rental);
  const financialSnapshot = cloneJson(rental?.financialSnapshot || booking?.financialSnapshot || buildFinancialSnapshot({ booking, rental }));
  const commercialState = cloneJson(rental?.commercialState || booking?.commercialState || {});
  const signatureState = normalizeSignatureState(rental?.signatureState || booking?.signatureState || {});
  const documentPipeline = cloneJson(rental?.documentPipeline || booking?.documentPipeline || buildDocumentPipelineSnapshot({ booking, rental, financialSnapshot }));
  const readiness = getDocumentReadinessSlice(documentPipeline, normalizedType);
  const chargeLines = Array.isArray(rental?.chargeLines) ? rental.chargeLines : (Array.isArray(booking?.chargeLines) ? booking.chargeLines : []);
  const movementPickup = asDate(booking?.pickupDateTime);
  const movementDropoff = asDate(booking?.dropoffDateTime);
  const customerName = safeText(booking?.customerName).trim();
  const mainDriver = rental?.mainDriver && typeof rental.mainDriver === 'object' ? rental.mainDriver : {};
  const additionalDrivers = Array.isArray(rental?.additionalDrivers) ? rental.additionalDrivers : [];
  const vehicleLabel = safeText(booking?.assignedVehicleLabel || rental?.assignedVehicleLabel || booking?.assignedVehiclePlate || rental?.assignedVehiclePlate).trim();

  const base = {
    meta: {
      generatedAt: new Date().toISOString(),
      documentType: normalizedType,
      bookingId: safeText(booking?._id),
      bookingNumber: safeText(booking?.bookingNumber),
      rentalId: safeText(rental?._id),
      rentalState: safeText(rental?.rentalState || booking?.rentalState || ''),
      bookingStatus: safeText(booking?.status || ''),
      source: 'contract_document_package_v1'
    },
    identity: {
      customer: {
        name: customerName,
        phone: safeText(booking?.phone).trim(),
        email: safeText(booking?.email).trim(),
        city: safeText(booking?.customerCity).trim()
      },
      mainDriver: {
        fullName: safeText(mainDriver?.fullName).trim(),
        phone: safeText(mainDriver?.phone).trim(),
        email: safeText(mainDriver?.email).trim(),
        idNo: safeText(mainDriver?.idNo).trim(),
        licenseNo: safeText(mainDriver?.licenseNo).trim()
      },
      additionalDrivers: additionalDrivers.map((d) => ({
        fullName: safeText(d?.fullName).trim(),
        idNo: safeText(d?.idNo).trim(),
        licenseNo: safeText(d?.licenseNo).trim()
      }))
    },
    movement: {
      pickupDateTime: movementPickup ? movementPickup.toISOString() : '',
      dropoffDateTime: movementDropoff ? movementDropoff.toISOString() : '',
      pickupPoint: safeText(booking?.pickuppoint).trim(),
      dropoffPoint: safeText(booking?.dropoffpoint).trim(),
      pickupComment: safeText(booking?.pickupComment).trim(),
      dropoffComment: safeText(booking?.dropoffComment).trim(),
      flightNumber: safeText(booking?.flightNumber).trim(),
      originCity: safeText(booking?.originCity).trim()
    },
    vehicle: {
      assignedVehicleId: safeText(booking?.assignedVehicle || rental?.assignedVehicleId).trim(),
      label: vehicleLabel,
      plate: safeText(booking?.assignedVehiclePlate || rental?.assignedVehiclePlate).trim(),
      model: safeText(booking?.assignedVehicleModel || rental?.assignedVehicleModel).trim(),
      categoryCode: safeText(booking?.assignedCategoryCode || rental?.assignedCategoryCode || booking?.categoryId).trim(),
      stationCode: safeText(booking?.assignedVehicleStationCode || rental?.assignedVehicleStationCode).trim(),
      stationLabel: safeText(booking?.assignedVehicleStationLabel || rental?.assignedVehicleStationLabel).trim()
    },
    financial: {
      totals: cloneJson(financialSnapshot?.totals || {}),
      settlement: cloneJson(financialSnapshot?.settlement || {}),
      ledger: cloneJson(financialSnapshot?.ledger || {}),
      commercialState,
      chargeLines: chargeLines.map((line) => ({
        code: safeText(line?.code || line?.key).trim(),
        label: safeText(line?.label).trim(),
        amount: round2(line?.amount),
        category: safeText(line?.category).trim(),
        taxable: line?.taxable !== false
      }))
    },
    billing: {
      invoiceType: safeText(billing?.invoiceType).trim(),
      vatRate: safeNum(billing?.vatRate ?? 0.24),
      vatInclusive: billing?.vatInclusive !== false,
      companyName: safeText(billing?.companyName).trim(),
      tradeName: safeText(billing?.tradeName).trim(),
      vatNumber: safeText(billing?.vatNumber).trim(),
      profession: safeText(billing?.profession).trim(),
      taxOffice: safeText(billing?.taxOffice).trim(),
      address: safeText(billing?.address).trim(),
      city: safeText(billing?.city).trim(),
      zip: safeText(billing?.zip).trim(),
      country: safeText(billing?.country).trim(),
      phone: safeText(billing?.phone).trim(),
      companyEmail: safeText(billing?.companyEmail).trim(),
      contactPerson: safeText(billing?.contactPerson).trim()
    },
    readiness: {
      requestedType: readiness.requestedType,
      status: readiness.status,
      overallStatus: readiness.overallStatus,
      blockers: readiness.blockers,
      warnings: readiness.warnings,
      pipelineSource: safeText(documentPipeline?.source || 'derived')
    },
    signature: {
      status: safeText(signatureState?.status || 'not_started'),
      signerName: safeText(signatureState?.signerName).trim(),
      signedAt: signatureState?.signedAt ? asDate(signatureState.signedAt)?.toISOString() || '' : '',
      note: safeText(signatureState?.note).trim(),
      actor: safeText(signatureState?.actor).trim(),
      updatedAt: signatureState?.updatedAt ? asDate(signatureState.updatedAt)?.toISOString() || '' : ''
    },
    printableContext: {
      title: `${normalizedType.toUpperCase()} • ${safeText(booking?.bookingNumber || booking?._id)}`,
      summaryLine: [customerName || 'Customer pending', vehicleLabel || 'Vehicle pending', safeText(booking?.bookingNumber || '')].filter(Boolean).join(' • ')
    }
  };

  if (normalizedType === 'agreement') {
    base.document = {
      termsFocus: 'rental_agreement',
      includeFinancialSettlement: true,
      includeSignatureBlock: true
    };
  } else if (normalizedType === 'voucher') {
    base.document = {
      termsFocus: 'booking_voucher',
      voucherNumber: safeText(booking?.voucherNumber).trim(),
      confirmationNumber: safeText(booking?.confirmationNumber).trim(),
      includeSignatureBlock: false
    };
  } else if (normalizedType === 'invoice') {
    base.document = {
      termsFocus: 'invoice_ready_payload',
      billingRequired: true,
      paymentStatus: safeText(financialSnapshot?.settlement?.paymentStatus).trim()
    };
  } else if (normalizedType === 'receipt') {
    base.document = {
      termsFocus: 'receipt_ready_payload',
      paidTotal: round2(financialSnapshot?.settlement?.paidTotal),
      balance: round2(financialSnapshot?.settlement?.balance)
    };
  }

  return base;
}

function formatPrintableDate(value){
  const d = asDate(value);
  if (!d) return '—';
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  const hh = String(d.getHours()).padStart(2, '0');
  const mi = String(d.getMinutes()).padStart(2, '0');
  return `${dd}/${mm}/${yyyy} ${hh}:${mi}`;
}

function formatPrintableMoney(value){
  return `${round2(value).toFixed(2)} €`;
}

function row(label, value){
  return { label: safeText(label), value: safeText(value || '—') || '—' };
}

function buildPrintableDocumentModelFromPackage(pkg = {}){
  const p = pkg && typeof pkg === 'object' ? pkg : {};
  const meta = p.meta || {};
  const identity = p.identity || {};
  const movement = p.movement || {};
  const vehicle = p.vehicle || {};
  const financial = p.financial || {};
  const billing = p.billing || {};
  const readiness = p.readiness || {};
  const signature = p.signature || {};
  const doc = p.document || {};
  const type = safeText(meta.documentType || readiness.requestedType || 'agreement').toLowerCase();
  const totals = financial.totals || {};
  const settlement = financial.settlement || {};
  const lines = Array.isArray(financial.chargeLines) ? financial.chargeLines : [];
  const blockers = Array.isArray(readiness.blockers) ? readiness.blockers : [];
  const warnings = Array.isArray(readiness.warnings) ? readiness.warnings : [];

  const sections = [];
  sections.push({
    key: 'header',
    title: `${type.toUpperCase()} • ${safeText(meta.bookingNumber || meta.bookingId || 'Contract')}`,
    rows: [
      row('Generated', formatPrintableDate(meta.generatedAt)),
      row('Rental state', meta.rentalState),
      row('Booking status', meta.bookingStatus),
      row('Readiness', `${safeText(readiness.status || 'review').toUpperCase()} (${safeText(readiness.overallStatus || readiness.status || 'review')})`)
    ]
  });
  sections.push({
    key: 'identity',
    title: 'Customer / Driver',
    rows: [
      row('Customer', identity?.customer?.name),
      row('Phone', identity?.customer?.phone),
      row('Email', identity?.customer?.email),
      row('Main driver', identity?.mainDriver?.fullName),
      row('ID / License', [identity?.mainDriver?.idNo, identity?.mainDriver?.licenseNo].filter(Boolean).join(' / '))
    ]
  });
  sections.push({
    key: 'movement',
    title: 'Rental movement',
    rows: [
      row('Pickup', `${formatPrintableDate(movement.pickupDateTime)} • ${movement.pickupPoint || '—'}`),
      row('Dropoff', `${formatPrintableDate(movement.dropoffDateTime)} • ${movement.dropoffPoint || '—'}`),
      row('Flight', movement.flightNumber),
      row('Origin city', movement.originCity)
    ]
  });
  sections.push({
    key: 'vehicle',
    title: 'Vehicle',
    rows: [
      row('Vehicle', vehicle.label),
      row('Plate', vehicle.plate),
      row('Model', vehicle.model),
      row('Category', vehicle.categoryCode),
      row('Station', [vehicle.stationCode, vehicle.stationLabel].filter(Boolean).join(' • '))
    ]
  });

  const financialRows = [
    row('Gross', formatPrintableMoney(totals.gross)),
    row('Net', formatPrintableMoney(totals.net)),
    row('VAT', formatPrintableMoney(totals.vat)),
    row('Paid total', formatPrintableMoney(settlement.paidTotal)),
    row('Balance', formatPrintableMoney(settlement.balance)),
    row('Payment status', settlement.paymentStatus)
  ];
  sections.push({ key:'financial', title:'Financial summary', rows: financialRows });

  if (type === 'agreement' || type === 'invoice' || type === 'receipt') {
    sections.push({
      key:'charges',
      title:'Charges',
      table: {
        columns: ['Code', 'Label', 'Category', 'Amount'],
        rows: lines.map((line) => [safeText(line.code || '—'), safeText(line.label || '—'), safeText(line.category || '—'), formatPrintableMoney(line.amount)])
      }
    });
  }

  if (type === 'invoice' || type === 'receipt') {
    sections.push({
      key:'billing',
      title:'Billing',
      rows: [
        row('Invoice type', billing.invoiceType),
        row('Company', billing.companyName),
        row('VAT number', billing.vatNumber),
        row('Address', [billing.address, billing.city, billing.zip, billing.country].filter(Boolean).join(', ')),
        row('Contact', [billing.contactPerson, billing.companyEmail, billing.phone].filter(Boolean).join(' • '))
      ]
    });
  }

  if (type === 'agreement') {
    sections.push({
      key:'signature',
      title:'Signature',
      rows: [
        row('Signature status', signature.status),
        row('Signer', signature.signerName),
        row('Signed at', formatPrintableDate(signature.signedAt)),
        row('Note', signature.note)
      ]
    });
  }

  if (type === 'voucher') {
    sections.push({
      key:'confirmation',
      title:'Voucher confirmation',
      rows: [
        row('Voucher no', doc.voucherNumber),
        row('Confirmation no', doc.confirmationNumber),
        row('Summary', p?.printableContext?.summaryLine)
      ]
    });
  }

  sections.push({
    key:'readiness',
    title:'Readiness checks',
    rows: [
      row('Status', readiness.status),
      row('Blockers', blockers.length ? blockers.join(' | ') : 'None'),
      row('Warnings', warnings.length ? warnings.join(' | ') : 'None')
    ]
  });

  return {
    meta: {
      generatedAt: safeText(meta.generatedAt),
      documentType: type,
      source: 'contract_printable_model_v1',
      bookingId: safeText(meta.bookingId),
      rentalId: safeText(meta.rentalId)
    },
    readiness: {
      status: safeText(readiness.status || 'review'),
      overallStatus: safeText(readiness.overallStatus || readiness.status || 'review'),
      blockers,
      warnings
    },
    sections
  };
}

function escapeHtml(value){
  return safeText(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderSectionHtml(section = {}){
  const key = safeText(section.key || '').toLowerCase();
  const rows = Array.isArray(section.rows) ? section.rows : [];
  const table = section.table && typeof section.table === 'object' ? section.table : null;
  const tone = (key === 'financial' || key === 'billing' || key === 'charges') ? 'financial' : (key === 'signature' ? 'signature' : (key === 'readiness' ? 'readiness' : 'base'));
  const bodyRows = rows.map((r) => `<tr><th>${escapeHtml(r.label)}</th><td>${escapeHtml(r.value)}</td></tr>`).join('');
  const tableHtml = table
    ? `<table class="doc-table"><thead><tr>${(table.columns || []).map((c) => `<th>${escapeHtml(c)}</th>`).join('')}</tr></thead><tbody>${(table.rows || []).map((r) => `<tr>${(Array.isArray(r) ? r : []).map((c) => `<td>${escapeHtml(c)}</td>`).join('')}</tr>`).join('')}</tbody></table>`
    : '';
  return `<section class="doc-section ${escapeHtml(tone)} sec-${escapeHtml(key || 'generic')}"><h3>${escapeHtml(section.title || section.key || 'Section')}</h3>${bodyRows ? `<table class="doc-kv">${bodyRows}</table>` : ''}${tableHtml}</section>`;
}

function renderContractDocumentHtmlFromPrintable({ packageData = {}, printable = {} } = {}){
  const meta = printable.meta || {};
  const readiness = printable.readiness || {};
  const sections = Array.isArray(printable.sections) ? printable.sections : [];
  const documentType = safeText(meta.documentType || '').toLowerCase() || 'agreement';
  const readinessClass = safeText(readiness.status || 'review').toLowerCase();
  const headerTitle = safeText(sections.find((s) => s.key === 'header')?.title || `${safeText(meta.documentType).toUpperCase()} Document`);
  const blockers = Array.isArray(readiness.blockers) ? readiness.blockers : [];
  const warnings = Array.isArray(readiness.warnings) ? readiness.warnings : [];
  const subtitleMap = {
    agreement: 'Rental agreement preview',
    voucher: 'Travel voucher preview',
    invoice: 'Invoice preview',
    receipt: 'Receipt preview'
  };
  const subtitle = subtitleMap[documentType] || 'Document preview';
  return `<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>${escapeHtml(headerTitle)}</title>
  <style>
    @page{size:A4;margin:12mm}
    body{font-family:Inter,Arial,Helvetica,sans-serif;color:#1f2937;background:#f5f7fb;margin:0}
    .doc-wrap{max-width:980px;margin:0 auto;padding:20px 16px 28px}
    .doc-head{border:1px solid #d9dee7;border-radius:14px;background:#fff;padding:14px 16px;margin-bottom:12px;page-break-inside:avoid}
    .doc-title{font-size:22px;font-weight:800;margin:0 0 4px;color:#0f172a}
    .doc-subtitle{font-size:12px;color:#64748b;margin-bottom:8px}
    .doc-meta{font-size:12px;color:#6b7280}
    .readiness{display:inline-block;margin-top:8px;padding:6px 12px;border-radius:999px;font-size:12px;font-weight:800;border:1px solid #d1d5db;text-transform:uppercase;letter-spacing:.02em}
    .readiness.ready{background:#edf8f1;color:#0f6a3d;border-color:#9ed3b3}
    .readiness.review{background:#fff7e7;color:#8a5600;border-color:#f3d192}
    .readiness.blocked{background:#fff1f0;color:#a12f28;border-color:#f0b8b4}
    .doc-alerts{margin:10px 0 14px;padding:11px 12px;border:1px dashed #d1d5db;border-radius:10px;background:#fafafa;page-break-inside:avoid}
    .doc-alerts strong{font-size:12px;letter-spacing:.02em;text-transform:uppercase;color:#334155}
    .doc-alerts ul{margin:6px 0 0 18px}
    .doc-alerts li{font-size:12px;line-height:1.5}
    .doc-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .doc-section{border:1px solid #e5e7eb;border-radius:12px;padding:10px 11px;background:#fff;page-break-inside:avoid}
    .doc-section h3{margin:0 0 8px;font-size:13px;text-transform:uppercase;letter-spacing:.03em;color:#334155}
    .doc-section.financial,.doc-section.signature,.doc-section.readiness{border-color:#d8dee9}
    .doc-section.sec-financial,.doc-section.sec-charges,.doc-section.sec-billing{grid-column:1 / -1}
    .doc-section.sec-readiness{grid-column:1 / -1}
    .doc-kv,.doc-table{width:100%;border-collapse:collapse}
    .doc-kv th,.doc-kv td,.doc-table th,.doc-table td{border-bottom:1px solid #eef2f7;padding:7px 6px;font-size:12px;text-align:left;vertical-align:top}
    .doc-kv th{width:32%;color:#475569;font-weight:600}
    .doc-kv tr:last-child th,.doc-kv tr:last-child td,.doc-table tr:last-child td{border-bottom:0}
    .doc-table thead th{font-size:11px;text-transform:uppercase;letter-spacing:.03em;color:#475569;background:#f8fafc}
    .doc-table td:last-child,.doc-table th:last-child{text-align:right}
    .doc-foot{margin-top:12px;font-size:11px;color:#6b7280;text-align:right;padding:8px 2px}
    .doc-type-agreement .doc-head{border-top:4px solid #1d4ed8}
    .doc-type-voucher .doc-head{border-top:4px solid #0f766e}
    .doc-type-invoice .doc-head{border-top:4px solid #7c3aed}
    .doc-type-receipt .doc-head{border-top:4px solid #b45309}
    @media print{
      body{background:#fff}
      .doc-wrap{max-width:none;padding:0}
      .doc-grid{gap:8px}
      .doc-section{break-inside:avoid-page}
    }
  </style>
</head>
<body class="doc-type-${escapeHtml(documentType)}">
  <div class="doc-wrap">
    <header class="doc-head">
      <h1 class="doc-title">${escapeHtml(headerTitle)}</h1>
      <div class="doc-subtitle">${escapeHtml(subtitle)}</div>
      <div class="doc-meta">Booking ${escapeHtml(meta.bookingId || '—')} • Rental ${escapeHtml(meta.rentalId || '—')} • Generated ${escapeHtml(formatPrintableDate(meta.generatedAt))}</div>
      <span class="readiness ${escapeHtml(readinessClass)}">Readiness: ${escapeHtml(readiness.status || 'review')}</span>
    </header>
    <div class="doc-alerts">
      <strong>Readiness checks</strong>
      <ul>
        ${(blockers.length ? blockers.map((b) => `<li><strong>Blocker:</strong> ${escapeHtml(b)}</li>`).join('') : '<li>No blockers.</li>')}
        ${(warnings.length ? warnings.map((w) => `<li><strong>Warning:</strong> ${escapeHtml(w)}</li>`).join('') : '<li>No warnings.</li>')}
      </ul>
    </div>
    <main class="doc-grid">
      ${sections.filter((s) => s.key !== 'header' && s.key !== 'readiness').map((s) => renderSectionHtml(s)).join('')}
      ${renderSectionHtml(sections.find((s) => s.key === 'readiness') || { key:'readiness', title:'Readiness checks', rows:[{label:'Status', value:readiness.status || 'review'}] })}
    </main>
    <footer class="doc-foot">Source: ${escapeHtml(meta.source || packageData?.meta?.source || 'contract_printable_model_v1')}</footer>
  </div>
</body>
</html>`;
}

function htmlToPlainTextForPdf(html){
  const source = safeText(html || '');
  return source
    .replace(/<style[\s\S]*?<\/style>/gi, ' ')
    .replace(/<script[\s\S]*?<\/script>/gi, ' ')
    .replace(/<\/(h1|h2|h3|p|div|section|tr|li|ul|ol|table|header|footer|main)>/gi, '\n')
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\n{3,}/g, '\n\n')
    .replace(/[ \t]{2,}/g, ' ')
    .trim();
}

async function renderPdfBufferFromHtml(html, { title = 'Contract document' } = {}){
  const PDFDocument = require("pdfkit");
  const printableText = htmlToPlainTextForPdf(html);
  return new Promise((resolve, reject) => {
    try {
      const doc = new PDFDocument({ size:"A4", margin:40 });
      const chunks = [];
      doc.on("data", (c) => chunks.push(c));
      doc.on("end", () => resolve(Buffer.concat(chunks)));
      doc.on("error", reject);
      doc.fontSize(16).text(safeText(title || 'Contract document'));
      doc.moveDown(0.6);
      doc.fontSize(9).text(printableText || 'No rendered HTML content.', { width: 520 });
      doc.end();
    } catch (e) {
      reject(e);
    }
  });
}

async function renderPdfBufferFromHtmlHighFidelity(html, { title = 'Contract document' } = {}){
  let browser = null;
  try {
    const puppeteer = require("puppeteer");
    browser = await puppeteer.launch({
      headless: true,
      args: ['--no-sandbox', '--disable-setuid-sandbox']
    });
    const page = await browser.newPage();
    await page.setContent(safeText(html || ''), { waitUntil: 'networkidle0' });
    const buffer = await page.pdf({
      format: 'A4',
      printBackground: true,
      displayHeaderFooter: true,
      headerTemplate: '<div></div>',
      footerTemplate: `<div style="font-size:8px;color:#666;padding:0 10px;width:100%;text-align:right;">${escapeHtml(title)}</div>`,
      margin: { top: '18mm', right: '10mm', bottom: '16mm', left: '10mm' }
    });
    return Buffer.from(buffer);
  } finally {
    if (browser) {
      try { await browser.close(); } catch (_) {}
    }
  }
}

function getRendererCapabilitySnapshot(){
  const supportsHtmlTemplate = true;
  const supportsPdfFromHtml = true;
  let supportsPdfFromHtmlHifi = false;
  const notes = [];
  try {
    require("puppeteer");
    supportsPdfFromHtmlHifi = true;
  } catch (_) {
    supportsPdfFromHtmlHifi = false;
    notes.push('Puppeteer module unavailable in current runtime; high-fidelity engine may not run.');
  }
  return {
    supportsHtmlTemplate,
    supportsPdfFromHtml,
    supportsPdfFromHtmlHifi,
    preferredRenderEngine: supportsPdfFromHtmlHifi ? 'puppeteer_html_pdf' : 'pdfkit_text_fallback',
    availableRenderEngines: supportsPdfFromHtmlHifi ? ['puppeteer_html_pdf', 'pdfkit_text_fallback'] : ['pdfkit_text_fallback'],
    runtimeLimitations: notes
  };
}

async function runRendererSelfTestInternal(){
  const started = Date.now();
  const capabilitySnapshot = getRendererCapabilitySnapshot();
  const sampleHtml = '<!doctype html><html><body><h1>Renderer self-test</h1><p>Diamond Rent a Car · synthetic render probe.</p></body></html>';
  const result = {
    checkedAt: new Date().toISOString(),
    capabilitySnapshot,
    attemptedEngines: [],
    stages: {
      hifi: { modulePresent: false, launchSupported: false, renderSupported: false, durationMs: 0, error: '' },
      fallback: { launchSupported: false, renderSupported: false, durationMs: 0, error: '' }
    },
    fallbackRequired: false,
    failureStage: '',
    hifiReady: false,
    preferredEngineConfidence: 'low',
    recommendedRenderMode: 'legacy_pdfkit',
    status: 'unavailable',
    durationMs: 0,
    warnings: []
  };

  const hifiStart = Date.now();
  result.attemptedEngines.push('puppeteer_html_pdf');
  try {
    require("puppeteer");
    result.stages.hifi.modulePresent = true;
    const hifiBuffer = await renderPdfBufferFromHtmlHighFidelity(sampleHtml, { title: 'Renderer self-test' });
    result.stages.hifi.launchSupported = true;
    result.stages.hifi.renderSupported = !!(hifiBuffer && hifiBuffer.length > 0);
  } catch (e) {
    result.stages.hifi.error = safeText(e?.message || e || 'unknown hifi error');
    result.failureStage = result.failureStage || (result.stages.hifi.modulePresent ? 'HIFI_RENDER' : 'HIFI_MODULE');
  } finally {
    result.stages.hifi.durationMs = Date.now() - hifiStart;
  }

  const fallbackStart = Date.now();
  result.attemptedEngines.push('pdfkit_text_fallback');
  try {
    const fallbackBuffer = await renderPdfBufferFromHtml(sampleHtml, { title: 'Renderer self-test' });
    result.stages.fallback.launchSupported = true;
    result.stages.fallback.renderSupported = !!(fallbackBuffer && fallbackBuffer.length > 0);
  } catch (e) {
    result.stages.fallback.error = safeText(e?.message || e || 'unknown fallback error');
    result.failureStage = result.failureStage || 'FALLBACK_RENDER';
  } finally {
    result.stages.fallback.durationMs = Date.now() - fallbackStart;
  }

  result.hifiReady = !!result.stages.hifi.renderSupported;
  result.fallbackRequired = !result.hifiReady;
  if (result.hifiReady) {
    result.status = 'healthy';
    result.preferredEngineConfidence = 'high';
    result.recommendedRenderMode = 'pdf_from_html';
  } else if (result.stages.fallback.renderSupported) {
    result.status = 'fallback-only';
    result.preferredEngineConfidence = 'medium';
    result.recommendedRenderMode = 'pdf_from_html';
    result.warnings.push('High-fidelity renderer not verified; running in fallback-only mode.');
  } else {
    result.status = 'degraded';
    result.preferredEngineConfidence = 'low';
    result.recommendedRenderMode = 'legacy_pdfkit';
    result.warnings.push('Fallback renderer self-test failed; use legacy PDFKit path.');
  }
  if (capabilitySnapshot.runtimeLimitations?.length) {
    result.warnings.push(...capabilitySnapshot.runtimeLimitations);
  }
  result.durationMs = Date.now() - started;
  return result;
}

function buildSyntheticDocumentPackage(documentType = 'agreement'){
  const type = safeText(documentType || 'agreement').toLowerCase();
  const base = {
    meta: {
      generatedAt: new Date('2026-01-01T12:00:00.000Z').toISOString(),
