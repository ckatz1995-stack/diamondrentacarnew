function digitsOnly(value){
  return safeText(value).replace(/\D+/g, '');
}

function normalizeLoose(value){
  return safeText(value).trim().toLowerCase();
}

function toIsoDateLabel(value){
  const d = asDate(value);
  if (!d) return '';
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

function bookingStatusLabel(booking = {}, rental = {}){
  return safeText(rental?.rentalState || booking?.rentalState || booking?.status || 'Draft');
}

function bookingSourceLabelBackend(booking = {}){
  return safeText(
    booking.source || booking.channel || booking.provider || booking.origin || booking.bookingSource || booking.createdSource || ''
  );
}

function matchBookingAgainstCustomerSeeds(booking = {}, seeds = {}){
  const bookingEmail = normalizeLoose(booking.email);
  const bookingPhone = digitsOnly(booking.phone);
  const bookingName = normalizeLoose(booking.customerName);
  if (seeds.email && bookingEmail && bookingEmail === seeds.email) return true;
  if (seeds.phone && bookingPhone && bookingPhone === seeds.phone) return true;
  if (seeds.fullName && bookingName && (bookingName === seeds.fullName || bookingName.includes(seeds.fullName) || seeds.fullName.includes(bookingName))) return true;
  return false;
}

async function collectBookingMatchesByCustomerSeeds(seeds = {}, limit = 80){
  const map = new Map();
  const safeLimit = Math.min(Math.max(Number(limit) || 80, 1), 200);
  const collect = async (query) => {
    try {
      const res = await query.limit(Math.min(safeLimit, BOOKING_LIMIT)).find({ suppressAuth:true });
      for (const item of (res.items || [])) {
        if (!item?._id) continue;
        map.set(String(item._id), item);
      }
    } catch (_) {}
  };

  if (seeds.email) {
    await collect(wixData.query('BookingsNew').eq('email', seeds.email));
  }
  if (seeds.phone) {
    await collect(wixData.query('BookingsNew').eq('phone', seeds.phoneRaw || seeds.phone));
    if (seeds.phone.length >= 6) {
      await collect(wixData.query('BookingsNew').contains('phone', seeds.phone.slice(-6)));
    }
  }
  if (seeds.fullName) {
    await collect(wixData.query('BookingsNew').contains('customerName', seeds.fullNameRaw || seeds.fullName));
  }

  const filtered = Array.from(map.values()).filter((booking) => matchBookingAgainstCustomerSeeds(booking, seeds));
  filtered.sort((a, b) => {
    const ad = asDate(a.pickupDateTime)?.getTime() || 0;
    const bd = asDate(b.pickupDateTime)?.getTime() || 0;
    return bd - ad;
  });
  return filtered.slice(0, safeLimit);
}

async function getCustomerFinancialInsightsFromBookings(bookings = []){
  const ids = Array.from(new Set(bookings.map((item) => safeText(item._id)).filter(Boolean)));
  const rentalMap = new Map();
  if (ids.length) {
    for (let i = 0; i < ids.length; i += 50) {
      const chunk = ids.slice(i, i + 50);
      try {
        const res = await wixData.query('RentalsNew').hasSome('bookingId', chunk).limit(1000).find({ suppressAuth:true });
        for (const item of (res.items || [])) {
          rentalMap.set(String(item.bookingId), item);
        }
      } catch (_) {}
    }
  }

  const now = Date.now();
  const history = bookings.map((booking) => {
    const rental = rentalMap.get(String(booking._id)) || {};
    const pickup = asDate(booking.pickupDateTime);
    const dropoff = asDate(booking.dropoffDateTime);
    const total = round2(booking.totalPrice ?? deriveChargeLines(booking, rental?.charges || {}).gross);
    const prepaid = round2(booking.prepaidAmount ?? rental.prepaidAmount ?? rental.financials?.prepaid ?? 0);
    const paidNow = round2(booking.paidNowAmount ?? rental.paidNowAmount ?? rental.financials?.paidNow ?? 0);
    const deposit = round2(booking.depositAmount ?? rental.depositAmount ?? rental.financials?.deposit ?? 0);
    return {
      bookingId: safeText(booking._id),
      bookingNumber: safeText(booking.bookingNumber || booking._id),
      pickupLabel: pickup ? pickup.toLocaleString('el-GR') : '—',
      dropoffLabel: dropoff ? dropoff.toLocaleString('el-GR') : '—',
      pickupDateTime: pickup ? pickup.toISOString() : '',
      dropoffDateTime: dropoff ? dropoff.toISOString() : '',
      statusLabel: bookingStatusLabel(booking, rental),
      source: bookingSourceLabelBackend(booking) || '—',
      category: safeText(booking.category || booking.categoryId || ''),
      total,
      prepaid,
      paidNow,
      deposit,
      isFuture: pickup ? pickup.getTime() > now : false,
      isPast: dropoff ? dropoff.getTime() < now : false,
    };
  });

  const totalBookings = history.length;
  const pastBookings = history.filter((item) => item.isPast).length;
  const futureBookings = history.filter((item) => item.isFuture).length;
  const lifetimeGross = round2(history.reduce((sum, item) => sum + safeNum(item.total), 0));
  const collected = round2(history.reduce((sum, item) => sum + safeNum(item.prepaid) + safeNum(item.paidNow), 0));
  const deposits = round2(history.reduce((sum, item) => sum + safeNum(item.deposit), 0));
  const futureGross = round2(history.filter((item) => item.isFuture).reduce((sum, item) => sum + safeNum(item.total), 0));
  const avgTicket = totalBookings ? round2(lifetimeGross / totalBookings) : 0;

  const sortedAsc = [...history].sort((a, b) => {
    const ad = asDate(a.pickupDateTime)?.getTime() || 0;
    const bd = asDate(b.pickupDateTime)?.getTime() || 0;
    return ad - bd;
  });
  const last = [...history].filter((item) => item.isPast).sort((a, b) => (asDate(b.pickupDateTime)?.getTime() || 0) - (asDate(a.pickupDateTime)?.getTime() || 0))[0] || null;
  const next = sortedAsc.find((item) => item.isFuture) || null;
  const lastNextLabel = [last ? `Last ${last.bookingNumber}` : '', next ? `Next ${next.bookingNumber}` : ''].filter(Boolean).join(' · ') || '—';

  return {
    summary: { totalBookings, pastBookings, futureBookings, lifetimeGross, collected, deposits, futureGross, avgTicket, lastNextLabel },
    history
  };
}




function matchBookingAgainstCompanySeeds(booking = {}, rental = {}, seeds = {}){
  const billing = mergeBillingFallback(booking, rental);
  const companyName = normalizeLoose(billing.companyName);
  const tradeName = normalizeLoose(billing.tradeName);
  const vatNumber = normalizeLoose(billing.vatNumber);
  const email = normalizeLoose(billing.companyEmail);
  const phone = digitsOnly(billing.phone);
  if (seeds.vatNumber && vatNumber && vatNumber === seeds.vatNumber) return true;
  if (seeds.email && email && email === seeds.email) return true;
  if (seeds.phone && phone && phone === seeds.phone) return true;
  if (seeds.companyName && companyName && (companyName === seeds.companyName || companyName.includes(seeds.companyName) || seeds.companyName.includes(companyName))) return true;
  if (seeds.tradeName && tradeName && (tradeName === seeds.tradeName || tradeName.includes(seeds.tradeName) || seeds.tradeName.includes(tradeName))) return true;
  return false;
}

async function collectBookingMatchesByCompanySeeds(seeds = {}, limit = 80){
  const safeLimit = Math.min(Math.max(Number(limit) || 80, 1), 200);
  const bookingMap = new Map();
  try {
    const res = await wixData.query('BookingsNew').descending('pickupDateTime').limit(BOOKING_LIMIT).find({ suppressAuth:true });
    for (const item of (res.items || [])) {
      if (item?._id) bookingMap.set(String(item._id), item);
    }
  } catch (_) {}

  const rentalMap = new Map();
  const bookingIds = Array.from(bookingMap.keys());
  if (bookingIds.length) {
    for (let i = 0; i < bookingIds.length; i += 50) {
      const chunk = bookingIds.slice(i, i + 50);
      try {
        const res = await wixData.query('RentalsNew').hasSome('bookingId', chunk).limit(1000).find({ suppressAuth:true });
        for (const item of (res.items || [])) {
          const id = safeText(item.bookingId || '');
          if (id) rentalMap.set(id, item);
        }
      } catch (_) {}
    }
  }

  const filtered = Array.from(bookingMap.values()).filter((booking) => {
    const rental = rentalMap.get(String(booking._id)) || {};
    return matchBookingAgainstCompanySeeds(booking, rental, seeds);
  });

  filtered.sort((a, b) => {
    const ad = asDate(a.pickupDateTime)?.getTime() || 0;
    const bd = asDate(b.pickupDateTime)?.getTime() || 0;
    return bd - ad;
  });
  return filtered.slice(0, safeLimit);
}

export async function getCompanyInsights({ authToken, company = {}, limit = 80 }) {
  await requireStaffAccess({ sessionToken: authToken, area: "rentals", action: "View" });
  try {
    const companyId = safeText(company?.companyId || '');
    let companyRecord = null;
    if (companyId) {
      try { companyRecord = await wixData.get('Companies', companyId, { suppressAuth:true }); } catch (_) {}
    }

    const companyNameRaw = safeText(companyRecord?.companyName || company?.companyName || '');
    const tradeNameRaw = safeText(companyRecord?.tradeName || company?.tradeName || '');
    const vatNumberRaw = safeText(companyRecord?.vatNumber || company?.vatNumber || '');
    const emailRaw = safeText(companyRecord?.email || company?.companyEmail || company?.email || '');
    const phoneRaw = safeText(companyRecord?.phone || company?.phone || '');
    const seeds = {
      companyId,
      companyNameRaw,
      companyName: normalizeLoose(companyNameRaw),
      tradeNameRaw,
      tradeName: normalizeLoose(tradeNameRaw),
      vatNumberRaw,
      vatNumber: normalizeLoose(vatNumberRaw),
      emailRaw,
      email: normalizeLoose(emailRaw),
      phoneRaw,
      phone: digitsOnly(phoneRaw)
    };

    const bookings = await collectBookingMatchesByCompanySeeds(seeds, limit);
    const insights = await getCustomerFinancialInsightsFromBookings(bookings);
    return {
      success: true,
      profile: {
        companyId: companyId || safeText(companyRecord?._id || ''),
        companyName: companyNameRaw,
        tradeName: tradeNameRaw,
        vatNumber: vatNumberRaw,
        phone: phoneRaw,
        email: emailRaw,
        contactPerson: safeText(companyRecord?.contactPerson || company?.contactPerson || ''),
        city: safeText(companyRecord?.city || company?.city || ''),
        country: safeText(companyRecord?.country || company?.country || '')
      },
      summary: insights.summary,
      history: insights.history
    };
  } catch (e) {
    return { success:false, message:e?.message || String(e), summary:null, history:[] };
  }
}


export async function getCustomerInsights({ authToken, customer = {}, limit = 80 }) {
  await requireStaffAccess({ sessionToken: authToken, area: "rentals", action: "View" });
  try {
    const customerId = safeText(customer?.customerId || '');
    let customerRecord = null;
    if (customerId) {
      try { customerRecord = await wixData.get('Customers', customerId, { suppressAuth:true }); } catch (_) {}
    }
    const fullNameRaw = safeText(customerRecord?.fullName || customer?.fullName || [customerRecord?.firstName, customerRecord?.lastName].filter(Boolean).join(' '));
    const emailRaw = safeText(customerRecord?.email || customer?.email || '');
    const phoneRaw = safeText(customerRecord?.mobilePhone || customerRecord?.phone || customer?.phone || '');
    const seeds = {
      customerId,
      fullNameRaw,
      fullName: normalizeLoose(fullNameRaw),
      emailRaw,
      email: normalizeLoose(emailRaw),
      phoneRaw,
      phone: digitsOnly(phoneRaw),
      idNo: normalizeLoose(customerRecord?.idNumber || customer?.idNo || ''),
      licenseNo: normalizeLoose(customerRecord?.licenseNumber || customer?.licenseNo || '')
    };

    const bookings = await collectBookingMatchesByCustomerSeeds(seeds, limit);
    const insights = await getCustomerFinancialInsightsFromBookings(bookings);
    return {
      success: true,
      profile: {
        customerId: customerId || safeText(customerRecord?._id || ''),
        fullName: fullNameRaw,
        email: emailRaw,
        phone: phoneRaw,
        idNo: safeText(customerRecord?.idNumber || customer?.idNo || ''),
        licenseNo: safeText(customerRecord?.licenseNumber || customer?.licenseNo || '')
      },
      summary: insights.summary,
      history: insights.history
    };
  } catch (e) {
    return { success:false, message:e?.message || String(e), summary:null, history:[] };
  }
}

function mergeBillingFallback(booking = {}, rental = {}){
  const bookingBilling = (booking.billing && typeof booking.billing === 'object') ? booking.billing : {};
  const rentalBilling = (rental.billing && typeof rental.billing === 'object') ? rental.billing : {};
  return {
    vatRate: safeNum(rentalBilling.vatRate ?? bookingBilling.vatRate ?? 0.24),
    vatInclusive: (rentalBilling.vatInclusive ?? bookingBilling.vatInclusive ?? true) ? true : false,
    invoiceType: safeText(rentalBilling.invoiceType || bookingBilling.invoiceType || ''),
    vatNumber: safeText(rentalBilling.vatNumber || bookingBilling.vatNumber || ''),
    companyName: safeText(rentalBilling.companyName || bookingBilling.companyName || ''),
    tradeName: safeText(rentalBilling.tradeName || bookingBilling.tradeName || ''),
    profession: safeText(rentalBilling.profession || bookingBilling.profession || ''),
    taxOffice: safeText(rentalBilling.taxOffice || bookingBilling.taxOffice || ''),
    address: safeText(rentalBilling.address || bookingBilling.address || ''),
    city: safeText(rentalBilling.city || bookingBilling.city || ''),
    zip: safeText(rentalBilling.zip || bookingBilling.zip || ''),
    country: safeText(rentalBilling.country || bookingBilling.country || ''),
    phone: safeText(rentalBilling.phone || bookingBilling.phone || ''),
    companyEmail: safeText(rentalBilling.companyEmail || bookingBilling.companyEmail || ''),
    contactPerson: safeText(rentalBilling.contactPerson || bookingBilling.contactPerson || ''),
    notes: safeText(rentalBilling.notes || bookingBilling.notes || ''),
  };
}

function mergeFinancialsFallback(booking = {}, rental = {}){
  const bookingFinancials = (booking.financials && typeof booking.financials === 'object') ? booking.financials : {};
  const rentalFinancials = (rental.financials && typeof rental.financials === 'object') ? rental.financials : {};
  return {
    paymentMethod: safeText(rentalFinancials.paymentMethod || rental.paymentMethod || bookingFinancials.paymentMethod || booking.paymentMethod || 'cash') || 'cash',
    paymentStatus: safeText(rentalFinancials.paymentStatus || rental.paymentStatus || bookingFinancials.paymentStatus || booking.paymentStatus || 'pending') || 'pending',
    prepaid: safeNum(rentalFinancials.prepaid ?? rental.prepaidAmount ?? bookingFinancials.prepaid ?? booking.prepaidAmount ?? 0),
    paidNow: safeNum(rentalFinancials.paidNow ?? rental.paidNowAmount ?? bookingFinancials.paidNow ?? booking.paidNowAmount ?? 0),
    deposit: safeNum(rentalFinancials.deposit ?? rental.depositAmount ?? bookingFinancials.deposit ?? booking.depositAmount ?? 0),
  };
}

// --------------------
// ✅ Contract (this MUST work always)
// --------------------
export async function getContract({ authToken, bookingId }) {
  await requireStaffAccess({ sessionToken: authToken, area: "rentals", action: "View" });
  try {
    if (!bookingId) return { success:false, message:"Missing bookingId" };

    const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
    if (!booking) return { success:false, message:"Booking not found" };

    booking.pickuppoint = pickLabel(booking.pickuppoint);
    booking.dropoffpoint = pickLabel(booking.dropoffpoint);

    if (booking.assignedVehicle && typeof booking.assignedVehicle === "string") {
      const fleetMap = await getFleetMapByIds([booking.assignedVehicle]);
      const f = fleetMap.get(String(booking.assignedVehicle));
      if (f) {
        booking.assignedVehicleLabel = safeText(booking.assignedVehicleLabel || f.label);
        booking.assignedCategoryCode = safeText(booking.assignedCategoryCode || f.assignedCategoryCode);
        booking.assignedVehiclePlate = safeText(booking.assignedVehiclePlate || f.plate);
        booking.assignedVehicleModel = safeText(booking.assignedVehicleModel || f.model);
        booking.assignedVehicleStationCode = safeText(booking.assignedVehicleStationCode || f.currentStationCode);
        booking.assignedVehicleStationLabel = safeText(booking.assignedVehicleStationLabel || f.currentStationLabel);
        booking.assignedVehicleMileage = safeNum(booking.assignedVehicleMileage || f.mileage);
        booking.assignedVehicleFuelLevel = safeNum(booking.assignedVehicleFuelLevel || f.fuelLevel);
        booking.assignedVehicleExcess = safeNum(booking.assignedVehicleExcess || f.excess);
      }
    }

    booking.mainDriverDefault = {
      fullName: safeText(booking.customerName),
      phone: safeText(booking.phone),
      email: safeText(booking.email),
    };

    const rental = await ensureRentalForBooking(booking);
    rental.billing = mergeBillingFallback(booking, rental);
    rental.financials = mergeFinancialsFallback(booking, rental);
    rental.paymentMethod = rental.financials.paymentMethod;
    rental.paymentStatus = rental.financials.paymentStatus;
    rental.prepaidAmount = rental.financials.prepaid;
    rental.paidNowAmount = rental.financials.paidNow;
    rental.depositAmount = rental.financials.deposit;
    booking.financials = { ...(booking.financials || {}), ...rental.financials };
    booking.paymentMethod = rental.financials.paymentMethod;
    booking.paymentStatus = rental.financials.paymentStatus;
    booking.prepaidAmount = rental.financials.prepaid;
    booking.paidNowAmount = rental.financials.paidNow;
    booking.depositAmount = rental.financials.deposit;
    syncBookingChargeFields(booking, rental);

    if (!booking.pricingSnapshot) booking.pricingSnapshot = buildPricingSnapshot(booking, rental);
    rental.pricingSnapshot = cloneJson(booking.pricingSnapshot);
    rental.pricingReview = buildPricingReview(booking, rental);

    if (!safeText(rental.assignedVehicleLabel) && safeText(booking.assignedVehicleLabel)) {
      rental.assignedVehicleLabel = safeText(booking.assignedVehicleLabel);
    }
    if (!safeText(rental.assignedVehicleStationCode) && safeText(booking.assignedVehicleStationCode)) rental.assignedVehicleStationCode = safeText(booking.assignedVehicleStationCode);
    if (!safeText(rental.assignedVehicleStationLabel) && safeText(booking.assignedVehicleStationLabel)) rental.assignedVehicleStationLabel = safeText(booking.assignedVehicleStationLabel);
    if (!safeNum(rental.assignedVehicleMileage) && safeNum(booking.assignedVehicleMileage)) rental.assignedVehicleMileage = safeNum(booking.assignedVehicleMileage);
    if (!safeNum(rental.assignedVehicleFuelLevel) && safeNum(booking.assignedVehicleFuelLevel)) rental.assignedVehicleFuelLevel = safeNum(booking.assignedVehicleFuelLevel);
    if (!safeNum(rental.assignedVehicleExcess) && safeNum(booking.assignedVehicleExcess)) rental.assignedVehicleExcess = safeNum(booking.assignedVehicleExcess);
    await wixData.update("RentalsNew", rental, { suppressAuth:true });

    const lookups = await buildContractLookups(booking);
    return { success:true, booking, rental, lookups };
  } catch (e) {
    return { success:false, message: e?.message || String(e) };
  }
}


export async function confirmBookingAnalysis({ authToken, bookingId }) {
  await requireStaffAccess({ sessionToken: authToken, area: "rentals", action: "Edit" });
  try {
    if (!bookingId) return { success:false, message:"Missing bookingId" };
    const result = await confirmAndAutoAssign({ authToken, bookingId });
    if (!result?.success) return { success:false, message: result?.message || "Confirm failed" };
    const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
    booking.status = "Confirmed";
    booking.confirmedAt = booking.confirmedAt || new Date();
    booking.statusChangedAt = new Date();
    await wixData.update("BookingsNew", booking, { suppressAuth:true });
    return { success:true, assigned: !!result.assigned, message: result.assigned ? "Booking confirmed & vehicle assigned" : "Booking confirmed" };
  } catch (e) {
    return { success:false, message: e?.message || String(e) };
  }
}

// --------------------
// Legacy start/close (kept)
// --------------------
export async function startRental({ bookingId, by }) {
  if (!bookingId) return { success:false, message:"Missing bookingId" };
  const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
  if (!booking) return { success:false, message:"Booking not found" };

  const rental = await ensureRentalForBooking(booking);
  rental.rentalState = "Active Rental";
  rental.checkoutAt = rental.checkoutAt || new Date();
  rental.checkoutBy = safeText(by || rental.checkoutBy || "");
  await wixData.update("RentalsNew", rental, { suppressAuth:true });

  booking.rentalState = "Active Rental";
  await wixData.update("BookingsNew", booking, { suppressAuth:true });
  await mirrorToBooking(booking, rental);

  return { success:true };
}

export async function closeRental({ bookingId, by }) {
  if (!bookingId) return { success:false, message:"Missing bookingId" };
  const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
  if (!booking) return { success:false, message:"Booking not found" };

  const rental = await ensureRentalForBooking(booking);
  rental.rentalState = "Closed Rental";
  rental.checkinAt = rental.checkinAt || new Date();
  rental.checkinBy = safeText(by || rental.checkinBy || "");
  await wixData.update("RentalsNew", rental, { suppressAuth:true });

  booking.rentalState = "Closed Rental";
  await wixData.update("BookingsNew", booking, { suppressAuth:true });
  await mirrorToBooking(booking, rental);

  return { success:true };
}

// --------------------
// ✅ saveContract (PDF+Email are lazy-loaded)
// --------------------
export async function saveContract({ authToken, bookingId, payload, stage }) {
  const access = await requireStaffAccess({ sessionToken: authToken, area: "rentals", action: "Edit" });
  try {
    if (!bookingId) return { success:false, message:"Missing bookingId" };

    const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
    if (!booking) return { success:false, message:"Booking not found" };

    const rental = await ensureRentalForBooking(booking);

    if (payload?.assignedVehicle !== undefined) {
      booking.assignedVehicle = safeText(payload.assignedVehicle);
      rental.assignedVehicleId = safeText(payload.assignedVehicle);
    }
    if (payload?.assignedVehicleLabel !== undefined) {
      rental.assignedVehicleLabel = safeText(payload.assignedVehicleLabel);
      booking.assignedVehicleLabel = safeText(payload.assignedVehicleLabel);
    }
    if (payload?.assignedVehiclePlate !== undefined) {
      booking.assignedVehiclePlate = safeText(payload.assignedVehiclePlate);
      rental.assignedVehiclePlate = safeText(payload.assignedVehiclePlate);
    }
    if (payload?.assignedVehicleModel !== undefined) {
      booking.assignedVehicleModel = safeText(payload.assignedVehicleModel);
      rental.assignedVehicleModel = safeText(payload.assignedVehicleModel);
    }
    if (payload?.assignedVehicleStationCode !== undefined) {
      booking.assignedVehicleStationCode = safeText(payload.assignedVehicleStationCode);
      rental.assignedVehicleStationCode = safeText(payload.assignedVehicleStationCode);
    }
    if (payload?.assignedVehicleStationLabel !== undefined) {
      booking.assignedVehicleStationLabel = safeText(payload.assignedVehicleStationLabel);
      rental.assignedVehicleStationLabel = safeText(payload.assignedVehicleStationLabel);
    }
    if (payload?.assignedVehicleMileage !== undefined) {
      booking.assignedVehicleMileage = safeNum(payload.assignedVehicleMileage);
      rental.assignedVehicleMileage = safeNum(payload.assignedVehicleMileage);
    }
    if (payload?.assignedVehicleFuelLevel !== undefined) {
      booking.assignedVehicleFuelLevel = safeNum(payload.assignedVehicleFuelLevel);
      rental.assignedVehicleFuelLevel = safeNum(payload.assignedVehicleFuelLevel);
    }
    if (payload?.assignedVehicleExcess !== undefined) {
      booking.assignedVehicleExcess = safeNum(payload.assignedVehicleExcess);
      rental.assignedVehicleExcess = safeNum(payload.assignedVehicleExcess);
    }
    if (payload?.assignedCategoryCode !== undefined) {
      booking.assignedCategoryCode = safeText(payload.assignedCategoryCode);
      rental.assignedCategoryCode = safeText(payload.assignedCategoryCode);
    }

    if (payload?.bookingNumber !== undefined) booking.bookingNumber = safeText(payload.bookingNumber);
    if (payload?.bookingStatus !== undefined) booking.status = safeText(payload.bookingStatus) || booking.status;
    if (payload?.customerName !== undefined) booking.customerName = safeText(payload.customerName);
    if (payload?.phone !== undefined) booking.phone = safeText(payload.phone);
    if (payload?.email !== undefined) booking.email = safeText(payload.email);
    if (payload?.category !== undefined) booking.category = safeText(payload.category);
    if (payload?.categoryId !== undefined) booking.categoryId = safeText(payload.categoryId);
    if (payload?.pickupDateTime !== undefined) { const d = asDate(payload.pickupDateTime); if (d) booking.pickupDateTime = d; }
    if (payload?.dropoffDateTime !== undefined) { const d = asDate(payload.dropoffDateTime); if (d) booking.dropoffDateTime = d; }
    if (payload?.flightNumber !== undefined) booking.flightNumber = safeText(payload.flightNumber);
    if (payload?.voucherNumber !== undefined) booking.voucherNumber = safeText(payload.voucherNumber);
    if (payload?.confirmationNumber !== undefined) booking.confirmationNumber = safeText(payload.confirmationNumber);
    if (payload?.originCity !== undefined) booking.originCity = safeText(payload.originCity);
    if (payload?.customerCity !== undefined) booking.customerCity = safeText(payload.customerCity);
    if (payload?.pickupLocationNote !== undefined) booking.pickupLocationNote = safeText(payload.pickupLocationNote);
    if (payload?.dropoffLocationNote !== undefined) booking.dropoffLocationNote = safeText(payload.dropoffLocationNote);
    if (payload?.selectedPackage !== undefined) booking.selectedPackage = safeText(payload.selectedPackage);
    if (payload?.selectedExtras !== undefined) booking.selectedExtras = normalizeSelectedExtras(payload.selectedExtras);
    if (payload?.basePricePerDay !== undefined) booking.basePricePerDay = safeNum(payload.basePricePerDay);
    if (payload?.insuranceExtraPerDay !== undefined) booking.insuranceExtraPerDay = safeNum(payload.insuranceExtraPerDay);

    const drv = normalizeDriversPayload(payload);
    if (drv.mainDriver) rental.mainDriver = drv.mainDriver;
    if (Array.isArray(drv.additionalDrivers)) rental.additionalDrivers = drv.additionalDrivers;

    if (payload?.pickuppoint !== undefined) booking.pickuppoint = safeText(payload.pickuppoint);
    if (payload?.dropoffpoint !== undefined) booking.dropoffpoint = safeText(payload.dropoffpoint);
    if (payload?.pickupComment !== undefined) booking.pickupComment = safeText(payload.pickupComment);
    if (payload?.dropoffComment !== undefined) booking.dropoffComment = safeText(payload.dropoffComment);

    if (payload?.checkoutOdometer !== undefined) rental.checkoutOdometer = safeNum(payload.checkoutOdometer);
    if (payload?.checkinOdometer !== undefined) rental.checkinOdometer = safeNum(payload.checkinOdometer);

    if (payload?.checkoutFuelLevel !== undefined && payload.checkoutFuelLevel !== null) rental.checkoutFuelLevel = clamp(safeNum(payload.checkoutFuelLevel), 1, 8);
    if (payload?.checkinFuelLevel !== undefined && payload.checkinFuelLevel !== null) rental.checkinFuelLevel = clamp(safeNum(payload.checkinFuelLevel), 1, 8);

    if (payload?.checkoutNotes !== undefined) rental.checkoutNotes = safeText(payload.checkoutNotes);
    if (payload?.checkinNotes !== undefined) rental.checkinNotes = safeText(payload.checkinNotes);

    if (payload?.damagesNotes !== undefined) rental.damagesNotes = safeText(payload.damagesNotes);
    if (payload?.photos !== undefined) rental.photos = parsePhotosField(payload.photos);
    if (payload?.internalMemo !== undefined) rental.internalMemo = safeText(payload.internalMemo);

    const pricingOverrideInput = normalizePricingOverridePayload(payload?.pricingOverride);
    const pricingSnapshot = cloneJson(booking.pricingSnapshot || rental.pricingSnapshot || buildPricingSnapshot(booking, rental));

    applyChargesPayload(rental, payload);
    if (payload?.charges && typeof payload.charges === "object") {
      booking.baseCost = safeNum(payload.charges.rental);
      booking.insuranceCost = safeNum(payload.charges.insurance);
      booking.extrasTotal = safeNum(payload.charges.options);
      booking.ageFee = safeNum(payload.charges.ageFee);
      booking.nightFee = safeNum(payload.charges.nightFee);
      booking.totalPrice = Math.round((booking.baseCost + booking.insuranceCost + booking.extrasTotal + booking.ageFee + booking.nightFee + safeNum(payload.charges.transport) + safeNum(payload.charges.damages) + safeNum(payload.charges.surcharges) - safeNum(payload.charges.discount)) * 100) / 100;
      const days = billableDaysFromBooking(booking) || 1;
      booking.basePricePerDay = Math.round(((booking.baseCost / days) || 0) * 100) / 100;
      booking.insuranceExtraPerDay = Math.round(((booking.insuranceCost / days) || 0) * 100) / 100;
    }
    if (payload?.totalPrice !== undefined && !payload?.charges) booking.totalPrice = safeNum(payload.totalPrice);
    applyBillingPayload(rental, payload);
    applyFinancialsPayload(booking, rental, payload);

    const s = safeText(stage).toLowerCase();
    if (s === "checkout") {
      rental.rentalState = "Active Rental";
      booking.rentalState = "Active Rental";
      rental.checkoutAt = rental.checkoutAt || new Date();
    } else if (s === "pre") {
      rental.checkinStage = "Pre Check-In";
      rental.rentalState = "Pre Check-In";
      booking.rentalState = "Pre Check-In";
      rental.precheckinAt = rental.precheckinAt || new Date();
    } else if (s === "final") {
      rental.checkinStage = "Closed Rental";
      rental.rentalState = "Closed Rental";
      booking.rentalState = "Closed Rental";
      rental.checkinAt = rental.checkinAt || new Date();
    }

    const vatRate = (rental.billing && typeof rental.billing === "object")
      ? safeNum(rental.billing.vatRate ?? 0.24)
      : 0.24;

    const ch = syncBookingChargeFields(booking, rental);
    const grossTotal = ch.gross;

    rental.totals = computeVatBreakdown(grossTotal, vatRate);

    booking.pricingSnapshot = cloneJson(pricingSnapshot);
    rental.pricingSnapshot = cloneJson(pricingSnapshot);
    const pricingDrift = computePricingDrift(pricingSnapshot, ch);
    const isAdmin = !!(access?.isAdmin || safeText(access?.roleKey).toLowerCase() === 'admin');
    const specials = Array.isArray(access?.specialPermissions) ? access.specialPermissions : [];
    const canOverridePricing = isAdmin || specials.includes('overridePricing');
    const canApproveManualOverride = isAdmin || specials.includes('approveManualOverride');
    if (pricingOverrideInput.approveNow && !canApproveManualOverride) {
      return { success:false, message:'ACCESS_DENIED: approval requires manual override approval permission.' };
    }
    if (pricingDrift.hasDelta && !canOverridePricing) {
      return { success:false, message:'ACCESS_DENIED: pricing override permission required.' };
    }
    if (pricingDrift.hasDelta) {
      const actorName = safeText(access?.fullName || access?.email || 'Operator');
      const actorEmail = safeText(access?.email || '');
      const status = pricingOverrideInput.approveNow && canApproveManualOverride
        ? 'approved'
        : ((pricingOverrideInput.requestApproval || !canApproveManualOverride) ? 'pendingApproval' : 'override');
      rental.pricingOverride = {
        status,
        reason: pricingOverrideInput.reason,
        note: pricingOverrideInput.note,
        deltaGross: pricingDrift.deltaGross,
        requestedBy: actorName,
        requestedByEmail: actorEmail,
        requestedAt: new Date(),
        approvedBy: status === 'approved' ? actorName : safeText(rental?.pricingOverride?.approvedBy),
        approvedByEmail: status === 'approved' ? actorEmail : safeText(rental?.pricingOverride?.approvedByEmail),
        approvedAt: status === 'approved' ? new Date() : (rental?.pricingOverride?.approvedAt || null)
      };
    } else {
      rental.pricingOverride = {
        status: 'clean',
        reason: pricingOverrideInput.reason || '',
        note: pricingOverrideInput.note || '',
        deltaGross: 0,
        requestedBy: safeText(rental?.pricingOverride?.requestedBy),
        requestedByEmail: safeText(rental?.pricingOverride?.requestedByEmail),
        requestedAt: rental?.pricingOverride?.requestedAt || null,
        approvedBy: safeText(rental?.pricingOverride?.approvedBy),
        approvedByEmail: safeText(rental?.pricingOverride?.approvedByEmail),
        approvedAt: rental?.pricingOverride?.approvedAt || null
      };
    }
    rental.pricingReview = buildPricingReview(booking, rental);

    await wixData.update("RentalsNew", rental, { suppressAuth:true });
    await wixData.update("BookingsNew", booking, { suppressAuth:true });
    await mirrorToBooking(booking, rental);

    // checkout: try PDF/email but NEVER fail the save
    if (s === "checkout") {
      try {
        // lazy-load deps
        const sgMailMod = require("@sendgrid/mail");
        const PDFDocument = require("pdfkit");

        // build pdf
        const pdfBuffer = await new Promise((resolve, reject) => {
          try {
            const doc = new PDFDocument({ size:"A4", margin:42 });
            const chunks = [];
            doc.on("data", c => chunks.push(c));
            doc.on("end", () => resolve(Buffer.concat(chunks)));
            doc.on("error", reject);

            doc.fontSize(18).text("Rental Receipt / Contract");
            doc.moveDown(0.6);
            doc.fontSize(10).text(`Booking: ${safeText(booking.bookingNumber)}`);
            doc.text(`Customer: ${safeText(booking.customerName)}`);
            doc.text(`Email: ${safeText(booking.email)}`);
            doc.text(`Phone: ${safeText(booking.phone)}`);
            doc.moveDown(0.6);
            doc.fontSize(10).text(`Pickup: ${safeText(booking.pickupDateTime)} @ ${pickLabel(booking.pickuppoint)}`);
            doc.text(`Dropoff: ${safeText(booking.dropoffDateTime)} @ ${pickLabel(booking.dropoffpoint)}`);
            doc.moveDown(0.6);
            doc.fontSize(10).text(`Vehicle: ${safeText(booking.assignedVehicleLabel || booking.assignedVehiclePlate || rental.assignedVehicleLabel || "-")}`);
            doc.text(`Gross: ${safeText(rental.totals?.gross)} €  (Net ${safeText(rental.totals?.net)} / VAT ${safeText(rental.totals?.vat)})`);
            doc.end();
          } catch(e){ reject(e); }
        });

        // send
        const apiKey = await getSecret("SENDGRID_API_KEY");
        const fromEmail = await getSecret("FROM_EMAIL");
        const opsEmail = await getSecret("OPS_EMAIL");

        if (!apiKey || !fromEmail || !opsEmail) throw new Error("Missing SendGrid secrets");

        sgMailMod.setApiKey(apiKey);

        const customerEmail = safeText(booking.email).trim();
        const toList = [opsEmail].filter(Boolean);
        if (customerEmail) toList.push(customerEmail);

        const bookingNo = safeText(booking.bookingNumber || booking._id);
        await sgMailMod.send({
          to: toList,
          from: fromEmail,
          subject: `Receipt / Contract • ${bookingNo}`,
          text: `Receipt/Contract for booking ${bookingNo}`,
          attachments: [{
            content: pdfBuffer.toString("base64"),
            filename: `Receipt_${bookingNo}.pdf`,
            type: "application/pdf",
            disposition: "attachment"
          }]
        });
      } catch (e) {
        return { success:true, warning:`Saved but PDF/email failed: ${e?.message || String(e)}`, rentalState:rental.rentalState, totals:rental.totals };
      }
    }

    return { success:true, rentalState:rental.rentalState, checkinStage:rental.checkinStage, totals:rental.totals };
  } catch (e) {
    return { success:false, message: e?.message || String(e) };
  }
}

// legacy (kept)
export async function saveCheckout({ bookingId, payload }) {
  return saveContract({ bookingId, payload, stage:"checkout" });
}
export async function saveCheckin({ bookingId, payload }) {
  return saveContract({ bookingId, payload, stage:"final" });
}
