}

export async function exportContractPdfFromHtml({ authToken, bookingId, documentType = 'agreement' }) {
  const rendered = await exportContractRenderedDocument({ authToken, bookingId, documentType });
  if (!rendered?.success) return rendered;
  try {
    const pdfResult = await renderPdfBufferFromHtmlAdapter(rendered.html || '', {
      title: `${safeText(documentType).toUpperCase()} • ${safeText(rendered?.package?.meta?.bookingNumber || rendered?.package?.meta?.bookingId || '')}`
    });
    return {
      success:true,
      package: rendered.package,
      printable: rendered.printable,
      html: rendered.html,
      pdfBase64: pdfResult.buffer.toString("base64"),
      filename: `${safeText(documentType || 'document')}_${safeText(rendered?.package?.meta?.bookingNumber || rendered?.package?.meta?.bookingId || 'contract')}.pdf`,
      type: "application/pdf",
      renderEngine: pdfResult.engine,
      fidelity: pdfResult.fidelity,
      fallbackUsed: !!pdfResult.fallbackUsed,
      fallbackReason: safeText(pdfResult.fallbackReason || ''),
      attemptedEngines: pdfResult.attemptedEngines || [],
      renderDurationMs: safeNum(pdfResult.durationMs),
      capabilitySnapshot: pdfResult.capabilitySnapshot || getRendererCapabilitySnapshot(),
      renderWarnings: Array.isArray(pdfResult.warnings) ? pdfResult.warnings : []
    };
  } catch (e) {
    return { success:false, message:e?.message || String(e), package: rendered.package, printable: rendered.printable, html: rendered.html };
  }
}


export async function confirmBookingAnalysis({ authToken, bookingId }) {
  await requireStaffAccess({ sessionToken: authToken, area: "rentals", action: "Edit" });
  try {
    if (!bookingId) return { success:false, message:"Missing bookingId" };
    const result = await confirmAndAutoAssign({ authToken, bookingId });
    if (!result?.success) return { success:false, message: result?.message || "Confirm failed" };
    const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
    booking.status = "Confirmed";
    booking.confirmedAt = booking.confirmedAt || new Date();
    booking.statusChangedAt = new Date();
    await wixData.update("BookingsNew", booking, { suppressAuth:true });
    return { success:true, assigned: !!result.assigned, message: result.assigned ? "Booking confirmed & vehicle assigned" : "Booking confirmed" };
  } catch (e) {
    return { success:false, message: e?.message || String(e) };
  }
}

// --------------------
// Legacy start/close (kept)
// --------------------
export async function startRental({ bookingId, by }) {
  if (!bookingId) return { success:false, message:"Missing bookingId" };
  const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
  if (!booking) return { success:false, message:"Booking not found" };

  const rental = await ensureRentalForBooking(booking);
  rental.rentalState = "Active Rental";
  rental.checkoutAt = rental.checkoutAt || new Date();
  rental.checkoutBy = safeText(by || rental.checkoutBy || "");
  await wixData.update("RentalsNew", rental, { suppressAuth:true });

  booking.rentalState = "Active Rental";
  await wixData.update("BookingsNew", booking, { suppressAuth:true });
  await mirrorToBooking(booking, rental);

  return { success:true };
}

export async function closeRental({ bookingId, by }) {
  if (!bookingId) return { success:false, message:"Missing bookingId" };
  const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
  if (!booking) return { success:false, message:"Booking not found" };

  const rental = await ensureRentalForBooking(booking);
  rental.rentalState = "Closed Rental";
  rental.checkinAt = rental.checkinAt || new Date();
  rental.checkinBy = safeText(by || rental.checkinBy || "");
  await wixData.update("RentalsNew", rental, { suppressAuth:true });

  booking.rentalState = "Closed Rental";
  await wixData.update("BookingsNew", booking, { suppressAuth:true });
  await mirrorToBooking(booking, rental);

  return { success:true };
}

// --------------------
// ✅ saveContract (PDF+Email are lazy-loaded)
// --------------------
export async function saveContract({ authToken, bookingId, payload, stage }) {
  const access = await requireStaffAccess({ sessionToken: authToken, area: "rentals", action: "Edit" });
  try {
    if (!bookingId) return { success:false, message:"Missing bookingId" };

    const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth:true });
    if (!booking) return { success:false, message:"Booking not found" };

    const rental = await ensureRentalForBooking(booking);

    if (payload?.assignedVehicle !== undefined) {
      booking.assignedVehicle = safeText(payload.assignedVehicle);
      rental.assignedVehicleId = safeText(payload.assignedVehicle);
    }
    if (payload?.assignedVehicleLabel !== undefined) {
      rental.assignedVehicleLabel = safeText(payload.assignedVehicleLabel);
      booking.assignedVehicleLabel = safeText(payload.assignedVehicleLabel);
    }
    if (payload?.assignedVehiclePlate !== undefined) {
      booking.assignedVehiclePlate = safeText(payload.assignedVehiclePlate);
      rental.assignedVehiclePlate = safeText(payload.assignedVehiclePlate);
    }
    if (payload?.assignedVehicleModel !== undefined) {
      booking.assignedVehicleModel = safeText(payload.assignedVehicleModel);
      rental.assignedVehicleModel = safeText(payload.assignedVehicleModel);
    }
    if (payload?.assignedVehicleStationCode !== undefined) {
      booking.assignedVehicleStationCode = safeText(payload.assignedVehicleStationCode);
      rental.assignedVehicleStationCode = safeText(payload.assignedVehicleStationCode);
    }
    if (payload?.assignedVehicleStationLabel !== undefined) {
      booking.assignedVehicleStationLabel = safeText(payload.assignedVehicleStationLabel);
      rental.assignedVehicleStationLabel = safeText(payload.assignedVehicleStationLabel);
    }
    if (payload?.assignedVehicleMileage !== undefined) {
      booking.assignedVehicleMileage = safeNum(payload.assignedVehicleMileage);
      rental.assignedVehicleMileage = safeNum(payload.assignedVehicleMileage);
    }
    if (payload?.assignedVehicleFuelLevel !== undefined) {
      booking.assignedVehicleFuelLevel = safeNum(payload.assignedVehicleFuelLevel);
      rental.assignedVehicleFuelLevel = safeNum(payload.assignedVehicleFuelLevel);
    }
    if (payload?.assignedVehicleExcess !== undefined) {
      booking.assignedVehicleExcess = safeNum(payload.assignedVehicleExcess);
      rental.assignedVehicleExcess = safeNum(payload.assignedVehicleExcess);
    }
    if (payload?.assignedCategoryCode !== undefined) {
      booking.assignedCategoryCode = safeText(payload.assignedCategoryCode);
      rental.assignedCategoryCode = safeText(payload.assignedCategoryCode);
    }

    if (payload?.bookingNumber !== undefined) booking.bookingNumber = safeText(payload.bookingNumber);
    if (payload?.bookingStatus !== undefined) booking.status = safeText(payload.bookingStatus) || booking.status;
    if (payload?.customerName !== undefined) booking.customerName = safeText(payload.customerName);
    if (payload?.phone !== undefined) booking.phone = safeText(payload.phone);
    if (payload?.email !== undefined) booking.email = safeText(payload.email);
    if (payload?.category !== undefined) booking.category = safeText(payload.category);
    if (payload?.categoryId !== undefined) booking.categoryId = safeText(payload.categoryId);
    if (payload?.pickupDateTime !== undefined) { const d = asDate(payload.pickupDateTime); if (d) booking.pickupDateTime = d; }
    if (payload?.dropoffDateTime !== undefined) { const d = asDate(payload.dropoffDateTime); if (d) booking.dropoffDateTime = d; }
    if (payload?.flightNumber !== undefined) booking.flightNumber = safeText(payload.flightNumber);
    if (payload?.voucherNumber !== undefined) booking.voucherNumber = safeText(payload.voucherNumber);
    if (payload?.confirmationNumber !== undefined) booking.confirmationNumber = safeText(payload.confirmationNumber);
    if (payload?.originCity !== undefined) booking.originCity = safeText(payload.originCity);
    if (payload?.customerCity !== undefined) booking.customerCity = safeText(payload.customerCity);
    if (payload?.pickupLocationNote !== undefined) booking.pickupLocationNote = safeText(payload.pickupLocationNote);
    if (payload?.dropoffLocationNote !== undefined) booking.dropoffLocationNote = safeText(payload.dropoffLocationNote);
    if (payload?.selectedPackage !== undefined) booking.selectedPackage = safeText(payload.selectedPackage);
    if (payload?.selectedExtras !== undefined) booking.selectedExtras = normalizeSelectedExtras(payload.selectedExtras);
    if (payload?.basePricePerDay !== undefined) booking.basePricePerDay = safeNum(payload.basePricePerDay);
    if (payload?.insuranceExtraPerDay !== undefined) booking.insuranceExtraPerDay = safeNum(payload.insuranceExtraPerDay);

    const drv = normalizeDriversPayload(payload);
    if (drv.mainDriver) rental.mainDriver = drv.mainDriver;
    if (Array.isArray(drv.additionalDrivers)) rental.additionalDrivers = drv.additionalDrivers;

    if (payload?.pickuppoint !== undefined) booking.pickuppoint = safeText(payload.pickuppoint);
    if (payload?.dropoffpoint !== undefined) booking.dropoffpoint = safeText(payload.dropoffpoint);
    if (payload?.pickupComment !== undefined) booking.pickupComment = safeText(payload.pickupComment);
    if (payload?.dropoffComment !== undefined) booking.dropoffComment = safeText(payload.dropoffComment);

    if (payload?.checkoutOdometer !== undefined) rental.checkoutOdometer = safeNum(payload.checkoutOdometer);
    if (payload?.checkinOdometer !== undefined) rental.checkinOdometer = safeNum(payload.checkinOdometer);

    if (payload?.checkoutFuelLevel !== undefined && payload.checkoutFuelLevel !== null) rental.checkoutFuelLevel = clamp(safeNum(payload.checkoutFuelLevel), 1, 8);
    if (payload?.checkinFuelLevel !== undefined && payload.checkinFuelLevel !== null) rental.checkinFuelLevel = clamp(safeNum(payload.checkinFuelLevel), 1, 8);

    if (payload?.checkoutNotes !== undefined) rental.checkoutNotes = safeText(payload.checkoutNotes);
    if (payload?.checkinNotes !== undefined) rental.checkinNotes = safeText(payload.checkinNotes);

    if (payload?.damagesNotes !== undefined) rental.damagesNotes = safeText(payload.damagesNotes);
    if (payload?.photos !== undefined) rental.photos = parsePhotosField(payload.photos);
    if (payload?.internalMemo !== undefined) rental.internalMemo = safeText(payload.internalMemo);

    const pricingOverrideInput = normalizePricingOverridePayload(payload?.pricingOverride);
    const pricingSnapshot = cloneJson(booking.pricingSnapshot || rental.pricingSnapshot || buildPricingSnapshot(booking, rental));

    applyChargesPayload(rental, payload);
    if (payload?.charges && typeof payload.charges === "object") {
      booking.baseCost = safeNum(payload.charges.rental);
      booking.insuranceCost = safeNum(payload.charges.insurance);
      booking.extrasTotal = safeNum(payload.charges.options);
      booking.ageFee = safeNum(payload.charges.ageFee);
      booking.nightFee = safeNum(payload.charges.nightFee);
      booking.totalPrice = Math.round((booking.baseCost + booking.insuranceCost + booking.extrasTotal + booking.ageFee + booking.nightFee + safeNum(payload.charges.transport) + safeNum(payload.charges.damages) + safeNum(payload.charges.surcharges) - safeNum(payload.charges.discount)) * 100) / 100;
      const days = billableDaysFromBooking(booking) || 1;
      booking.basePricePerDay = Math.round(((booking.baseCost / days) || 0) * 100) / 100;
      booking.insuranceExtraPerDay = Math.round(((booking.insuranceCost / days) || 0) * 100) / 100;
    }
    if (payload?.totalPrice !== undefined && !payload?.charges) booking.totalPrice = safeNum(payload.totalPrice);
    applyBillingPayload(rental, payload);
    applyFinancialsPayload(booking, rental, payload);
    applyFinancialTransactionsPayload(booking, rental, payload);

    const s = safeText(stage).toLowerCase();
    if (s === "checkout") {
      rental.rentalState = "Active Rental";
      booking.rentalState = "Active Rental";
      rental.checkoutAt = rental.checkoutAt || new Date();
    } else if (s === "pre") {
      rental.checkinStage = "Pre Check-In";
      rental.rentalState = "Pre Check-In";
      booking.rentalState = "Pre Check-In";
      rental.precheckinAt = rental.precheckinAt || new Date();
    } else if (s === "final") {
      rental.checkinStage = "Closed Rental";
      rental.rentalState = "Closed Rental";
      booking.rentalState = "Closed Rental";
      rental.checkinAt = rental.checkinAt || new Date();
    }

    const vatRate = (rental.billing && typeof rental.billing === "object")
      ? safeNum(rental.billing.vatRate ?? 0.24)
      : 0.24;

    const ch = syncBookingChargeFields(booking, rental);
    const grossTotal = ch.gross;
    rental.chargeLines = buildChargeLinesFromCharges(ch, normalizeChargeLinesPayload(payload?.chargeLines || rental.chargeLines || []));
    booking.chargeLines = cloneJson(rental.chargeLines || []);

    rental.totals = computeVatBreakdown(grossTotal, vatRate);
    const financialSnapshot = buildFinancialSnapshot({ booking, rental, totals: ch });
    rental.financialSnapshot = financialSnapshot;
    rental.commercialState = {
      paymentStatus: safeText(payload?.commercialState?.paymentStatus || financialSnapshot?.settlement?.paymentStatus || rental.paymentStatus || 'pending'),
      settlementState: safeText(payload?.commercialState?.settlementState || (safeNum(financialSnapshot?.settlement?.balance) <= 0 ? 'settled' : (safeNum(financialSnapshot?.settlement?.paidTotal) > 0 ? 'partial' : 'open'))),
      outstanding: safeNum(financialSnapshot?.settlement?.balance),
      paidTotal: safeNum(financialSnapshot?.settlement?.paidTotal),
      updatedAt: new Date(),
      notes: safeText(payload?.commercialState?.notes || rental?.commercialState?.notes || '')
    };
    const guardrailOverride = normalizeCheckoutGuardrailOverride(payload?.checkoutGuardrailOverride);
    rental.checkoutGuardrailOverride = guardrailOverride || rental.checkoutGuardrailOverride || null;
    booking.checkoutGuardrailOverride = cloneJson(rental.checkoutGuardrailOverride || null);
    const signatureState = normalizeSignatureState(payload?.signatureState || rental.signatureState || booking.signatureState || {});
    rental.signatureState = signatureState;
    booking.signatureState = cloneJson(signatureState);
    const documentPipeline = buildDocumentPipelineSnapshot({ booking, rental, financialSnapshot });
    rental.documentPipeline = documentPipeline;
    booking.documentPipeline = cloneJson(documentPipeline);
    booking.financialSnapshot = cloneJson(financialSnapshot);
    booking.paymentStatus = financialSnapshot?.settlement?.paymentStatus || booking.paymentStatus;

    booking.pricingSnapshot = cloneJson(pricingSnapshot);
    rental.pricingSnapshot = cloneJson(pricingSnapshot);
    const pricingDrift = computePricingDrift(pricingSnapshot, ch);
    const isAdmin = !!(access?.isAdmin || safeText(access?.roleKey).toLowerCase() === 'admin');
    const specials = Array.isArray(access?.specialPermissions) ? access.specialPermissions : [];
    const canOverridePricing = isAdmin || specials.includes('overridePricing');
    const canApproveManualOverride = isAdmin || specials.includes('approveManualOverride');
    if (pricingOverrideInput.approveNow && !canApproveManualOverride) {
      return { success:false, message:'ACCESS_DENIED: approval requires manual override approval permission.' };
    }
    if (pricingDrift.hasDelta && !canOverridePricing) {
      return { success:false, message:'ACCESS_DENIED: pricing override permission required.' };
    }
    if (pricingDrift.hasDelta) {
      const actorName = safeText(access?.fullName || access?.email || 'Operator');
      const actorEmail = safeText(access?.email || '');
      const status = pricingOverrideInput.approveNow && canApproveManualOverride
        ? 'approved'
        : ((pricingOverrideInput.requestApproval || !canApproveManualOverride) ? 'pendingApproval' : 'override');
      rental.pricingOverride = {
        status,
        reason: pricingOverrideInput.reason,
        note: pricingOverrideInput.note,
        deltaGross: pricingDrift.deltaGross,
        requestedBy: actorName,
        requestedByEmail: actorEmail,
        requestedAt: new Date(),
        approvedBy: status === 'approved' ? actorName : safeText(rental?.pricingOverride?.approvedBy),
        approvedByEmail: status === 'approved' ? actorEmail : safeText(rental?.pricingOverride?.approvedByEmail),
        approvedAt: status === 'approved' ? new Date() : (rental?.pricingOverride?.approvedAt || null)
      };
    } else {
      rental.pricingOverride = {
        status: 'clean',
        reason: pricingOverrideInput.reason || '',
        note: pricingOverrideInput.note || '',
        deltaGross: 0,
        requestedBy: safeText(rental?.pricingOverride?.requestedBy),
        requestedByEmail: safeText(rental?.pricingOverride?.requestedByEmail),
        requestedAt: rental?.pricingOverride?.requestedAt || null,
        approvedBy: safeText(rental?.pricingOverride?.approvedBy),
        approvedByEmail: safeText(rental?.pricingOverride?.approvedByEmail),
        approvedAt: rental?.pricingOverride?.approvedAt || null
      };
    }
    rental.pricingReview = buildPricingReview(booking, rental);

    if (s === "checkout") {
      rental.checkoutFinancialSnapshot = cloneJson(financialSnapshot);
      booking.checkoutFinancialSnapshot = cloneJson(financialSnapshot);
    }

    await wixData.update("RentalsNew", rental, { suppressAuth:true });
    await wixData.update("BookingsNew", booking, { suppressAuth:true });
    await mirrorToBooking(booking, rental);

    let renderDiagnostics = null;
    // checkout: try PDF/email but NEVER fail the save
    if (s === "checkout") {
      try {
        // lazy-load deps
        const sgMailMod = require("@sendgrid/mail");
        const renderMode = safeText(payload?.documentRenderMode || '').toLowerCase();
        const useHtmlRenderer = renderMode === 'html_template';
        const usePdfFromHtml = renderMode === 'pdf_from_html';

        let attachments = [];
        if (useHtmlRenderer || usePdfFromHtml) {
          const documentType = safeText(payload?.documentType || 'receipt').toLowerCase();
          const packageData = buildContractDocumentPackage({ booking, rental, documentType });
          const printable = buildPrintableDocumentModelFromPackage(packageData);
          const html = renderContractDocumentHtmlFromPrintable({ packageData, printable });
          if (usePdfFromHtml) {
            try {
              const pdfResult = await renderPdfBufferFromHtmlAdapter(html, {
                title: `${documentType.toUpperCase()} • ${safeText(booking.bookingNumber || booking._id)}`
              });
              renderDiagnostics = {
                mode: 'pdf_from_html',
                engine: pdfResult.engine,
                fidelity: pdfResult.fidelity,
                fallbackUsed: !!pdfResult.fallbackUsed,
                fallbackReason: safeText(pdfResult.fallbackReason || ''),
                attemptedEngines: pdfResult.attemptedEngines || [],
                durationMs: safeNum(pdfResult.durationMs),
                capabilitySnapshot: pdfResult.capabilitySnapshot || getRendererCapabilitySnapshot()
              };
              attachments = [{
                content: pdfResult.buffer.toString("base64"),
                filename: `${documentType}_${safeText(booking.bookingNumber || booking._id)}.pdf`,
                type: "application/pdf",
                disposition: "attachment"
              }];
            } catch (_) {
              renderDiagnostics = {
                mode: 'pdf_from_html',
                engine: 'legacy_pdfkit_fallback',
                fidelity: 'legacy',
                fallbackUsed: true,
                fallbackReason: 'PDF_FROM_HTML_ADAPTER_FAILED',
                attemptedEngines: ['puppeteer_html_pdf', 'pdfkit_text_fallback', 'legacy_pdfkit'],
                durationMs: 0,
                capabilitySnapshot: getRendererCapabilitySnapshot()
              };
              const PDFDocument = require("pdfkit");
              const pdfBuffer = await new Promise((resolve, reject) => {
                try {
                  const doc = new PDFDocument({ size:"A4", margin:42 });
                  const chunks = [];
                  doc.on("data", c => chunks.push(c));
                  doc.on("end", () => resolve(Buffer.concat(chunks)));
                  doc.on("error", reject);
                  doc.fontSize(18).text("Rental Receipt / Contract");
                  doc.moveDown(0.6);
                  doc.fontSize(10).text(`Booking: ${safeText(booking.bookingNumber)}`);
                  doc.text(`Customer: ${safeText(booking.customerName)}`);
                  doc.text(`Vehicle: ${safeText(booking.assignedVehicleLabel || booking.assignedVehiclePlate || rental.assignedVehicleLabel || "-")}`);
                  doc.end();
                } catch(e){ reject(e); }
              });
              attachments = [{
                content: pdfBuffer.toString("base64"),
                filename: `Receipt_${safeText(booking.bookingNumber || booking._id)}.pdf`,
                type: "application/pdf",
                disposition: "attachment"
              }];
            }
          } else {
            renderDiagnostics = {
              mode: 'html_template',
              engine: 'html_attachment',
              fidelity: 'html',
              fallbackUsed: false,
              fallbackReason: '',
              attemptedEngines: ['html_attachment'],
              durationMs: 0,
              capabilitySnapshot: getRendererCapabilitySnapshot()
            };
            attachments = [{
              content: Buffer.from(html, "utf8").toString("base64"),
              filename: `${documentType}_${safeText(booking.bookingNumber || booking._id)}.html`,
              type: "text/html",
              disposition: "attachment"
            }];
          }
        } else {
          renderDiagnostics = {
            mode: 'legacy_pdfkit',
            engine: 'legacy_pdfkit',
            fidelity: 'legacy',
            fallbackUsed: false,
            fallbackReason: '',
            attemptedEngines: ['legacy_pdfkit'],
            durationMs: 0,
            capabilitySnapshot: getRendererCapabilitySnapshot()
          };
          const PDFDocument = require("pdfkit");
          const pdfBuffer = await new Promise((resolve, reject) => {
            try {
              const doc = new PDFDocument({ size:"A4", margin:42 });
              const chunks = [];
              doc.on("data", c => chunks.push(c));
              doc.on("end", () => resolve(Buffer.concat(chunks)));
              doc.on("error", reject);

              doc.fontSize(18).text("Rental Receipt / Contract");
              doc.moveDown(0.6);
              doc.fontSize(10).text(`Booking: ${safeText(booking.bookingNumber)}`);
              doc.text(`Customer: ${safeText(booking.customerName)}`);
              doc.text(`Email: ${safeText(booking.email)}`);
              doc.text(`Phone: ${safeText(booking.phone)}`);
              doc.moveDown(0.6);
              doc.fontSize(10).text(`Pickup: ${safeText(booking.pickupDateTime)} @ ${pickLabel(booking.pickuppoint)}`);
              doc.text(`Dropoff: ${safeText(booking.dropoffDateTime)} @ ${pickLabel(booking.dropoffpoint)}`);
              doc.moveDown(0.6);
              doc.fontSize(10).text(`Vehicle: ${safeText(booking.assignedVehicleLabel || booking.assignedVehiclePlate || rental.assignedVehicleLabel || "-")}`);
              doc.text(`Gross: ${safeText(rental.totals?.gross)} €  (Net ${safeText(rental.totals?.net)} / VAT ${safeText(rental.totals?.vat)})`);
              doc.end();
            } catch(e){ reject(e); }
          });
          attachments = [{
            content: pdfBuffer.toString("base64"),
            filename: `Receipt_${safeText(booking.bookingNumber || booking._id)}.pdf`,
            type: "application/pdf",
            disposition: "attachment"
          }];
        }

        // send
        const apiKey = await getSecret("SENDGRID_API_KEY");
        const fromEmail = await getSecret("FROM_EMAIL");
        const opsEmail = await getSecret("OPS_EMAIL");

        if (!apiKey || !fromEmail || !opsEmail) throw new Error("Missing SendGrid secrets");

        sgMailMod.setApiKey(apiKey);

        const customerEmail = safeText(booking.email).trim();
        const toList = [opsEmail].filter(Boolean);
        if (customerEmail) toList.push(customerEmail);

        const bookingNo = safeText(booking.bookingNumber || booking._id);
        await sgMailMod.send({
          to: toList,
          from: fromEmail,
          subject: `Receipt / Contract • ${bookingNo}`,
          text: `Receipt/Contract for booking ${bookingNo}`,
          attachments
        });
      } catch (e) {
        return { success:true, warning:`Saved but PDF/email failed: ${e?.message || String(e)}`, rentalState:rental.rentalState, totals:rental.totals, renderDiagnostics };
      }
    }

    return { success:true, rentalState:rental.rentalState, checkinStage:rental.checkinStage, totals:rental.totals, renderDiagnostics };
  } catch (e) {
    return { success:false, message: e?.message || String(e) };
  }
}

// legacy (kept)
export async function saveCheckout({ bookingId, payload }) {
  return saveContract({ bookingId, payload, stage:"checkout" });
}
export async function saveCheckin({ bookingId, payload }) {
  return saveContract({ bookingId, payload, stage:"final" });
}
