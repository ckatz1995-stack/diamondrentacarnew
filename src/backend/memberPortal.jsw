
import wixData from "wix-data";

function clean(v){ return (v === undefined || v === null) ? "" : String(v).trim(); }
function formatMoney(value){ return `${Number(value || 0).toLocaleString('el-GR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}€`; }
function fmtDateTime(value){
  if(!value) return "-";
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return "-";
  return d.toLocaleString("el-GR", { year:"numeric", month:"2-digit", day:"2-digit", hour:"2-digit", minute:"2-digit", hour12:false });
}
function mergeUnique(itemsA = [], itemsB = []){
  const map = new Map();
  [...itemsA, ...itemsB].forEach(item => { if (item && item._id && !map.has(item._id)) map.set(item._id, item); });
  return [...map.values()].sort((a,b) => new Date(b.createdAtApp || b._createdDate || 0) - new Date(a.createdAtApp || a._createdDate || 0));
}
function deriveProfile(item){
  const driver = item?.mainDriver || {};
  const billing = item?.billing || {};
  const fullName = clean(driver.fullName || item.customerName);
  const parts = fullName.split(/\s+/).filter(Boolean);
  const firstName = parts.shift() || "";
  const lastName = parts.join(" ");
  return {
    firstName,
    lastName,
    email: clean(driver.email || item.email),
    phone: clean(driver.phone || item.phone),
    address: clean(driver.address),
    dob: clean(driver.dob),
    country: clean(driver.country),
    originCity: clean(driver.originCity || item.originCity),
    flightNumber: clean(item.flightNumber),
    comments: clean(driver.notes || item.internalMemo),
    invoiceType: clean(billing.invoiceType),
    companyName: clean(billing.companyName),
    profession: clean(billing.profession),
    vatNumber: clean(billing.vatNumber),
    taxOffice: clean(billing.taxOffice),
    billingAddress: clean(billing.address),
    companyCity: clean(billing.city),
    companyZip: clean(billing.zip),
    companyPhone: clean(billing.phone),
    companyEmail: clean(billing.email)
  };
}

export async function getMemberPortalData(email, memberId){
  const safeEmail = clean(email).toLowerCase();
  const safeMemberId = clean(memberId);
  if(!safeEmail && !safeMemberId) return { profile:{}, history:[] };

  let byMember = [];
  let byEmail = [];
  try{
    if (safeMemberId) {
      const res = await wixData.query("BookingsNew").eq("memberId", safeMemberId).descending("createdAtApp").limit(20).find();
      byMember = res.items || [];
    }
  }catch(e){}
  try{
    if (safeMemberId) {
      const res = await wixData.query("BookingsNew").eq("createdBy", safeMemberId).descending("createdAtApp").limit(20).find();
      byMember = mergeUnique(byMember, res.items || []);
    }
  }catch(e){}
  try{
    if (safeEmail) {
      const res = await wixData.query("BookingsNew").eq("email", safeEmail).descending("createdAtApp").limit(20).find();
      byEmail = res.items || [];
    }
  }catch(e){}

  const items = mergeUnique(byMember, byEmail).slice(0, 8);
  const latest = items[0] || null;
  const history = items.map(item => ({
    bookingNumber: clean(item.bookingNumber),
    status: clean(item.status || "Pending"),
    vehicleName: clean(item.category || item.vehicleName || item.vehicleId || "Κράτηση"),
    pickup: fmtDateTime(item.pickupDateTime),
    dropoff: fmtDateTime(item.dropoffDateTime),
    totalPrice: formatMoney(item.totalPrice)
  }));
  return { profile: latest ? deriveProfile(latest) : {}, history };
}
