    function post(type, extra){ try{ window.parent.postMessage(JSON.stringify({ type, ...extra }), '*'); }catch(_){ try{ window.parent.postMessage({ type, ...extra }, '*'); }catch(__){} } }
    function showToast(message, tone){ els.toast.textContent = message || ''; els.toast.style.background = tone === 'error' ? '#7f1d1d' : (tone === 'success' ? '#065f46' : '#0f172a'); els.toast.classList.add('show'); clearTimeout(showToast._t); showToast._t = setTimeout(() => els.toast.classList.remove('show'), 3600); }
    function requestResize(){ const h = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight, 1200); post('resize', { height: h }); }

    function tableLayoutFor(key){
      if(!state.tableLayouts) state.tableLayouts = {};
      if(!state.tableLayouts[key]) state.tableLayouts[key] = { order: [], widths: {}, hidden: [], sort: { originalIndex:'', direction:'' } };
      if(!state.tableLayouts[key].sort) state.tableLayouts[key].sort = { originalIndex:'', direction:'' };
      return state.tableLayouts[key];
    }
    function normalizeColumnOrder(order, count){
      const max = Math.max(0, Number(count) || 0);
      const seen = new Set();
      const next = [];
      (Array.isArray(order) ? order : []).forEach((value) => {
        const num = Number(value);
        if(Number.isInteger(num) && num >= 0 && num < max && !seen.has(num)){
          seen.add(num);
          next.push(num);
        }
      });
      for(let i = 0; i < max; i += 1){ if(!seen.has(i)) next.push(i); }
      return next;
    }
    function normalizeHiddenColumns(hidden, count){
      const max = Math.max(0, Number(count) || 0);
      const seen = new Set();
