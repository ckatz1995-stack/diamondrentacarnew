<!DOCTYPE html>
<html lang="el">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Account Settings</title>
  <style>
    :root{
      --bg:#f5f7fb;
      --card:#fff;
      --line:#d9e1ec;
      --text:#16324f;
      --muted:#6f8096;
      --accent:#8e6d3d;
      --accent-soft:#f7f0e5;
      --good:#0f766e;
      --danger:#b42318;
      --warn:#a16207;
      --shadow:0 12px 24px rgba(15,23,42,.06);
      --radius:18px;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;background:var(--bg);font:14px/1.4 Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--text)}
    button,input,select,textarea{font:inherit}
    .wrap{max-width:none;width:100%;margin:0;padding:0 20px 20px}
    .backroom-header{display:grid;grid-template-columns:minmax(300px,340px) minmax(420px,1fr) auto;gap:0;align-items:stretch;width:100%;background:linear-gradient(135deg,#4b3923 0%,#6c522e 55%,#8e6d3d 100%);border:1px solid rgba(255,255,255,.05);border-radius:0 0 24px 24px;box-shadow:0 22px 48px rgba(15,23,42,.16);padding:0;margin:0 0 16px;overflow:visible;position:relative}
    .backroom-header::after{content:"";position:absolute;left:24px;right:24px;bottom:-10px;height:22px;background:radial-gradient(ellipse at center, rgba(15,23,42,.14), rgba(15,23,42,0) 72%);pointer-events:none;filter:blur(10px)}
    .backroom-brand{display:flex;flex-direction:column;justify-content:center;gap:4px;min-height:82px;padding:14px 18px 14px 78px;position:relative;background:linear-gradient(135deg,#8e6d3d 0%,#a8844a 62%,#6c522e 100%);color:#fff}
    .backroom-brand::before{content:"D";position:absolute;left:20px;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:14px;background:rgba(255,255,255,.16);display:grid;place-items:center;font-size:20px;font-weight:900;letter-spacing:-.03em;box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 8px 18px rgba(0,0,0,.12)}
    .backroom-brand::after{content:"";position:absolute;right:-28px;top:-24px;bottom:-24px;width:74px;background:linear-gradient(120deg,rgba(255,255,255,.18),rgba(255,255,255,0));transform:skewX(-18deg)}
    .backroom-brand b{display:block;font-size:20px;letter-spacing:-.02em;color:#fff}
    .backroom-brand span{display:block;color:rgba(255,255,255,.82);font-size:12px;margin-top:2px}
    .backroom-nav{display:flex;flex-wrap:nowrap;align-items:center;justify-content:center;gap:4px;padding:0 18px;background:linear-gradient(180deg,rgba(255,255,255,.03) 0%,rgba(255,255,255,0) 100%);min-width:0;overflow:auto;scrollbar-width:none}.backroom-nav::-webkit-scrollbar{display:none}
    .nav-btn{appearance:none;border:0;background:transparent;color:rgba(255,255,255,.82);padding:0 14px;height:82px;font-weight:800;font-size:14px;cursor:pointer;position:relative;transition:background .18s ease,color .18s ease,transform .18s ease;border-radius:16px;flex:0 0 auto;white-space:nowrap}
    .nav-btn::after{content:"";position:absolute;left:16px;right:16px;bottom:10px;height:3px;border-radius:999px;background:transparent;transition:background .18s ease,transform .18s ease}
    .nav-btn:hover{background:rgba(255,255,255,.06);color:#fff;transform:translateY(-1px)}
    .nav-btn.active{background:linear-gradient(180deg,rgba(255,255,255,.08) 0%,rgba(255,255,255,.03) 100%);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.08)}
    .nav-btn.active::after{background:#d7b27a}
    .nav-btn.locked{opacity:.48}
    .backroom-user{display:flex;justify-content:flex-end;gap:10px;align-items:center;flex-wrap:nowrap;padding:12px 16px;background:linear-gradient(180deg,rgba(79,58,34,.92) 0%,rgba(58,42,24,.98) 100%);border-left:1px solid rgba(255,255,255,.06);position:relative;min-width:430px;overflow:visible}
    .backroom-user::before{content:"";position:absolute;left:-1px;top:14px;bottom:14px;width:1px;background:rgba(255,255,255,.08)}
    .backroom-search{display:flex;align-items:center;min-width:200px;max-width:280px;flex:0 1 260px;height:44px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 8px 18px rgba(0,0,0,.08)}
    .backroom-search input{flex:1;min-width:0;height:100%;border:0;background:transparent;color:#fff;padding:0 14px;font:700 13px/1.2 Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
    .backroom-search input::placeholder{color:rgba(255,255,255,.58)}
    .backroom-search input:focus{outline:none}
    .backroom-search button{appearance:none;border:0;border-left:1px solid rgba(255,255,255,.1);background:transparent;color:#fff;height:100%;padding:0 14px;font-weight:800;cursor:pointer}
    .backroom-search button:hover{background:rgba(255,255,255,.08)}
    .top-chip{padding:8px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);font-size:12px;color:rgba(255,255,255,.72);flex:0 0 auto;max-width:84px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .top-chip strong{color:#fff}
    .header-action-btn{appearance:none;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);color:#fff;border-radius:12px;padding:10px 12px;font-weight:800;cursor:pointer;transition:background .18s ease,border-color .18s ease,transform .18s ease;flex:0 0 auto;white-space:nowrap}
    .header-action-btn:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.22);transform:translateY(-1px)}
    .quick-apps{position:relative}
    .quick-apps-btn{appearance:none;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);color:#fff;border-radius:14px;padding:10px 12px;font-weight:800;cursor:pointer;transition:background .18s ease,border-color .18s ease,transform .18s ease;display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
    .quick-apps-btn:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.22);transform:translateY(-1px)}
    .quick-apps-btn::before{content:"☰";font-size:13px;line-height:1}
    .quick-apps-panel{position:absolute;top:calc(100% + 12px);right:0;left:auto;min-width:420px;display:none;padding:14px;background:#3f2e1e;border:1px solid rgba(255,255,255,.08);border-radius:20px;box-shadow:0 22px 44px rgba(15,23,42,.28);z-index:40}
    .quick-apps.open .quick-apps-panel{display:block}
    .quick-apps-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    .quick-app-card{appearance:none;border:1px solid rgba(255,255,255,.08);background:linear-gradient(180deg,#5b4328 0%,#46311d 100%);color:#fff;border-radius:16px;padding:14px;display:flex;flex-direction:column;align-items:flex-start;gap:8px;cursor:pointer;min-height:104px;transition:transform .18s ease,border-color .18s ease,background .18s ease}
    .quick-app-card:hover{transform:translateY(-2px);border-color:rgba(180,138,79,.48);background:linear-gradient(180deg,#71522f 0%,#4c3720 100%)}
    .quick-app-card b{font-size:14px}
    .quick-app-card span{font-size:12px;line-height:1.4;color:rgba(255,255,255,.7);text-align:left}
    .quick-app-icon{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:rgba(255,255,255,.08);font-size:15px}
    .top-icon-group{display:flex;align-items:center;gap:8px;flex:0 0 auto}
    .top-icon-btn{appearance:none;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);color:#fff;border-radius:12px;padding:10px 11px;display:grid;place-items:center;cursor:pointer;transition:background .18s ease,border-color .18s ease,transform .18s ease}
    .top-icon-btn:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.22);transform:translateY(-1px)}
    .top-icon-btn .dot{width:8px;height:8px;border-radius:999px;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.18)}
    .hero{display:grid;grid-template-columns:1.6fr 1fr;gap:16px;margin-bottom:16px}
    .panel{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
    .hero-main{padding:18px 20px}
    .hero-side{padding:18px 20px;display:flex;flex-direction:column;gap:10px}
    .eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700}
    h1{margin:6px 0 10px;font-size:28px;line-height:1.1}
    .sub{color:var(--muted);max-width:900px}
    .kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:16px}
    .kpi{background:#fff;border:1px solid #eadfce;border-radius:16px;padding:10px 12px;min-height:74px}
    .kpi b{display:block;font-size:18px;margin-bottom:2px;letter-spacing:-.02em}
    .kpi span{color:var(--muted);font-size:12px;line-height:1.35}
    .mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .mini{border:1px solid var(--line);border-radius:14px;padding:12px;background:#fbfdff}
    .mini .label{font-size:12px;color:var(--muted);margin-bottom:3px}
    .mini .value{font-weight:700}
    .tabs{margin:0}
    .settings-nav-shell{display:grid;gap:10px;padding:12px 14px;background:linear-gradient(180deg,#ffffff 0%,#fbf8f3 100%);border:1px solid var(--line);border-radius:22px;box-shadow:0 14px 26px rgba(15,23,42,.06)}
    .settings-nav-topline{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-bottom:4px;border-bottom:1px solid #eadfce}
    .settings-context{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .settings-context-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;background:#6c522e;color:#fff;font-size:12px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;box-shadow:0 8px 18px rgba(13,47,98,.16)}
    .settings-context-badge::before{content:"⚙";font-size:13px}
    .settings-context-copy{display:flex;flex-direction:column;gap:2px}
    .settings-context-copy strong{font-size:14px;letter-spacing:-.01em}
    .settings-context-copy span{color:var(--muted);font-size:12px}
    .settings-nav-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .group-rail{display:flex;gap:8px;overflow:auto;padding-bottom:2px;scrollbar-width:thin;align-items:center;background:linear-gradient(180deg,#fbf8f3 0%,#f7f1e8 100%);border:1px solid #eee3d2;border-radius:999px;padding:6px 8px}
    .group-pill{padding:8px 14px;border-radius:999px;border:1px solid transparent;background:transparent;color:#7b6a56;cursor:pointer;font-weight:800;font-size:12px;white-space:nowrap;transition:all .18s ease}
    .group-pill.active{background:#fff;border-color:#d9c3a2;color:var(--accent);box-shadow:0 6px 14px rgba(142,109,61,.10)}
    .section-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:space-between}
    .section-rail{display:flex;gap:8px;overflow:auto;flex:1 1 720px;padding-bottom:2px;scrollbar-width:thin;min-height:42px}
    .tab{padding:9px 12px;border-radius:999px;border:1px solid #e6dbc9;background:#fff;color:var(--text);cursor:pointer;font-weight:700;font-size:12px;white-space:nowrap;transition:all .18s ease}
    .tab.active{background:linear-gradient(180deg,#a8844a 0%,#8e6d3d 100%);border-color:#8e6d3d;color:#fff;box-shadow:0 8px 16px rgba(142,109,61,.18)}
    .tab-picker{position:relative;flex:0 0 auto}
    .picker-trigger{padding:9px 13px;border-radius:999px;border:1px solid #e6dbc9;background:#fff;color:var(--text);cursor:pointer;font-weight:700;font-size:12px;white-space:nowrap;box-shadow:0 4px 10px rgba(15,23,42,.03)}
    .picker-menu{position:absolute;right:0;top:calc(100% + 8px);min-width:300px;max-width:min(92vw,380px);max-height:62vh;overflow:auto;display:none;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 18px 36px rgba(15,23,42,.12);padding:10px;z-index:20}
    .picker-menu.open{display:block}
    .picker-section{display:grid;gap:8px;padding:8px 0}
    .picker-section + .picker-section{border-top:1px solid #eef2f7}
    .picker-label{font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:0 4px}
    .picker-items{display:flex;flex-wrap:wrap;gap:8px}
    .section{display:none}
    .section.active{display:block}
    .section-card{padding:18px 18px 16px}
    .section-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px}
    .section-head h2{margin:0;font-size:22px;letter-spacing:-.02em}
    .section-head p{margin:4px 0 0;color:var(--muted)}
    .section.active .section-card{border-top-left-radius:0;border-top-right-radius:0;border-top:0}
    .section.active .section-head > div:first-child{display:none}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .btn{appearance:none;border:1px solid var(--line);background:#fff;color:var(--text);border-radius:12px;padding:10px 14px;font-weight:700;cursor:pointer}
    .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
    .btn.good{background:var(--good);border-color:var(--good);color:#fff}
    .btn.warn{background:#fff7ed;border-color:#fed7aa;color:var(--warn)}
    .btn.danger{background:#fff1f2;border-color:#fecdd3;color:var(--danger)}
    .btn:disabled{opacity:.55;cursor:not-allowed}
    .grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}
    .field{display:flex;flex-direction:column;gap:6px}
    .field label{font-size:12px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.03em}
    .field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--line);background:linear-gradient(180deg,#ffffff 0%,#fcfdff 100%);border-radius:14px;color:var(--text);box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 1px 2px rgba(15,23,42,.02)}
    .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:#e2cda6;box-shadow:0 0 0 4px rgba(180,138,79,.10),inset 0 1px 0 rgba(255,255,255,.8)}
    .field textarea{min-height:92px;resize:vertical}
    .col-3{grid-column:span 3}.col-4{grid-column:span 4}.col-5{grid-column:span 5}.col-6{grid-column:span 6}.col-8{grid-column:span 8}.col-12{grid-column:span 12}
    .switch{display:flex;align-items:center;gap:10px;padding-top:28px}
    .switch input{width:18px;height:18px}
    .table-shell{display:flex;flex-direction:column;gap:10px}
    .table-toolbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 12px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,#ffffff 0%,#fbf8f3 100%)}
    .table-toolbar-left{display:flex;align-items:center;gap:8px;flex-wrap:wrap;min-width:0}
    .table-toolbar-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .table-toolbar-title{font-size:12px;font-weight:900;color:#0f172a;letter-spacing:.02em}
    .table-toolbar-sub{font-size:11px;color:#64748b;font-weight:700}
    .table-col-btn{appearance:none;border:1px solid rgba(15,23,42,.10);background:#fff;border-radius:12px;padding:8px 12px;font:900 12px/1 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#334155;cursor:pointer;box-shadow:0 8px 18px rgba(15,23,42,.04)}
    .table-col-btn:hover{border-color:rgba(168,132,74,.25);color:#8e6d3d;background:#f7f0e5}
    .table-col-btn.active{background:#f1e4cf;border-color:#d7b27a;color:#8e6d3d}
    .table-col-menu{position:relative}
    .table-col-panel{position:absolute;right:0;top:calc(100% + 8px);z-index:30;width:min(360px,calc(100vw - 40px));border:1px solid rgba(15,23,42,.12);border-radius:18px;background:#fff;box-shadow:0 18px 40px rgba(15,23,42,.14);display:none;overflow:hidden}
    .table-col-menu.open .table-col-panel{display:block}
    .table-col-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:12px 12px 8px;border-bottom:1px solid #eef2f7;background:linear-gradient(180deg,#ffffff 0%,#fbf8f3 100%)}
    .table-col-head strong{display:block;font-size:12px;line-height:1.2;color:#0f172a}
    .table-col-head span{display:block;margin-top:4px;font-size:11px;line-height:1.35;color:#64748b}
    .table-col-search{padding:10px 12px;border-bottom:1px solid #eef2f7;background:#fff}
    .table-col-search input{width:100%;height:38px;border:1px solid rgba(15,23,42,.10);border-radius:12px;padding:0 12px;font:700 13px/1 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#334155;background:#fff}
    .table-col-search input:focus{outline:none;border-color:#d7b27a;box-shadow:0 0 0 4px rgba(180,138,79,.14)}
    .table-col-list{max-height:340px;overflow:auto;padding:8px;background:#fbfdff}
    .table-col-item{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding:8px 10px;border:1px solid rgba(15,23,42,.08);border-radius:12px;background:#fff;margin-bottom:8px;cursor:grab;user-select:none}
    .table-col-item:last-child{margin-bottom:0}
    .table-col-item.dragging{opacity:.45}
    .table-col-item.drag-over{outline:2px dashed #d7b27a;outline-offset:-4px}
    .table-col-item.drag-over-after{outline:2px dashed #b48a4f;outline-offset:-4px;box-shadow:inset 0 -3px 0 #b48a4f}
    .table-col-check{display:flex;align-items:center;gap:8px;min-width:0}
    .table-col-check input{width:15px;height:15px;flex:0 0 auto}
    .table-col-label{display:flex;align-items:center;gap:8px;min-width:0;font-size:12px;font-weight:800;color:#334155}
    .table-col-label span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .table-col-handle{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:999px;border:1px dashed rgba(15,23,42,.12);font-size:10px;color:#94a3b8;line-height:1;background:#fff;flex:0 0 auto}
    .table-col-order{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 7px;border-radius:999px;background:#f7f0e5;color:#8e6d3d;font-size:11px;font-weight:900}
    .table-col-empty{padding:12px;border:1px dashed rgba(15,23,42,.12);border-radius:12px;background:#fff;font-size:12px;font-weight:700;color:#64748b;text-align:center}
    .table-col-note{padding:10px 12px;border-top:1px solid #eef2f7;font-size:11px;color:#64748b;font-weight:700;background:#fff}
    .table-wrap{overflow:auto;border:1px solid var(--line);border-radius:16px;background:#fff}
    table{width:100%;border-collapse:collapse;min-width:900px}
    th,td{padding:12px 10px;border-bottom:1px solid #eef2f7;text-align:left;vertical-align:top}
    th{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;background:#fbfdff}
    .table-wrap table.is-enhanced th{position:relative;user-select:none;background:#fbf8f3;touch-action:none}
    .table-wrap table.is-enhanced th.drag-over{outline:2px dashed #d7b27a;outline-offset:-4px;box-shadow:inset 3px 0 0 #d7b27a}
    .table-wrap table.is-enhanced th.drag-over-after{outline:2px dashed #b48a4f;outline-offset:-4px;box-shadow:inset -3px 0 0 #b48a4f}
    .table-wrap table.is-enhanced th.dragging{opacity:.46}
    .th-inner{display:flex;align-items:center;justify-content:space-between;gap:10px;min-width:0}
    .th-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .th-tools{display:flex;align-items:center;gap:8px;flex:0 0 auto}
    .th-drag{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:999px;border:1px dashed rgba(15,23,42,.12);font-size:10px;color:#94a3b8;cursor:grab;line-height:1;background:#fff}
    .th-sort{display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;border-radius:999px;border:1px solid rgba(15,23,42,.08);font-size:10px;color:#94a3b8;line-height:1;background:#fff;padding:0 5px;cursor:pointer}
    .th-sort.active{color:var(--accent);border-color:#e8d4b6;background:#fbf6ee}
    .th-sort::before{content:'↕'}
    .th-sort[data-dir="asc"]::before{content:'↑'}
    .th-sort[data-dir="desc"]::before{content:'↓'}
    .th-resizer{position:absolute;top:0;right:-4px;width:8px;height:100%;cursor:col-resize;touch-action:none}
    .th-resizer::after{content:'';position:absolute;top:20%;bottom:20%;left:3px;width:2px;border-radius:999px;background:#d5deeb}
    .table-wrap table.is-enhanced th:last-child .th-resizer{display:none}
    body.is-table-resizing,body.is-table-resizing *{cursor:col-resize!important}
    tbody tr:hover{background:#fbfdff}
    .badge{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid var(--line);background:#fff}
    .badge.good{color:var(--good);background:#ecfdf3;border-color:#abefc6}
    .badge.off{color:#667085;background:#f8fafc;border-color:#e2e8f0}
    .badge.private{color:#7c2d12;background:#fff7ed;border-color:#fed7aa}
    .toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
    .toolbar .left,.toolbar .right{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .toolbar input,.toolbar select{padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:#fff}
    .row-actions{display:flex;gap:8px;flex-wrap:wrap}
    .row-actions .link{background:none;border:0;color:var(--accent);padding:0;cursor:pointer;font-weight:700}
    .statusbar{position:sticky;bottom:14px;display:flex;justify-content:flex-end;margin-top:16px;pointer-events:none}
    .toast{pointer-events:auto;min-width:320px;max-width:520px;background:#0f172a;color:#fff;padding:12px 14px;border-radius:14px;box-shadow:0 18px 32px rgba(15,23,42,.18);display:none}
    .toast.show{display:block}
    .overlay{position:fixed;inset:0;background:rgba(15,23,42,.42);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}
    .overlay.show{display:flex}
    .modal{width:min(860px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:22px;border:1px solid var(--line);box-shadow:0 30px 60px rgba(15,23,42,.18)}
    .modal-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:18px 20px;border-bottom:1px solid var(--line)}
    .modal-head h3{margin:0;font-size:22px}
    .modal-head p{margin:4px 0 0;color:var(--muted)}
    .modal-body{padding:18px 20px}
    .modal-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:18px 20px;border-top:1px solid var(--line);position:sticky;bottom:0;background:#fff}
    .viewer-stack{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .viewer-card{border:1px solid var(--line);border-radius:14px;background:#fbfdff;padding:12px}
    .viewer-card h4{margin:0 0 8px;font-size:14px}
    .codebox{margin:0;padding:12px;border-radius:12px;background:#0f172a;color:#e2e8f0;white-space:pre-wrap;word-break:break-word;max-height:320px;overflow:auto;font:12px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace}
    .kv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .pill-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
    .pill{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;border:1px solid var(--line);background:#fff;font-size:12px;font-weight:700}
    .pill.good{background:#ecfdf3;border-color:#bbf7d0;color:#166534}.pill.warn{background:#fff7ed;border-color:#fed7aa;color:#9a3412}.pill.off{background:#f8fafc;border-color:#e2e8f0;color:#475569}
    .empty{padding:20px;border:1px dashed var(--line);border-radius:16px;background:#fbfdff;color:var(--muted);text-align:center}
    .footnote{color:var(--muted);font-size:12px;margin-top:10px}
    .hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    .health-list{display:grid;gap:8px;margin-top:10px}
    .health-item{display:flex;justify-content:space-between;gap:12px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:#fbfdff}
    .health-item b{display:block;font-size:13px;margin-bottom:2px}
    .health-item span{color:var(--muted);font-size:12px}
    .health-item.warn{border-color:#fed7aa;background:#fff7ed}
    .settings-stack{display:grid;gap:16px}
    .settings-group{border:1px solid var(--line);border-radius:18px;background:#fbfdff;padding:16px}
    .settings-group + .settings-group{margin-top:0}
    .settings-group-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}
    .settings-group-head h3{margin:0;font-size:16px}
    .settings-group-head p{margin:4px 0 0;color:var(--muted);font-size:13px;max-width:760px}
    .settings-group-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;border:1px solid var(--line);background:#fff;font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
    .settings-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}
    .field.compact textarea{min-height:72px}
    .group-note{margin-top:10px;color:var(--muted);font-size:12px}

    .settings-home-card{border:1px solid #eadfce;border-radius:18px;background:linear-gradient(180deg,#fbfdff 0%,#fbf8f3 100%);padding:12px 13px;box-shadow:0 6px 14px rgba(15,23,42,.03)}
    .settings-home-card h3{margin:0 0 4px;font-size:15px;letter-spacing:-.01em}
    .settings-home-card p{margin:0;color:var(--muted);font-size:12px;line-height:1.35}
    .settings-home-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px}
    .settings-home-item{border:1px solid #eadfce;border-radius:16px;background:#fff;padding:10px 11px}
    .settings-home-item b{display:block;font-size:13px;margin-bottom:2px}
    .settings-home-item span{display:block;color:var(--muted);font-size:12px;min-height:28px}
    .settings-home-item .actions{margin-top:8px}.settings-home-item .btn{padding:8px 11px;border-radius:10px}
    .summary-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:10px}
    .summary-chip{border:1px solid #eadfce;border-radius:16px;background:#fff;padding:10px 12px;min-height:72px}
    .summary-chip .label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
    .summary-chip .value{font-size:14px;font-weight:800}
    .summary-chip .hint{font-size:11px;color:var(--muted);margin-top:2px}
    .quick-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
    .quick-actions .btn{padding:9px 12px}
    .business-jumps{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
    .jump-btn{border:1px solid var(--line);background:#fff;color:var(--text);padding:9px 12px;border-radius:999px;font-weight:700;cursor:pointer}
    .jump-btn:hover{border-color:#d8c2a0;color:var(--accent);background:var(--accent-soft)}
    .hero-side-card{border:1px solid #eadfce;border-radius:16px;background:#fbfdff;padding:12px}
    .hero-side-card h4{margin:0 0 8px;font-size:14px}
    .access-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .overview-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:14px;align-items:start}
    .overview-grid-secondary{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}
    .overview-card{border:1px solid #eadfce;border-radius:22px;background:linear-gradient(180deg,#ffffff 0%,#f9fbff 100%);padding:16px;box-shadow:0 10px 24px rgba(15,23,42,.04)}
    .overview-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:8px}
    .overview-card h3{margin:0;font-size:18px;letter-spacing:-.02em}
    .overview-card p{margin:4px 0 0;color:var(--muted);font-size:12px;line-height:1.45}
    .overview-primary{background:linear-gradient(180deg,#fbfdff 0%,#f4f8ff 100%)}
    .overview-status{display:grid;gap:12px}
    .overview-shortcuts{display:grid;gap:12px}
    .overview-status-panels{display:grid;gap:12px}
    .status-panel{border:1px solid #eadfce;border-radius:18px;background:#fff;padding:12px}
    .status-panel h4{margin:0 0 6px;font-size:15px}
    .status-panel p{margin:0;color:var(--muted);font-size:12px}
    .access-summary-shell{border:1px solid #eadfce;border-radius:18px;background:#fbfdff;padding:12px}
    .quick-focus-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
    .micro-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}
    .micro-card{border:1px solid #eadfce;border-radius:14px;background:#fff;padding:10px 11px}
    .micro-card .label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
    .micro-card .value{font-size:14px;font-weight:800}
    .nav-shell-helper{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:2px}
    .nav-shell-helper span{color:var(--muted);font-size:11px}

    .settings-command-deck{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:0 0 16px}
    .settings-command-card{position:relative;overflow:hidden;border:1px solid #eadfce;border-radius:20px;background:linear-gradient(180deg,#ffffff 0%,#fbf8f3 100%);padding:14px 15px;box-shadow:0 10px 22px rgba(15,23,42,.04)}
    .settings-command-card::after{content:"";position:absolute;right:-18px;top:-18px;width:92px;height:92px;border-radius:999px;background:radial-gradient(circle,rgba(180,138,79,.14),rgba(180,138,79,0));pointer-events:none}
    .settings-command-kicker{font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#8e6d3d;margin-bottom:6px}
    .settings-command-title{font-size:17px;font-weight:950;letter-spacing:-.02em;color:#2f2418;margin:0 0 6px}
    .settings-command-copy{font-size:12px;line-height:1.5;color:var(--muted);margin:0 0 10px}
    .settings-command-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
    .settings-command-pills .pill{background:#fffaf2;border-color:#e7d3b0;color:#6c522e;font-size:11px;padding:6px 9px}
    .settings-command-actions{display:flex;flex-wrap:wrap;gap:8px}
    .settings-command-actions .btn{padding:8px 11px;border-radius:11px;font-size:12px;font-weight:800}

    .business-shell{display:grid;gap:14px}
    .business-pane-shell{border:1px solid #eadfce;border-radius:20px;background:linear-gradient(180deg,#ffffff 0%,#fbfdff 100%);padding:12px;box-shadow:0 8px 18px rgba(15,23,42,.04)}
    .business-subtabs{display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:10px}
    .business-subtabs-left{display:flex;gap:8px;overflow:auto;scrollbar-width:thin;flex:1 1 720px;padding-bottom:2px}
    .business-subtab{padding:10px 13px;border-radius:999px;border:1px solid #e6dbc9;background:#fff;color:#6c522e;cursor:pointer;font-weight:800;font-size:12px;white-space:nowrap;transition:all .18s ease;box-shadow:0 3px 8px rgba(15,23,42,.03)}
    .business-subtab.active{background:linear-gradient(180deg,#a8844a 0%,#8e6d3d 100%);border-color:#8e6d3d;color:#fff;box-shadow:0 10px 18px rgba(142,109,61,.16)}
    .business-subtab-picker{position:relative;flex:0 0 auto}
    .business-subtab-trigger{padding:10px 13px;border-radius:999px;border:1px solid #e6dbc9;background:#fff;color:var(--text);cursor:pointer;font-weight:700;font-size:12px;white-space:nowrap}
    .business-subtab-menu{position:absolute;right:0;top:calc(100% + 8px);min-width:320px;max-width:min(92vw,420px);max-height:65vh;overflow:auto;display:none;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 18px 36px rgba(15,23,42,.12);padding:10px;z-index:35}
    .business-subtab-menu.open{display:block}
    .business-subtab-menu .picker-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .business-subtab-note{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:8px 12px;border:1px solid #eee3d2;border-radius:14px;background:#fbf8f3;color:var(--muted);font-size:12px;margin-bottom:12px}
    .business-pane{display:none}
    .business-pane.active{display:block}
    .embedded-manager{display:grid;gap:12px;margin-top:14px;padding-top:14px;border-top:1px solid #e6edf8}
    .embedded-manager-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
    .embedded-manager-head h4{margin:0;font-size:15px}
    .embedded-manager-head p{margin:4px 0 0;color:var(--muted);font-size:12px;max-width:760px}
    .embedded-manager .toolbar{margin-bottom:0}
    .embedded-manager .toolbar input,.embedded-manager .toolbar select{background:#fff}
    .embedded-manager-note{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:10px 12px;border:1px solid #eadfce;border-radius:14px;background:#fbf8f3;color:var(--muted);font-size:12px}
    .embedded-manager-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .inline-callout{border:1px solid #eadfce;border-radius:16px;background:#fff;padding:12px 13px}
    .inline-callout h4{margin:0 0 6px;font-size:14px}
    .inline-callout p{margin:0;color:var(--muted);font-size:12px;line-height:1.45}
    .info-card{border:1px dashed #eadfce;border-radius:14px;background:#fbf8f3;padding:12px 13px;color:var(--muted);font-size:12px;line-height:1.45}
    .field-toolbar{display:flex;justify-content:flex-end;gap:8px;margin-top:6px}
    .field-toolbar .mini-btn{padding:7px 10px;border-radius:10px;border:1px solid #e6dbc9;background:#fff;color:var(--text);font-size:11px;font-weight:800;cursor:pointer}
    .field-toolbar .mini-btn:hover{background:#fbf6ee;border-color:#e2cda6;color:var(--accent)}
    .field textarea[data-editor='modal']{display:none}
    .rich-preview{min-height:84px;padding:11px 12px;border:1px solid var(--line);background:#fff;border-radius:12px;color:var(--text);cursor:pointer;white-space:pre-wrap;line-height:1.45}
    .rich-preview.is-empty{color:#8b9ab0}
    .rich-preview:hover{border-color:#e2cda6;box-shadow:0 0 0 3px rgba(142,109,61,.08)}
    .text-editor-tools{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
    .text-editor-tools .mini-btn{padding:8px 11px;border-radius:10px;border:1px solid #e6dbc9;background:#fff;color:var(--text);font-size:12px;font-weight:800;cursor:pointer}
    .text-editor-tools .mini-btn:hover{background:#fbf6ee;border-color:#e2cda6;color:var(--accent)}
    .text-editor-textarea{width:100%;min-height:320px;padding:12px;border:1px solid var(--line);border-radius:14px;resize:vertical;font:inherit;line-height:1.5}
    .text-editor-meta{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:10px;color:var(--muted);font-size:12px}
    
    .patternStrip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 16px}
    .patternCard{position:relative;overflow:hidden;border:1px solid #eadfce;border-radius:18px;background:linear-gradient(180deg,#ffffff 0%,#fbf8f3 100%);padding:12px 13px;box-shadow:0 10px 22px rgba(15,23,42,.04);display:grid;gap:5px}
    .patternCard::after{content:"";position:absolute;right:-16px;top:-16px;width:74px;height:74px;border-radius:999px;background:radial-gradient(circle,rgba(180,138,79,.12),rgba(180,138,79,0));pointer-events:none}
    .patternKick{font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#8e6d3d}
    .patternValue{font-size:15px;font-weight:950;letter-spacing:-.02em;color:#2f2418}
    .patternMeta{font-size:12px;line-height:1.45;color:var(--muted)}
    @media (max-width:1100px){.patternStrip{grid-template-columns:repeat(2,minmax(0,1fr));}}
    @media (max-width:720px){.patternStrip{grid-template-columns:1fr;}}

@media (max-width:1100px){
      .hero{grid-template-columns:1fr}
      .overview-grid{grid-template-columns:1fr}
      .settings-home-list{grid-template-columns:repeat(2,minmax(0,1fr))}
      .kpis,.summary-strip{grid-template-columns:repeat(2,minmax(0,1fr))}
      .col-3,.col-4,.col-5,.col-6,.col-8,.col-12{grid-column:span 12}
    }
    @media (max-width:720px){
      .wrap{padding:12px}
      .kpis,.summary-strip{grid-template-columns:1fr}
      .settings-home-list{grid-template-columns:1fr}
      .mini-grid,.access-grid,.embedded-manager-grid{grid-template-columns:1fr}
      .section-row{align-items:stretch}
      .section-rail{flex-basis:100%}
      .tab-picker{width:100%}
      .picker-trigger{width:100%;justify-content:center}
      .quick-focus-row{flex-direction:column}
      h1{font-size:24px}
    }

    @media (max-width:1280px){.wrap{padding:0 14px 18px}.backroom-header{grid-template-columns:1fr;overflow:visible;border-radius:0 0 22px 22px}.backroom-brand,.backroom-nav,.backroom-user{min-height:auto}.backroom-nav{padding:4px 12px 10px;justify-content:flex-start}.nav-btn{height:58px}.backroom-user{justify-content:flex-start;flex-wrap:wrap;overflow:visible;min-width:0}.backroom-search{min-width:260px;max-width:none;flex:1 1 320px}.quick-apps-panel{left:0;right:auto;min-width:min(92vw,420px)}}
    @media (max-width:760px){.quick-apps-panel{min-width:min(94vw,360px)}.quick-apps-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.top-icon-group{display:none}}
  

    /* phase 16: settings system upgrade */
    html{scrollbar-color:rgba(142,109,61,.42) rgba(15,23,42,.06)}
    ::-webkit-scrollbar{width:12px;height:12px}
    ::-webkit-scrollbar-thumb{background:linear-gradient(180deg,rgba(180,138,79,.44),rgba(108,82,46,.44));border-radius:999px;border:3px solid rgba(255,255,255,.9)}
    ::-webkit-scrollbar-track{background:rgba(15,23,42,.04);border-radius:999px}
    .overview-card,.section-card,.quick-app-card,.business-pane,.panel,.viewer-card,.info-card,.overview-primary,.status-panel,.settings-command-card,.table-wrap,.embedded-manager,.access-summary-shell{transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease, background .16s ease}
    .overview-card:hover,.section-card:hover,.quick-app-card:hover,.business-pane:hover,.viewer-card:hover,.info-card:hover,.status-panel:hover,.settings-command-card:hover{transform:translateY(-2px);box-shadow:0 18px 38px rgba(15,23,42,.10);border-color:rgba(180,138,79,.18)}
    .business-pane-shell,.table-wrap,.access-summary-shell,.embedded-manager{box-shadow:0 16px 34px rgba(15,23,42,.06)}
    .btn,.nav-btn,.mini-btn,.header-action-btn,.jump-btn,.business-subtab,.tab,.top-icon-btn,.quick-apps-btn,.table-col-btn{transition:transform .14s ease, box-shadow .14s ease, border-color .14s ease, background .14s ease}
    .btn:hover,.nav-btn:hover,.mini-btn:hover,.header-action-btn:hover,.jump-btn:hover,.business-subtab:hover,.tab:hover,.top-icon-btn:hover,.quick-apps-btn:hover,.table-col-btn:hover{transform:translateY(-1px);box-shadow:0 12px 24px rgba(15,23,42,.08)}
    .btn.primary,.quick-apps-btn.primary,.header-action-btn.primary{box-shadow:0 14px 28px rgba(108,82,46,.18)}
    .field input:focus,.field textarea:focus,.field select:focus,.backroom-search input:focus,.table-col-search input:focus,.text-editor-textarea:focus{outline:none;border-color:rgba(180,138,79,.34);box-shadow:0 0 0 4px rgba(180,138,79,.12),0 12px 28px rgba(108,82,46,.08)}
    .empty{padding:18px 16px;border:1px dashed rgba(180,138,79,.22);border-radius:16px;background:linear-gradient(180deg,#fffdfa 0%,#f7f1e6 100%);font-weight:800;color:#6c522e}
    .modal,.overlay{backdrop-filter:blur(4px)}
</style>
</head>
<body>
  <div class="wrap">
    <div class="backroom-header">
      <div class="backroom-brand">
        <b>DIAMOND Backroom</b>
        <span>Front site · Pricing · Fleet · Team & Security</span>
      </div>
      <div class="backroom-nav" id="backroomNav"></div>
      <div class="backroom-user" id="backroomUser"></div>
    </div>
    <div class="panel" id="accessGate" style="display:none;margin-bottom:16px;padding:18px 20px"></div>

    <div class="tabs" id="tabs"></div>

    <section class="section active" data-section="settingsHome">
      <div class="panel section-card">
        <div class="section-head">
          <div>
            <h2>Overview</h2>
            <p>Συμπτυγμένο control overview για τη συνολική εικόνα της εταιρίας, το system status και τη γρήγορη μετάβαση στα βασικά sections.</p>
          </div>
          <div class="actions">
            <button class="btn" id="settingsHomeRefreshBtn" data-allow-busy="1">Ανανέωση</button>
          </div>
        </div>

        <div class="overview-grid">
          <div class="overview-card overview-primary">
            <div class="overview-card-head">
              <div>
                <div class="eyebrow">Company control center</div>
                <h3>Backroom settings &amp; front data control</h3>
                <p>Κεντρική διαχείριση εταιρίας, front catalog, τιμολόγησης, λειτουργίας κράτησης και automations από ένα σημείο.</p>
              </div>
            </div>
            <div class="summary-strip">
              <div class="summary-chip"><div class="label">Νόμισμα</div><div class="value" id="snapCurrency">—</div><div class="hint">Primary catalog currency</div></div>
              <div class="summary-chip"><div class="label">VAT</div><div class="value" id="snapVat">—</div><div class="hint">Global tax rate</div></div>
              <div class="summary-chip"><div class="label">Night window</div><div class="value" id="snapNight">—</div><div class="hint">Out-of-hours window</div></div>
              <div class="summary-chip"><div class="label">Deposit</div><div class="value" id="snapDeposit">—</div><div class="hint">Default guarantee amount</div></div>
            </div>
            <div class="micro-grid" id="kpis"></div>
            <div class="quick-actions">
              <button class="btn" id="refreshSnapshotBtn" data-allow-busy="1">Refresh catalog</button>
              <button class="btn warn" id="seedAllDefaultsBtn" data-allow-busy="1">Seed missing defaults</button>
              <button class="btn good" id="exportSnapshotBtn" data-allow-busy="1">Export JSON</button>
              <button class="btn" id="copySnapshotBtn" data-allow-busy="1">Copy JSON</button>
              <button class="btn" id="copySectionDigestBtn" data-allow-busy="1">Copy section digest</button>
              <button class="btn" id="queueSettingsSectionBtn" data-allow-busy="1">Queue section</button>
            </div>
          </div>

          <div class="overview-card overview-status">
            <div class="overview-card-head">
