          return;
        }
        if(state.editor.kind === 'pricingSeason'){
          setBusy(true);
          post('deletePricingSeason', { payload: { itemId: item._id, itemKey: item.key } });
          closeEditor();
          return;
        }
        if(state.editor.kind === 'categoryRateRule'){
          setBusy(true);
          post('deleteCategoryRateRule', { payload: { itemId: item._id, itemKey: item.key } });
          closeEditor();
          return;
        }
        if(!['insurance','extra','fee'].includes(state.editor.kind)) return;
        const collectionName = state.editor.kind === 'insurance' ? 'InsurancePlans' : state.editor.kind === 'extra' ? 'ExtraServices' : 'FeeRules';
        setBusy(true);
        post('deletePricingItem', { payload: { collectionName, itemId: item._id, itemKey: item.key } });
        closeEditor();
      });
    }

    window.addEventListener('message', handleMessage);
    bind();
    renderTabs();
    renderSections();
    post('pricingAdminReady', {});
    requestResize();
    setTimeout(requestResize, 400);
    setTimeout(requestResize, 1200);
  </script>
</body>
</html>
