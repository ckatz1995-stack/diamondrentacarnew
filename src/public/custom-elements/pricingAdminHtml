    function filterList(list, text, extraFn){
      const q = String(text || '').trim().toLowerCase();
      return list.filter(item => {
        const match = !q || [item.key, item.label, item.title, item.displayTitle, item.description, item.ruleType, item.audienceGroup, item.category, item.categoryCode, item.seasonKey, item.transmission, item.fuelType, item.plate, item.model, item.address, item.city, item.locationType, item.stationKey, item.stationLabel, item.station].some(v => String(v || '').toLowerCase().includes(q));
        return match && (!extraFn || extraFn(item));
      });
    }

