    function bindEditorTools(kind){
      if(kind === 'role'){
        const allBtn = document.getElementById('roleCheckAllBtn');
        const noneBtn = document.getElementById('roleClearAllBtn');
        if(allBtn) allBtn.addEventListener('click', () => { els.editorGrid.querySelectorAll('[data-perm-box]').forEach(box => { box.checked = true; }); });
        if(noneBtn) noneBtn.addEventListener('click', () => { els.editorGrid.querySelectorAll('[data-perm-box]').forEach(box => { box.checked = false; }); });
        return;
      }
      if(kind === 'categoryRateRule'){
        const presetSelect = els.editorGrid.querySelector('[data-field="rangePreset"]');
        const minInput = els.editorGrid.querySelector('[data-field="minDays"]');
        const maxInput = els.editorGrid.querySelector('[data-field="maxDays"]');
        const categorySelect = els.editorGrid.querySelector('[data-field="categoryCode"]');
        const categoryIdInput = els.editorGrid.querySelector('[data-field="vehicleCategoryId"]');
        const syncPreset = () => {
          const preset = DAY_BRACKET_PRESETS.find((row) => row.key === String(presetSelect?.value || 'custom'));
          if(!preset || preset.key === 'custom') return;
          if(minInput) minInput.value = String(preset.minDays);
          if(maxInput) maxInput.value = String(preset.maxDays);
        };
        const syncCategoryId = () => {
          const row = vehicleCategoryByCode(categorySelect?.value || '');
          if(categoryIdInput) categoryIdInput.value = row?._id || '';
        };
        const syncCustomPreset = () => {
          if(!presetSelect) return;
          const key = presetKeyForRange(minInput?.value, maxInput?.value);
          presetSelect.value = key || 'custom';
        };
        if(presetSelect) presetSelect.addEventListener('change', syncPreset);
        if(categorySelect) categorySelect.addEventListener('change', syncCategoryId);
        if(minInput) minInput.addEventListener('input', syncCustomPreset);
        if(maxInput) maxInput.addEventListener('input', syncCustomPreset);
        syncCategoryId();
        syncCustomPreset();
        return;
      }
      if(kind === 'pickupLocation'){
        const stationSelect = els.editorGrid.querySelector('[data-station-profile-select]');
        const stationLabelInput = els.editorGrid.querySelector('[data-field="stationLabel"]');
        const syncStationLabel = () => {
          const selectedKey = String(stationSelect?.value || '').trim().toLowerCase();
          const match = effectiveStationProfiles().find((row) => row.key === selectedKey);
          if (stationLabelInput) stationLabelInput.value = match?.label || '';
