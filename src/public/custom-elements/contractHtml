  function directDriverLookup(index = 0, options = {}){
    const input = byId(driverFieldId(index));
    if (!input) return false;
    const raw = safe(input.value).trim();
    state.ui.driverLookupDrafts = state.ui.driverLookupDrafts || {};
    state.ui.driverLookupDrafts[index] = raw;
    if (!raw) {
      if (index === 0) {
        clearMainDriverDraft();
      } else {
        state.rental.additionalDrivers = Array.isArray(state.rental.additionalDrivers) ? state.rental.additionalDrivers : [];
        state.rental.additionalDrivers[index - 1] = { fullName:'', phone:'', email:'', licenseNo:'', idNo:'', dob:'', licenseCountry:'', licenseIssueDate:'', licenseExpiry:'', idCountry:'', idIssueDate:'', idExpiry:'', city:'', address:'', notes:'' };
      }
      renderExtraDrivers();
      renderSummary();
      return false;
    }
    const matches = findCustomerMatches(raw);
    if (!matches.length) return false;
    let chosen = null;
    const lower = raw.toLowerCase();
    chosen = matches.find((c) => [safe(c.name).toLowerCase(), safe(c.email).toLowerCase(), safe(c.phone).toLowerCase(), safe(c.mobile).toLowerCase(), safe(c.idNo).toLowerCase(), safe(c.licenseNo).toLowerCase()].includes(lower)) || null;
    if (!chosen && matches.length === 1) chosen = matches[0];
    if (chosen) {
      if (index === 0) {
        setMainDriverFromCustomer(chosen);
        state.ui.driverLookupDrafts[0] = chosen.name || '';
      } else {
        setAdditionalDriverFromCustomer(index, chosen);
        state.ui.driverLookupDrafts[index] = chosen.name || '';
      }
      renderExtraDrivers();
      renderSummary();
      return true;
    }
    if (options.openModalOnMultiple) {
      state.ui.customerSearchTarget = index;
      state.ui.customerSearchSelectedIndex = -1;
      setVal('customerSearchInput', raw);
      byId('customerSearchModalTitle').textContent = `Search ${driverSlotText(index)}`;
