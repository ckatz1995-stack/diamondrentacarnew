  function renderMovementCalendar(){
    ensureMovementUiState();
    const wrap = byId('movementCalendarGrid');
    const label = byId('movementCalendarMonthLabel');
    if (!wrap || !label) return;
    const base = state.ui.movement.calendarDate || new Date();
    const year = base.getFullYear();
    const month = base.getMonth();
    label.textContent = base.toLocaleDateString('el-GR', { month:'long', year:'numeric' });
    const first = new Date(year, month, 1);
    const startOffset = (first.getDay() + 6) % 7;
    const start = new Date(year, month, 1 - startOffset);
    const selected = state.ui.movement.selectedDate || null;
    const today = new Date(); today.setHours(0,0,0,0);
    const cells = [];
    for (let i = 0; i < 42; i += 1) {
      const d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
      const active = selected && d.toDateString() === selected.toDateString();
      const muted = d.getMonth() !== month;
      const isToday = d.toDateString() === today.toDateString();
      cells.push(`<button class="calendar-day ${active ? 'active' : ''} ${muted ? 'muted' : ''} ${isToday ? 'today' : ''}" type="button" data-movement-day="${d.toISOString()}">${d.getDate()}</button>`);
    }
    wrap.innerHTML = cells.join('');
    qa('[data-movement-day]').forEach((btn) => btn.addEventListener('click', () => {
      const dt = new Date(btn.dataset.movementDay);
      state.ui.movement.selectedDate = new Date(dt.getFullYear(), dt.getMonth(), dt.getDate());
      renderMovementCalendar();
      renderMovementTimeGrid();
    }));
  }

