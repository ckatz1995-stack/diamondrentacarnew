  function runHeaderSearch(){
    const raw = safe(byId('topSearchInput')?.value).trim().toLowerCase();
    if (!raw) return;
    const routeMap = {
      myroom:'home', home:'home',
      daily:'daily',
      fleet:'fleet', fleetchart:'fleet',
      bookings:'bookings', bookingboard:'bookings',
      settings:'settings', pricing:'settings'
    };
    if (routeMap[raw]) {
      post({ type:'navigate', route: routeMap[raw] });
      return;
    }
    const commands = [
      { keys:['booking','header','reservation','res'], action: () => scrollToBlock('panelBooking') },
      { keys:['customer','driver','corporate','renter'], action: () => scrollToBlock('panelCustomer') || openModal('customerModal') },
      { keys:['pickup','dropoff','movement','rental','km','fuel'], action: () => scrollToBlock('panelMovement') || openModal('rentalModal') },
      { keys:['vehicle','category','products'], action: () => scrollToBlock('panelVehicle') || openModal('vehicleModal') },
      { keys:['billing','payments','payment','finance','commercial'], action: () => openModal('billingModal') },
      { keys:['charges','pricing','fees','protections','extras'], action: () => openModal('chargesModal') || scrollToBlock('panelFinancial') },
      { keys:['notes','damage','memo'], action: () => openModal('notesModal') }
    ];
    const found = commands.find((entry) => entry.keys.some((key) => raw.includes(key)));
    if (found) {
      found.action();
      closeQuickApps();
      toast(`Search jump: ${raw}`);
      return;
    }
    toast('Δεν βρέθηκε σχετική ενότητα στο contract header.');
  }

