    if (!rows.length) { list.innerHTML=''; empty.classList.remove('hidden'); return; }
    empty.classList.add('hidden');
    list.innerHTML = rows.map((row) => {
      const key = safe(row.key || row.label);
      const active = safe(state.ui.locationPicker.selectedKey) === key;
      return `<button class="location-option ${active ? 'active' : ''}" type="button" data-location-key="${escapeAttr(key)}">
