<script>
(function(){
  'use strict';

  const state = {
    booking: {},
    rental: {},
    lookups: { categories: [], vehicles: [], customers: [], companies: [], pickupLocations: [] },
    context: {},
    ui: { activeModal: '', saveState: '', additionalDriversOpen: false, driverLookupDrafts: {}, companyLookupDraft: null, activeDriverSlot: 0, customerSearchTarget: 0, customerSearchSelectedIndex: -1, activeDriverTab: 'general', activeCompanyTab: 'general', activeDriverRegistryMatch: null, activeCompanyRegistryMatch: null, mainDriverCustomerId: '', selectedCompanyId: '', driverInsightsKey: '', driverInsightsLoading: false, driverInsights: null, companyInsightsKey: '', companyInsightsLoading: false, companyInsights: null, vehicleSelectorQuery: '', vehicleSelectorFilter: 'all', vehicleSelectorSelectedId: '', vehicleSelectorCategoryCode: '' }
  };

  const q = (sel, root=document) => root.querySelector(sel);
  const qa = (sel, root=document) => Array.from(root.querySelectorAll(sel));
  const byId = (id) => document.getElementById(id);
  const money = (n) => `${(Number(n || 0) || 0).toFixed(2)} €`;
  const safe = (v) => (v ?? '').toString();
  const normalizeLooseText = (v) => safe(v).trim().toLowerCase();
  const digitsOnlyText = (v) => safe(v).replace(/\D+/g,'');
  const num = (v) => {
    const n = Number(v);
    return Number.isFinite(n) ? n : 0;
  };
  const round2 = (v) => Math.round(num(v) * 100) / 100;
  const pad = (n) => String(n).padStart(2,'0');
  const fuelLabel = (v) => {
    const map = {1:'1/8',2:'2/8',3:'3/8',4:'4/8',5:'5/8',6:'6/8',7:'7/8',8:'8/8'};
    return map[num(v)] || '—';
  };
  const statusClass = (s) => {
    const value = safe(s).toLowerCase();
    if (value.includes('cancel')) return 'cancelled';
    if (value.includes('confirm')) return 'confirmed';
    if (value.includes('active') || value.includes('check')) return 'active';
    return 'pending';
  };

  function normalizeLookups(raw){
    const lookups = raw && typeof raw === 'object' ? raw : {};
    const toArray = (value) => Array.isArray(value) ? value : [];
    return {
      categories: toArray(lookups.categories || lookups.vehicleCategories || lookups.categoryList),
      vehicles: toArray(lookups.vehicles || lookups.fleetVehicles || lookups.fleet),
      customers: toArray(lookups.customers || lookups.customerList),
      companies: toArray(lookups.companies || lookups.companyList),
      pickupLocations: toArray(lookups.pickupLocations || lookups.locations || lookups.stationLocations)
    };
  }

  function isoLocal(value){
    if (!value) return '';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return '';
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function humanDateTime(value){
    if (!value) return '—';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return safe(value);
    return new Intl.DateTimeFormat('el-GR',{dateStyle:'short', timeStyle:'short'}).format(d);
  }

  function humanDate(value){
    if (!value) return '—';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return safe(value);
    return new Intl.DateTimeFormat('el-GR',{dateStyle:'short'}).format(d);
  }

  function linesFromState(){
    const booking = state.booking || {};
    const rental = state.rental || {};
    const charges = rental.charges || booking.charges || {};
    const rentalValue = round2(charges.rental ?? booking.baseCost ?? ((num(booking.basePricePerDay) || 0) * billableDays()));
    const insurance = round2(charges.insurance ?? booking.insuranceCost ?? ((num(booking.insuranceExtraPerDay) || 0) * billableDays()));
    const options = round2(charges.options ?? booking.extrasTotal ?? 0);
    const ageFee = round2(charges.ageFee ?? booking.ageFee ?? 0);
    const nightFee = round2(charges.nightFee ?? booking.nightFee ?? 0);
    const transport = round2(charges.transport ?? 0);
    const damages = round2(charges.damages ?? 0);
    const surcharges = round2(charges.surcharges ?? 0);
    const discount = round2(charges.discount ?? 0);
    const gross = round2(rentalValue + insurance + options + ageFee + nightFee + transport + damages + surcharges - discount);
    return { rental:rentalValue, insurance, options, ageFee, nightFee, transport, damages, surcharges, discount, gross };
  }

  function financials(){
    const bill = state.rental?.billing || {};
    const vatRate = num(bill.vatRate ?? 0.24);
    const gross = linesFromState().gross;
    const net = vatRate > 0 ? round2(gross / (1 + vatRate)) : gross;
    const vat = round2(gross - net);
    const prepaid = round2(state.rental?.financials?.prepaid ?? 0);
    const paidNow = round2(state.rental?.financials?.paidNow ?? 0);
    const deposit = round2(state.rental?.financials?.deposit ?? 0);
    const balance = round2(gross - prepaid - paidNow);
    return { gross, net, vat, prepaid, paidNow, deposit, balance };
  }

  function billableDays(){
    const start = new Date(state.booking?.pickupDateTime);
    const end = new Date(state.booking?.dropoffDateTime);
    if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return 1;
    const hours = Math.max(0, end - start) / 36e5;
    return Math.max(1, Math.ceil(hours / 24));
  }

  function parseExtras(value){
    if (Array.isArray(value)) {
      return value.map((x) => typeof x === 'string' ? x : (x?.label || x?.title || x?.name || '')).filter(Boolean);
    }
    return safe(value).split(',').map((v) => v.trim()).filter(Boolean);
  }

  function post(msg){
    if (window.parent) {
      window.parent.postMessage(msg, '*');
    }
  }

  function toast(message){
    const el = byId('toast');
    if (!el) return;
    el.textContent = safe(message);
    el.classList.add('show');
    clearTimeout(toast._t);
    toast._t = setTimeout(() => el.classList.remove('show'), 3200);
  }

  function bookingSourceLabel(booking = {}){
    return safe(
      booking.sourceLabel ||
      booking.bookingSource ||
      booking.source ||
      booking.channel ||
      booking.channelLabel ||
      booking.createdVia ||
      booking.origin ||
      booking.provider ||
      booking.partner ||
      ''
    ).trim();
  }

  function isSiteSourceLabel(value){
    const v = safe(value).trim().toLowerCase();
    return ['site','website','web','online','direct','booking engine','engine','public form','public','widget'].includes(v);
  }

  function bookingCreatedByLabel(booking = {}){
    const source = bookingSourceLabel(booking);
    const raw = safe(
      booking.createdByName ||
      booking.createdByLabel ||
      booking.createdByUser ||
      booking.createdByFullName ||
      booking.createdBy ||
      booking.operatorName ||
      booking.insertedBy ||
      booking.createdFromUser ||
      ''
    ).trim();
    if (!raw) return '';
    if (isSiteSourceLabel(source)) return '';
    const lower = raw.toLowerCase();
    if (['site','website','web','online','direct','booking engine','system','public form'].includes(lower)) return '';
    return raw;
  }

  function bookingCreatedDateLabel(booking = {}){
    const value = booking._createdDate || booking.createdDate || booking.createdAt || booking.bookingCreatedDate || '';
    return humanDateTime(value);
  }

  function syncMainFieldsFromState(){
    const b = state.booking || {};
    const r = state.rental || {};
    const billing = r.billing || {};
    const fin = r.financials || {};
    const drv = r.mainDriver || b.mainDriver || b.mainDriverDefault || {};

    setVal('book_bookingNumber', b.bookingNumber || '');
    setVal('book_createdDate', bookingCreatedDateLabel(b));
    setVal('book_source', bookingSourceLabel(b));
    setVal('book_createdBy', bookingCreatedByLabel(b));
    setVal('book_status', b.status || 'Pending');
    setVal('book_pickupDateTime', isoLocal(b.pickupDateTime));
    setVal('book_dropoffDateTime', isoLocal(b.dropoffDateTime));
    setVal('loc_pickuppoint', b.pickuppoint || '');
    setVal('loc_dropoffpoint', b.dropoffpoint || '');
    setVal('loc_pickupComment', b.pickupComment || b.pickupLocationNote || '');
    setVal('loc_dropoffComment', b.dropoffComment || b.dropoffLocationNote || '');

    setVal('book_customerName', b.customerName || '');
    setVal('book_phone', b.phone || '');
    setVal('book_email', b.email || '');
    setVal('book_customerCity', b.customerCity || '');
    setVal('book_originCity', b.originCity || '');
    setVal('book_flightNumber', b.flightNumber || '');
    setVal('book_voucherNumber', b.voucherNumber || '');
    setVal('book_confirmationNumber', b.confirmationNumber || '');
    setVal('book_originCity_vehicle', b.originCity || '');
    setVal('book_flightNumber_vehicle', b.flightNumber || '');

    setVal('book_category', b.category || '');
    setVal('book_categoryId', b.categoryId || b.assignedCategoryCode || '');
    setVal('veh_assignedLabel', b.assignedVehicleLabel || r.assignedVehicleLabel || '');
    setVal('veh_assignedPlate', b.assignedVehiclePlate || '');
    setVal('book_selectedPackage', b.selectedPackage || '');
    setVal('book_selectedExtras', parseExtras(b.selectedExtras).join(', '));

    setVal('modal_customerName', b.customerName || '');
    setVal('modal_customerPhone', b.phone || '');
    setVal('modal_customerEmail', b.email || '');
    setVal('modal_customerCity', b.customerCity || '');
    setVal('modal_originCity', b.originCity || '');

    setVal('drv_fullName', drv.fullName || b.customerName || '');
    setVal('drv_phone', drv.phone || b.phone || '');
    setVal('drv_email', drv.email || b.email || '');
    setVal('drv_idNo', drv.idNo || '');
    setVal('drv_idCountry', drv.idCountry || '');
    setVal('drv_dob', drv.dob || '');
    setVal('drv_licenseNo', drv.licenseNo || '');
    setVal('drv_licenseCountry', drv.licenseCountry || '');
    setVal('drv_licenseIssueDate', drv.licenseIssueDate || '');
    setVal('drv_licenseExpiry', drv.licenseExpiry || '');
    setVal('drv_idIssueDate', drv.idIssueDate || '');
    setVal('drv_idExpiry', drv.idExpiry || '');
    setVal('drv_city', drv.city || '');
    setVal('drv_address', drv.address || '');
    setVal('drv_notes', drv.notes || '');
    state.ui.mainDriverCustomerId = safe(drv.customerId || '');
    state.ui.driverInsights = null;
    state.ui.driverInsightsKey = '';
    state.ui.activeDriverRegistryMatch = null;

    setVal('bill_invoiceType', billing.invoiceType || '');
    setVal('bill_companyName', billing.companyName || '');
    setVal('bill_tradeName', billing.tradeName || '');
    setVal('displayPoNumber', billing.poNumber || b.poNumber || '');
    setVal('bill_vatNumber', billing.vatNumber || '');
    setVal('bill_taxOffice', billing.taxOffice || '');
    setVal('bill_profession', billing.profession || '');
    setVal('bill_address', billing.address || '');
    setVal('bill_city', billing.city || '');
    setVal('bill_zip', billing.zip || '');
    setVal('bill_country', billing.country || '');
    setVal('bill_phone', billing.phone || '');
    setVal('bill_companyEmail', billing.companyEmail || '');
    setVal('bill_contactPerson', billing.contactPerson || '');
    setVal('bill_notes', billing.notes || '');
    setVal('bill_vatRate', billing.vatRate ?? 0.24);
    setVal('bill_vatInclusive', String((billing.vatInclusive ?? true)));

    setVal('fin_paymentMethod', fin.paymentMethod || 'cash');
    setVal('fin_paymentStatus', fin.paymentStatus || 'pending');
    setVal('fin_prepaid', fin.prepaid ?? b.prepaidAmount ?? 0);
    setVal('fin_paidNow', fin.paidNow ?? b.paidNowAmount ?? 0);
    setVal('fin_deposit', fin.deposit ?? b.depositAmount ?? 0);

    setVal('veh_categoryLabel', b.category || '');
    setVal('veh_categoryCode', b.categoryId || b.assignedCategoryCode || '');
    setVal('veh_package', b.selectedPackage || '');
    setVal('veh_extras', parseExtras(b.selectedExtras).join(', '));
