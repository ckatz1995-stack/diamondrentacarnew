  function bestCompanyMatchForBillingDraft(){
    const companies = state.lookups?.companies || [];
    if (!companies.length) return null;
    const draft = {
      companyName: normalizeLooseText(byId('bill_companyName')?.value || byId('customerCorporateInline')?.value || ''),
      tradeName: normalizeLooseText(byId('bill_tradeName')?.value || ''),
      vatNumber: normalizeLooseText(byId('bill_vatNumber')?.value || ''),
      phone: digitsOnlyText(byId('bill_phone')?.value || ''),
      email: normalizeLooseText(byId('bill_companyEmail')?.value || '')
    };
    if (!draft.companyName && !draft.tradeName && !draft.vatNumber && !draft.phone && !draft.email) return null;
    const exact = [];
    const partial = [];
    companies.forEach((c) => {
      const cmp = {
        companyName: normalizeLooseText(c.companyName),
        tradeName: normalizeLooseText(c.tradeName),
        vatNumber: normalizeLooseText(c.vatNumber),
        phone: digitsOnlyText(c.phone),
        email: normalizeLooseText(c.email)
      };
      let score = 0;
      if (draft.vatNumber && cmp.vatNumber && draft.vatNumber === cmp.vatNumber) score += 6;
      if (draft.email && cmp.email && draft.email === cmp.email) score += 5;
      if (draft.phone && cmp.phone && draft.phone === cmp.phone) score += 5;
      if (draft.companyName && cmp.companyName && (draft.companyName === cmp.companyName || draft.companyName === cmp.tradeName)) score += 4;
      if (draft.tradeName && (draft.tradeName === cmp.tradeName || draft.tradeName === cmp.companyName)) score += 4;
      const loose = companyLookupHaystack(c);
      if (!score) {
        if (draft.companyName && loose.includes(draft.companyName)) score += 2;
        if (draft.tradeName && loose.includes(draft.tradeName)) score += 2;
        if (draft.vatNumber && loose.includes(draft.vatNumber)) score += 2;
      }
      if (score >= 4) exact.push(c);
      else if (score >= 2) partial.push(c);
    });
    const merged = [...exact, ...partial];
    const unique = [];
    const seen = new Set();
    merged.forEach((c) => {
      const key = c.companyId || `${safe(c.companyName)}|${safe(c.vatNumber)}|${safe(c.phone)}|${safe(c.email)}`;
      if (seen.has(key)) return;
      seen.add(key);
      unique.push(c);
    });
    if (unique.length === 1) return { mode:'single', match: unique[0], count: 1 };
    if (unique.length > 1) return { mode:'multiple', match: unique[0], count: unique.length };
    return null;
  }

