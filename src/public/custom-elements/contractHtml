  function renderVehicleSelector(){
    const vehicles = state.lookups?.vehicles || [];
    const body = byId('veh_selectorBody');
    const empty = byId('veh_selectorEmpty');
    if (!body || !empty) return;
    const rawQuery = safe(byId('veh_selectorSearch')?.value || state.ui.vehicleSelectorQuery || '').trim().toLowerCase();
    const filter = safe(state.ui.vehicleSelectorFilter || 'all').trim() || 'all';
    const selectedCategory = safe(byId('veh_selectorCategory')?.value || state.ui.vehicleSelectorCategoryCode || '').trim();
    const categoryCode = selectedCategory && selectedCategory !== '__all__' ? selectedCategory : '';
    const filtered = vehicles.filter((vehicle) => {
      if (categoryCode && vehicle.categoryCode && vehicle.categoryCode !== categoryCode) return false;
      const kind = normalizeVehicleFilterStatus(vehicle);
      if (filter !== 'all' && kind !== filter) return false;
      if (!rawQuery) return true;
      const hay = [vehicle.plate, vehicle.model, vehicle.categoryCode, vehicle.categoryLabel, vehicle.currentStationCode, vehicle.currentStationLabel, vehicle.status, vehicle.operationalStatus, vehicle.label, vehicle.selectorStatusReason].filter(Boolean).join(' | ').toLowerCase();
      return hay.includes(rawQuery);
    });

    const assignableCount = filtered.filter((v) => !!v.assignable || !!v.thisBookingAssigned).length;
    const conflictCount = filtered.filter((v) => ['busy','wrongStation','service'].includes(normalizeVehicleFilterStatus(v))).length;
    byId('veh_selectorBookedCategory') && (byId('veh_selectorBookedCategory').textContent = currentVehicleCategoryLabel() || currentVehicleCategoryCode() || '—');
    byId('veh_selectorVisibleCount') && (byId('veh_selectorVisibleCount').textContent = String(filtered.length));
    byId('veh_selectorAvailableCount') && (byId('veh_selectorAvailableCount').textContent = String(assignableCount));
    byId('veh_selectorConflictCount') && (byId('veh_selectorConflictCount').textContent = String(conflictCount));
    byId('veh_selectorCurrentAssignment') && (byId('veh_selectorCurrentAssignment').textContent = safe(byId('veh_vehicleLabel')?.value || byId('veh_assignedLabel')?.value || '—') || '—');

    const selected = getSelectedVehicleRow();
    const selectedLabel = selected ? `${selected.plate || '—'} · ${selected.model || ''}`.trim() : 'No vehicle selected';
    byId('veh_selectorSelectedTitle') && (byId('veh_selectorSelectedTitle').textContent = selectedLabel);
    byId('veh_selectorSelectedSub') && (byId('veh_selectorSelectedSub').textContent = selected ? [selected.categoryLabel || selected.categoryCode, selected.currentStationLabel || selected.currentStationCode].filter(Boolean).join(' • ') : 'Επέλεξε όχημα από τον πίνακα για assign.');
    byId('veh_selectorSelectedAvailability') && (byId('veh_selectorSelectedAvailability').textContent = selected ? vehicleStatusLabel(selected) : '—');
    byId('veh_selectorSelectedStation') && (byId('veh_selectorSelectedStation').textContent = selected ? (selected.currentStationLabel || selected.currentStationCode || '—') : '—');
    byId('veh_selectorSelectedMileage') && (byId('veh_selectorSelectedMileage').textContent = selected ? formatVehicleMileage(selected.mileage) : '—');
    byId('veh_selectorSelectedFuel') && (byId('veh_selectorSelectedFuel').textContent = selected ? fuelLabel(selected.fuelLevel) : '—');
    byId('veh_selectorSelectedExcess') && (byId('veh_selectorSelectedExcess').textContent = selected && Number(selected.excess || 0) ? money(selected.excess) : '—');
    byId('veh_selectorSelectedReason') && (byId('veh_selectorSelectedReason').textContent = selected ? (selected.selectorStatusReason || 'Ready for assign.') : '—');

    const assignBtn = byId('btnVehicleSelectorAssign');
    if (assignBtn) {
      const canAssign = !!selected && (!!selected.assignable || !!selected.thisBookingAssigned);
      assignBtn.disabled = !canAssign;
      assignBtn.textContent = selected?.thisBookingAssigned ? 'Already assigned' : 'Assign selected';
    }

    if (!filtered.length) {
      body.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');
    body.innerHTML = filtered.map((vehicle) => {
      const active = String(vehicle._id) === String(state.ui.vehicleSelectorSelectedId || '');
      const kind = normalizeVehicleFilterStatus(vehicle);
      const badgeClass = vehicleStatusBadgeClass(vehicle);
      const statusText = vehicleStatusLabel(vehicle);
      const stationNote = vehicle.selectorStatusKey === 'wrongStation' ? `<div class="vehicle-status-note">${escapeHtml(vehicle.selectorStatusReason || '')}</div>` : '';
      const statusNote = vehicle.selectorStatusKey !== 'wrongStation' && vehicle.selectorStatusReason ? `<div class="vehicle-status-note">${escapeHtml(vehicle.selectorStatusReason)}</div>` : '';
      return `<tr class="vehicle-row-btn ${active ? 'active' : ''}" data-veh-id="${escapeAttr(vehicle._id)}">
        <td><div class="vehicle-row-main"><b>${escapeHtml(vehicle.plate || '—')}</b><span>${escapeHtml(vehicle.model || vehicle.label || '—')}</span></div></td>
        <td>${escapeHtml(vehicle.categoryLabel || vehicle.categoryCode || '—')}</td>
        <td>${escapeHtml(vehicle.currentStationLabel || vehicle.currentStationCode || '—')}${stationNote}</td>
        <td><span class="vehicle-badge ${badgeClass}">${escapeHtml(statusText)}</span>${statusNote}</td>
        <td>${escapeHtml(formatVehicleMileage(vehicle.mileage))}</td>
        <td>${escapeHtml(vehicle.fuelLevel ? `${vehicle.fuelLevel}/8` : '—')}</td>
      </tr>`;
    }).join('');
    qa('[data-veh-id]').forEach((row) => {
      row.addEventListener('click', () => { state.ui.vehicleSelectorSelectedId = row.dataset.vehId || ''; renderVehicleSelector(); });
      row.addEventListener('dblclick', () => {
        state.ui.vehicleSelectorSelectedId = row.dataset.vehId || '';
        const match = getSelectedVehicleRow();
        if (match) applyVehicleSelectionToDraft(match);
      });
    });
  }

