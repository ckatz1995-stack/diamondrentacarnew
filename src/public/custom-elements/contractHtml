  function directCompanyLookup(options = {}){
    const sourceId = options.sourceId || 'customerCorporateInline';
    const sourceEl = byId(sourceId);
    const raw = safe(sourceEl?.value || '').trim();
    if (!raw) {
      clearCompanySelection();
      return false;
    }
    const matches = findCompanyMatches(raw);
    if (!matches.length) return false;
    const lower = raw.toLowerCase();
    let chosen = matches.find((c) => [safe(c.companyName).toLowerCase(), safe(c.tradeName).toLowerCase(), safe(c.vatNumber).toLowerCase(), safe(c.phone).toLowerCase(), safe(c.email).toLowerCase()].includes(lower)) || null;
    if (!chosen && matches.length === 1) chosen = matches[0];
    if (chosen) {
      setCompanyFromLookup(chosen);
      return true;
    }
    if (options.openModalOnMultiple) {
      state.ui.companySearchSelectedIndex = -1;
      setVal('companySearchInput', raw);
      renderCompanySearchResults(raw);
      openModal('companySearchModal');
      setTimeout(() => byId('companySearchInput')?.focus(), 30);
    }
    return false;
  }

