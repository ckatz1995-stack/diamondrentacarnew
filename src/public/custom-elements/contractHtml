      phone: byId('adddrv_phone')?.value || '',
      email: byId('adddrv_email')?.value || '',
      licenseNo: byId('adddrv_licenseNo')?.value || '',
      idNo: byId('adddrv_idNo')?.value || '',
      dob: byId('adddrv_dob')?.value || '',
      licenseCountry: byId('adddrv_licenseCountry')?.value || '',
      licenseIssueDate: byId('adddrv_licenseIssueDate')?.value || '',
      licenseExpiry: byId('adddrv_licenseExpiry')?.value || '',
      idCountry: byId('adddrv_idCountry')?.value || '',
      idIssueDate: byId('adddrv_idIssueDate')?.value || '',
      idExpiry: byId('adddrv_idExpiry')?.value || '',
      city: byId('adddrv_city')?.value || '',
      address: byId('adddrv_address')?.value || '',
      notes: byId('adddrv_notes')?.value || '',
      customerId: safe((state.rental.additionalDrivers && state.rental.additionalDrivers[index - 1] && state.rental.additionalDrivers[index - 1].customerId) || '')
    };
    state.ui.driverLookupDrafts = state.ui.driverLookupDrafts || {};
    state.ui.driverLookupDrafts[index] = state.rental.additionalDrivers[index - 1].fullName || '';
    renderExtraDrivers();
    renderSummary();
    closeModal('additionalDriverModal');
  }

  function clearAdditionalDriverDraft(){
    const index = Number(state.ui.activeDriverSlot || 1);
    state.rental.additionalDrivers = Array.isArray(state.rental.additionalDrivers) ? state.rental.additionalDrivers : [];
    state.rental.additionalDrivers[index - 1] = { fullName:'', phone:'', email:'', licenseNo:'', idNo:'', dob:'', licenseCountry:'', licenseIssueDate:'', licenseExpiry:'', idCountry:'', idIssueDate:'', idExpiry:'', city:'', address:'', notes:'' };
    state.ui.driverLookupDrafts = state.ui.driverLookupDrafts || {};
    state.ui.driverLookupDrafts[index] = '';
    renderExtraDrivers();
    renderSummary();
  }

  function openCustomerSearch(index = 0){
    state.ui.customerSearchTarget = index;
    state.ui.customerSearchSelectedIndex = -1;
    const currentQuery = safe(byId(driverFieldId(index))?.value || '');
    setVal('customerSearchInput', currentQuery);
    byId('customerSearchModalTitle').textContent = `Search ${driverSlotText(index)}`;
    byId('customerSearchModalSub').textContent = `Βρες πελάτη από το πελατολόγιο για το ${driverSlotText(index).toLowerCase()}.`; 
    renderCustomerSearchResults(currentQuery);
    openModal('customerSearchModal');
    setTimeout(() => byId('customerSearchInput')?.focus(), 30);
  }

  function renderCustomerSearchResults(raw=''){
    const query = safe(raw).trim().toLowerCase();
    const customers = state.lookups?.customers || [];
    const rows = (!query ? customers : customers.filter((c) => customerLookupHaystack(c).includes(query))).slice(0, 200);
    const body = byId('customerSearchResultsBody');
    const empty = byId('customerSearchEmpty');
    if (!body || !empty) return;
    if (!rows.length) {
      body.innerHTML = '';
      empty.classList.remove('hidden');
      state.ui.customerSearchSelectedIndex = -1;
      return;
    }
    empty.classList.add('hidden');
    body.innerHTML = rows.map((c, idx) => {
      const globalIdx = customers.indexOf(c);
      const idLic = [c.idNo, c.licenseNo].filter(Boolean).join(' • ') || '—';
      const city = c.residenceCity || c.originCity || c.city || '—';
      return `<tr data-customer-index="${globalIdx}" class="${globalIdx === state.ui.customerSearchSelectedIndex ? 'active' : ''}">
        <td class="name-cell">${escapeHtml(c.name || '—')}</td>
        <td>${escapeHtml(c.phone || c.mobile || '—')}</td>
        <td>${escapeHtml(c.email || '—')}</td>
        <td>${escapeHtml(idLic)}</td>
        <td>${escapeHtml(city)}</td>
      </tr>`;
    }).join('');
    qa('#customerSearchResultsBody tr').forEach((row) => {
      row.addEventListener('click', () => {
        state.ui.customerSearchSelectedIndex = Number(row.dataset.customerIndex || -1);
        qa('#customerSearchResultsBody tr').forEach((r) => r.classList.toggle('active', r === row));
      });
      row.addEventListener('dblclick', () => {
        state.ui.customerSearchSelectedIndex = Number(row.dataset.customerIndex || -1);
        applyCustomerSearchSelection();
      });
    });
  }

  function applyCustomerSearchSelection(){
    const customers = state.lookups?.customers || [];
    const idx = Number(state.ui.customerSearchSelectedIndex);
    const match = Number.isInteger(idx) && idx >= 0 ? customers[idx] : null;
    if (!match) {
      toast('Επίλεξε πελάτη από τη λίστα.');
      return;
    }
    const target = Number(state.ui.customerSearchTarget || 0);
    if (target === 0) {
      setMainDriverFromCustomer(match);
      state.ui.driverLookupDrafts = state.ui.driverLookupDrafts || {};
      state.ui.driverLookupDrafts[0] = match.name || '';
    } else {
      setAdditionalDriverFromCustomer(target, match);
      state.ui.driverLookupDrafts = state.ui.driverLookupDrafts || {};
      state.ui.driverLookupDrafts[target] = match.name || '';
    }
    renderExtraDrivers();
    renderSummary();
    closeModal('customerSearchModal');
    toast(`Εφαρμόστηκαν στοιχεία για ${driverSlotText(target).toLowerCase()}.`);
  }

  function setMainDriverFromCustomer(match){
    setVal('book_customerName', match.name || '');
    setVal('book_phone', match.phone || '');
    setVal('book_email', match.email || '');
    setVal('book_customerCity', match.residenceCity || '');
    setVal('book_originCity', match.originCity || '');

    setVal('drv_fullName', match.name || '');
    setVal('drv_phone', match.phone || '');
    setVal('drv_email', match.email || '');
    setVal('drv_address', match.address || '');
    setVal('drv_idNo', match.idNo || '');
    setVal('drv_idCountry', match.idCountry || '');
    setVal('drv_licenseNo', match.licenseNo || '');
    setVal('drv_licenseCountry', match.licenseCountry || '');
    setVal('drv_licenseIssueDate', match.licenseIssueDate || '');
    setVal('drv_licenseExpiry', match.licenseExpiry || '');
    setVal('drv_idIssueDate', match.idIssueDate || '');
    setVal('drv_idExpiry', match.idExpiry || '');
    setVal('drv_dob', match.dob || '');
    setVal('drv_city', match.residenceCity || match.city || '');
    setVal('drv_notes', match.notes || '');
    state.ui.mainDriverCustomerId = match.customerId || '';
    state.ui.driverLookupDrafts = state.ui.driverLookupDrafts || {};
    state.ui.driverLookupDrafts[0] = match.name || '';
    setVal('customerDriverInline', match.name || '');
    refreshDriverRegistryHint();
    ensureDriverInsights(true);
  }

  function setAdditionalDriverFromCustomer(index, match){
    state.rental.additionalDrivers = Array.isArray(state.rental.additionalDrivers) ? state.rental.additionalDrivers : [];
    state.rental.additionalDrivers[index - 1] = {
      fullName: match.name || '',
      phone: match.phone || '',
      email: match.email || '',
      licenseNo: match.licenseNo || '',
      idNo: match.idNo || '',
      dob: match.dob || '',
      licenseCountry: match.licenseCountry || '',
      licenseIssueDate: match.licenseIssueDate || '',
      licenseExpiry: match.licenseExpiry || '',
      idCountry: match.idCountry || '',
      idIssueDate: match.idIssueDate || '',
      idExpiry: match.idExpiry || '',
      city: match.residenceCity || match.city || '',
      address: match.address || '',
      notes: match.notes || '',
      customerId: match.customerId || ''
    };
    const input = byId(driverFieldId(index));
    if (input) {
      input.value = match.name || '';
      input.dataset.driverPayload = JSON.stringify(state.rental.additionalDrivers[index - 1]);
    }
    state.ui.driverLookupDrafts = state.ui.driverLookupDrafts || {};
    state.ui.driverLookupDrafts[index] = match.name || '';
  }

  function applyDriverLookup(index = 0){
    if (!directDriverLookup(index, { openModalOnMultiple: true })) {
      const raw = safe(byId(driverFieldId(index))?.value || '');
      if (!raw.trim()) openCustomerSearch(index);
    }
  }

  function saveWithStage(stage){
    const payload = collectPayload();
    post({ type:'saveContract', bookingId: state.booking?._id, stage, payload });
  }

  function postResize(){
    const height = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight, 1400);
    post({ type:'resize', height });
  }
  const postResizeThrottled = throttle(postResize, 90);

  function throttle(fn, wait){
    let t = null;
    return function(){
      if (t) return;
      t = setTimeout(() => {
        t = null;
        fn();
      }, wait);
    };
  }

  function debounce(fn, wait){
    let t = null;
    return function(...args){
      clearTimeout(t);
      t = setTimeout(() => fn.apply(this, args), wait);
    };
  }

  function escapeHtml(s){
    return safe(s).replace(/[&<>"']/g, (m) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }
  function escapeAttr(s){ return escapeHtml(s); }

  function onMessage(event){
    const msg = event.data || {};
    if (!msg.type) return;
    if (msg.type === 'loadContractData') {
      state.booking = msg.booking || {};
      state.rental = msg.rental || {};
      state.lookups = normalizeLookups(msg.lookups);
      state.context = msg.context || {};
      if (!state.rental.financials) {
        state.rental.financials = {
          paymentMethod: state.rental.paymentMethod || 'cash',
          paymentStatus: state.rental.paymentStatus || 'pending',
          prepaid: state.booking.prepaidAmount || 0,
          paidNow: state.booking.paidNowAmount || 0,
          deposit: state.booking.depositAmount || 0
        };
      }
      syncMainFieldsFromState();
      postResize();
      return;
    }
    if (msg.type === 'toast') {
      toast(msg.message || '—');
      return;
    }
    if (msg.type === 'saveState') {
      toast(msg.message || 'Saved');
      if (msg.at) byId('chipStatus').title = `Last save ${msg.at}`;
      return;
    }
    if (msg.type === 'customerInsightsData') {
      if (safe(msg.requestId) !== safe(state.ui.driverInsightsKey)) return;
      state.ui.driverInsightsLoading = false;
      state.ui.driverInsights = msg.data || null;
      renderDriverInsights();
      return;
    }
    if (msg.type === 'companyInsightsData') {
      if (safe(msg.requestId) !== safe(state.ui.companyInsightsKey)) return;
      state.ui.companyInsightsLoading = false;
      state.ui.companyInsights = msg.data || null;
      renderCompanyInsights();
      return;
    }
  }

  function init(){
    if (window.__contractHtmlInitDone) return;
    window.__contractHtmlInitDone = true;
    bindModalSystem();
    wireActions();
    bindMovementSection();
    window.addEventListener('message', onMessage);
    window.addEventListener('resize', postResizeThrottled);
    new MutationObserver(postResizeThrottled).observe(document.body, { childList:true, subtree:true, attributes:true });
    post({ type:'contractReady' });
    postResize();
  }

  init();
})();
</script>
</body>
</html>
