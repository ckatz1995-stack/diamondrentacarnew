  function extractStationCode(label=''){
    const raw = safe(label).trim();
    if (!raw) return '---';
    const direct = raw.match(/([A-Z]{3})/);
    if (direct) return direct[1];
    const words = raw.split(/\s+/).filter(Boolean);
    if (!words.length) return '---';
    return words.map((w) => w[0]).join('').slice(0, 3).toUpperCase();
  }

  function getPickupLocationRows(kind='pickup'){
    const rows = Array.isArray(state.lookups?.pickupLocations) ? state.lookups.pickupLocations : [];
    const filtered = rows.filter((row) => {
      const t = safe(row.locationType || 'both').toLowerCase() || 'both';
      return t === 'both' || t === kind;
    });
    const currentLabel = kind === 'pickup' ? safe(byId('loc_pickuppoint')?.value || state.booking?.pickuppoint) : safe(byId('loc_dropoffpoint')?.value || state.booking?.dropoffpoint);
    if (currentLabel && !filtered.some((row) => safe(row.label) === currentLabel)) {
      filtered.unshift({ key: currentLabel, label: currentLabel, description: `${currentLabel} station`, extraFee: 0, locationType: kind });
    }
    return filtered;
  }

