  function renderExtraDrivers(){
    const drivers = Array.isArray(state.rental?.additionalDrivers) ? state.rental.additionalDrivers : [];
    const drafts = state.ui.driverLookupDrafts || {};
    const hasDrivers = drivers.some((d) => Object.values(d || {}).some(Boolean));
    const wrap = byId('additionalDriversRows');
    if (wrap) wrap.classList.remove('hidden');
    const toggleBtn = byId('btnToggleAdditionalDrivers');
    if (toggleBtn) toggleBtn.textContent = state.ui.additionalDriversOpen ? 'Hide drivers' : `Additional drivers${hasDrivers ? ' (' + drivers.filter((d) => Object.values(d || {}).some(Boolean)).length + ')' : ''}`;
    for (let i = 1; i <= 3; i += 1) {
      const row = byId(`additionalDriverRow${i}`);
      const input = byId(driverFieldId(i));
      if (!input) continue;
      const d = drivers[i - 1] || {};
      const rowHasData = Object.values(d || {}).some(Boolean) || Object.prototype.hasOwnProperty.call(drafts, i) && safe(drafts[i]).trim();
      if (row) row.classList.toggle('hidden', !state.ui.additionalDriversOpen && !rowHasData);
      const fallback = input === document.activeElement ? input.value : '';
      const display = Object.prototype.hasOwnProperty.call(drafts, i) ? drafts[i] : (d.fullName || '');
      input.value = fallback || display;
      input.dataset.driverPayload = JSON.stringify({
        fullName: d.fullName || '',
        phone: d.phone || '',
        email: d.email || '',
        licenseNo: d.licenseNo || '',
        idNo: d.idNo || '',
        dob: d.dob || '',
        licenseCountry: d.licenseCountry || '',
        licenseExpiry: d.licenseExpiry || '',
        idCountry: d.idCountry || '',
        address: d.address || '',
        notes: d.notes || '',
        customerId: d.customerId || ''
      });
    }
  }

