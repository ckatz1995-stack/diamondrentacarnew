  function currentVehicleCategoryCode(){
    const raw = safe(byId('veh_categoryCode')?.value || byId('book_categoryId')?.value || state.booking?.categoryId || state.booking?.assignedCategoryCode || '').trim();
    if (!raw) return '';
    const categories = Array.isArray(state.lookups?.categories) ? state.lookups.categories : [];
    if (categories.some((c) => safe(c?.code).trim() === raw)) return raw;
    const byRecordId = categories.find((c) => safe(c?.recordId).trim() === raw);
    if (byRecordId?.code) return safe(byRecordId.code).trim();
    const byLabel = categories.find((c) => safe(c?.label).trim() === raw || safe(c?.title).trim() === raw);
    if (byLabel?.code) return safe(byLabel.code).trim();
    if (/^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(raw)) return '';
    return raw;
  }

  function currentVehicleCategoryLabel(){
    return safe(byId('veh_categoryLabel')?.value || byId('book_category')?.value || state.booking?.category || '').trim();
  }

  
  function normalizeVehicleFilterStatus(vehicle){
    const key = safe(vehicle?.selectorStatusKey || '').trim();
    if (key) return key;
    const operational = safe(vehicle?.operationalStatus || '').toLowerCase();
    const status = safe(vehicle?.status || '').toLowerCase();
    if (['service','blocked','inactive'].includes(operational) || ['service','blocked','inactive'].includes(status)) return 'service';
    return vehicle?.available ? 'available' : 'busy';
  }

  function vehicleStatusBadgeClass(vehicle){
    const key = normalizeVehicleFilterStatus(vehicle);
    if (key === 'available') return 'ok';
    if (key === 'assignedThis') return 'info';
    if (key === 'wrongStation') return 'warn';
    if (key === 'service') return 'danger';
    return 'danger';
  }

  function vehicleStatusLabel(vehicle){
    return safe(vehicle?.selectorStatusLabel || '').trim() || safe(vehicle?.operationalStatus || vehicle?.status || '—').trim() || '—';
  }

  function formatVehicleMileage(value){
    const raw = safe(value).trim();
    if (!raw) return '—';
    const n = Number(raw);
    return Number.isFinite(n) ? String(n) : raw;
  }

