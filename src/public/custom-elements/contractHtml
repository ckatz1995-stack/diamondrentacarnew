
<!DOCTYPE html>
<html lang="el">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Contract Pro Editor</title>
  <style>
    :root{
      --bg:#f4f6fa;
      --surface:#ffffff;
      --surface-2:#f8fafc;
      --line:#d7dde7;
      --line-strong:#bcc7d8;
      --text:#132238;
      --muted:#5f6f86;
      --accent:#1f4b8f;
      --accent-soft:#eaf1fb;
      --ok:#0a7a42;
      --warn:#a46400;
      --danger:#b3261e;
      --shadow:0 12px 32px rgba(17,24,39,.08);
      --radius:16px;
      --radius-sm:10px;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
    button,input,select,textarea{font:inherit}
    .app{max-width:1680px;margin:0 auto;padding:18px}
    .topbar{
      background:linear-gradient(180deg,#fff,#f8fbff);
      border:1px solid var(--line);
      border-radius:20px;
      box-shadow:var(--shadow);
      padding:14px 16px;
      display:flex;
      flex-wrap:wrap;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      margin-bottom:16px;
    }
    .brand{display:flex;align-items:center;gap:14px}
    .brand-badge{
      width:44px;height:44px;border-radius:14px;background:var(--accent);
      color:#fff;display:grid;place-items:center;font-weight:800;letter-spacing:.03em
    }
    .brand-copy h1{margin:0;font-size:20px;line-height:1.1}
    .brand-copy .sub{margin-top:4px;color:var(--muted);font-size:13px}
    .chips{display:flex;flex-wrap:wrap;gap:8px}
    .chip{
      background:var(--surface-2);border:1px solid var(--line);
      border-radius:999px;padding:8px 12px;font-size:12px;font-weight:600;color:#2b3c55
    }
    .chip strong{color:var(--text)}
    .toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
    .btn{
      appearance:none;border:1px solid var(--line-strong);background:#fff;color:var(--text);
      padding:10px 14px;border-radius:12px;cursor:pointer;font-weight:700
    }
    .btn:hover{border-color:#8da1c1}
    .btn:disabled{opacity:.55;cursor:not-allowed;filter:grayscale(.12)}
    .btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
    .btn.success{background:#0a7a42;color:#fff;border-color:#0a7a42}
    .btn.warn{background:#fff7ec;color:#8f5200;border-color:#f2c27c}
    .btn.danger{background:#fff1f0;color:#a12f28;border-color:#f3bbb7}
    .btn.ghost{background:transparent}
    .layout{
      display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:16px;align-items:start
    }
    .stack{display:grid;gap:14px}
    .panel{
      background:var(--surface);border:1px solid var(--line);border-radius:20px;
      box-shadow:var(--shadow);overflow:hidden
    }
    .panel-hd{
      padding:14px 16px;border-bottom:1px solid var(--line);
      display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap
    }
    .panel-hd h2,.panel-hd h3{margin:0;font-size:16px}
    .panel-hd .sub{color:var(--muted);font-size:12px;margin-top:4px}
    .panel-bd{padding:16px}
    .grid{display:grid;gap:12px}
    .grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}
    .grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}
    .grid.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}
    .field{display:grid;gap:6px;min-width:0}
    .field label{font-size:12px;font-weight:800;color:#41516a;text-transform:uppercase;letter-spacing:.04em}
    .input,.select,.textarea{
      width:100%;border:1px solid var(--line-strong);border-radius:12px;background:#fff;
      min-height:44px;padding:10px 12px;color:var(--text)
    }
    .input:focus,.select:focus,.textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(31,75,143,.12)}
    .textarea{min-height:108px;resize:vertical}
    .summary-row{
      display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px
    }
    .summary-box{
      background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:12px
    }
    .summary-box .k{font-size:11px;font-weight:800;color:#54657d;text-transform:uppercase;letter-spacing:.05em}
    .summary-box .v{margin-top:6px;font-size:14px;font-weight:700;line-height:1.35;word-break:break-word}
    .section-tools{display:flex;gap:8px;flex-wrap:wrap}
    .tool{
      display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:9px 12px;cursor:pointer;font-weight:700;color:#223249
    }
    .tool:hover{border-color:#8da1c1}
    .inline-note{
      font-size:12px;color:var(--muted);background:#f8fafc;border:1px dashed var(--line-strong);
      border-radius:12px;padding:10px 12px
    }
    .rail{
      position:sticky;top:18px;display:grid;gap:14px
    }
    .charge-list{display:grid;gap:8px}
    .charge{
      display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;
      padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:#fff
    }
    .charge .label{font-size:13px;font-weight:700}
    .charge .meta{font-size:11px;color:var(--muted);margin-top:2px}
    .charge .value{font-size:14px;font-weight:800}
    .totals{
      display:grid;gap:8px;margin-top:8px;padding-top:8px;border-top:1px solid var(--line)
    }
    .total{
      display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center
    }
    .total .name{font-size:13px;color:#3d4f68;font-weight:700}
    .total .amount{font-size:16px;font-weight:800}
    .total.grand .amount,.total.grand .name{font-size:18px;color:var(--accent)}
    .quick-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .status-pill{
      display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;
      font-size:12px;font-weight:800;border:1px solid var(--line)
    }
    .status-pill.pending{background:#fff7e7;color:#8a5600;border-color:#f3d192}
    .status-pill.confirmed{background:#edf8f1;color:#0f6a3d;border-color:#9ed3b3}
    .status-pill.cancelled{background:#fff1f0;color:#a12f28;border-color:#f0b8b4}
    .status-pill.active{background:#eef4ff;color:#214f94;border-color:#bdd0ef}
    .customer-lookup{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px}
    .driver-list{display:grid;gap:10px}
    .driver-card{
      border:1px solid var(--line);border-radius:14px;background:#fff;padding:12px
    }
    .driver-card .row{
      display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px
    }
    .modal-wrap{
      position:fixed;inset:0;display:none;align-items:center;justify-content:center;
      padding:24px;background:rgba(15,23,42,.45);z-index:9999
    }
    .modal-wrap.open{display:flex}
    .modal{
      width:min(1120px,100%);max-height:min(90vh,920px);background:#fff;border-radius:20px;
      border:1px solid rgba(255,255,255,.4);box-shadow:0 30px 80px rgba(15,23,42,.22);
      display:grid;grid-template-rows:auto 1fr auto;overflow:hidden
    }
    .modal.sm{width:min(820px,100%)}
    .modal-hd,.modal-ft{
      padding:14px 16px;border-bottom:1px solid var(--line);background:#fff
    }
    .modal-ft{border-top:1px solid var(--line);border-bottom:none;display:flex;justify-content:flex-end;gap:8px}
    .modal-bd{padding:16px;overflow:auto;background:#fbfcfe}
    .modal-title{margin:0;font-size:18px}
    .modal-sub{margin-top:4px;font-size:12px;color:var(--muted)}
    .hidden{display:none!important}
    .hidden-sync{display:none!important}
    .toast{
      position:fixed;right:18px;bottom:18px;min-width:260px;max-width:440px;background:#15253c;color:#fff;
      border-radius:14px;padding:12px 14px;box-shadow:0 20px 50px rgba(17,24,39,.25);z-index:10020;display:none
    }
    .toast.show{display:block}
    .muted{color:var(--muted)}
    .row-actions{display:flex;gap:8px;flex-wrap:wrap}
    .tag{
      display:inline-flex;align-items:center;border-radius:999px;background:#eef4ff;color:#234f95;padding:4px 9px;font-size:11px;font-weight:800
    }
    .divider{height:1px;background:var(--line);margin:12px 0}
    .products-list{display:flex;flex-wrap:wrap;gap:8px}
    .product-chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 10px;font-size:12px;font-weight:700}
    .empty{
      padding:18px;border:1px dashed var(--line-strong);background:#fff;border-radius:14px;font-size:13px;color:var(--muted)
    }


    .movement-pro-shell{display:grid;gap:14px}
    .movement-cards-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .station-operation-card{border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,#fff 0%,#fbfcff 100%);padding:14px}
    .station-operation-head{display:grid;gap:4px;margin-bottom:12px}
    .station-operation-head h3{margin:0;font-size:16px}
    .station-operation-sub{font-size:12px;color:var(--muted)}
    .station-grid{display:grid;gap:10px}
    .station-row{display:grid;grid-template-columns:130px minmax(0,1fr);gap:10px;align-items:start}
    .station-label{padding-top:11px;font-size:12px;font-weight:800;color:#495a72;text-transform:uppercase;letter-spacing:.05em}
    .station-label.required::before{content:'* ';color:#b45309}
    .station-value{min-width:0}
    .datetime-stack,.station-select-shell,.location-fee-shell,.dual-inline-fields{display:grid;gap:10px}
    .station-select-shell{grid-template-columns:80px minmax(0,1fr)}
    .station-code-badge{min-height:44px;border:1px solid var(--line-strong);border-radius:12px;background:#f8fafc;display:grid;place-items:center;font-weight:800}
    .picker-trigger{appearance:none;width:100%;text-align:left;border:1px solid var(--line-strong);background:#fff;border-radius:12px;padding:10px 12px;min-height:44px;cursor:pointer}
    .picker-trigger.slim{padding:8px 10px}
    .picker-trigger:hover{border-color:#90a3c1}
    .picker-value-main{display:block;font-weight:700;color:var(--text)}
    .picker-value-sub{display:block;margin-top:4px;font-size:12px;color:var(--muted)}
    .location-fee-shell{grid-template-columns:minmax(0,1fr) 120px}
    .fee-amount-box{min-height:44px;border:1px solid var(--line-strong);border-radius:12px;background:#f8fafc;display:grid;place-items:center;font-weight:800}
    .dual-inline-fields{grid-template-columns:repeat(2,minmax(0,1fr))}
    .mini-field{display:grid;gap:6px}
    .mini-field span{font-size:11px;font-weight:800;color:#54657d;text-transform:uppercase;letter-spacing:.05em}
    .movement-inline-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .summary-box.compact{padding:10px 12px}
    .vehicle-pro-shell{display:grid;gap:14px}
    .vehicle-top-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .vehicle-workspace{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(300px,.92fr);gap:14px}
    .vehicle-card{border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,#fff 0%,#fbfcff 100%);padding:14px;display:grid;gap:12px}
    .vehicle-card h3{margin:0;font-size:16px}
    .vehicle-card .subtle{font-size:12px;color:var(--muted)}
    .vehicle-section-label{font-size:11px;font-weight:900;color:#54657d;text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px}
    .vehicle-selector-shell{display:grid;grid-template-columns:110px minmax(0,1fr);gap:10px;align-items:start}
    .vehicle-plate-box{min-height:48px;border:1px solid var(--line-strong);border-radius:12px;background:#f8fafc;display:grid;place-items:center;font-weight:800}
    .vehicle-quick-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .vehicle-stat{border:1px solid var(--line);border-radius:12px;background:#fff;padding:10px 12px}
    .vehicle-stat .k{font-size:11px;font-weight:900;color:#54657d;text-transform:uppercase;letter-spacing:.05em}
    .vehicle-stat .v{margin-top:6px;font-size:14px;font-weight:800;line-height:1.35}
    .products-strip{display:grid;gap:8px}
    .products-placeholder{border:1px dashed var(--line-strong);border-radius:14px;background:#fff;padding:12px;color:var(--muted);font-size:13px}

    /* settings-like central header */
    .app{max-width:none;width:100%;margin:0;padding:0 20px 20px}
    .backroom-header{display:grid;grid-template-columns:minmax(300px,340px) minmax(420px,1fr) auto;gap:0;align-items:stretch;width:100%;background:linear-gradient(135deg,#4b3923 0%,#6c522e 55%,#8e6d3d 100%);border:1px solid rgba(255,255,255,.05);border-radius:0 0 24px 24px;box-shadow:0 22px 48px rgba(15,23,42,.16);padding:0;margin:0 0 16px;overflow:visible;position:relative}
    .backroom-header::after{content:"";position:absolute;left:24px;right:24px;bottom:-10px;height:22px;background:radial-gradient(ellipse at center, rgba(15,23,42,.14), rgba(15,23,42,0) 72%);pointer-events:none;filter:blur(10px)}
    .backroom-brand{display:flex;flex-direction:column;justify-content:center;gap:4px;min-height:82px;padding:14px 18px 14px 78px;position:relative;background:linear-gradient(135deg,#8e6d3d 0%,#a8844a 62%,#6c522e 100%);color:#fff}
    .backroom-brand::before{content:"D";position:absolute;left:20px;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:14px;background:rgba(255,255,255,.16);display:grid;place-items:center;font-size:20px;font-weight:900;letter-spacing:-.03em;box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 8px 18px rgba(0,0,0,.12)}
    .backroom-brand::after{content:"";position:absolute;right:-28px;top:-24px;bottom:-24px;width:74px;background:linear-gradient(120deg,rgba(255,255,255,.18),rgba(255,255,255,0));transform:skewX(-18deg)}
    .backroom-brand b{display:block;font-size:20px;letter-spacing:-.02em;color:#fff}
    .backroom-brand span{display:block;color:rgba(255,255,255,.82);font-size:12px;margin-top:2px}
    .backroom-nav{display:flex;flex-wrap:nowrap;align-items:center;justify-content:center;gap:4px;padding:0 18px;background:linear-gradient(180deg,rgba(255,255,255,.03) 0%,rgba(255,255,255,0) 100%);min-width:0;overflow:auto;scrollbar-width:none}
    .backroom-nav::-webkit-scrollbar{display:none}
    .nav-btn{appearance:none;border:0;background:transparent;color:rgba(255,255,255,.82);padding:0 14px;height:82px;font-weight:800;font-size:14px;cursor:pointer;position:relative;transition:background .18s ease,color .18s ease,transform .18s ease;border-radius:16px;flex:0 0 auto;white-space:nowrap}
    .nav-btn::after{content:"";position:absolute;left:16px;right:16px;bottom:10px;height:3px;border-radius:999px;background:transparent;transition:background .18s ease}
    .nav-btn:hover{background:rgba(255,255,255,.06);color:#fff;transform:translateY(-1px)}
    .nav-btn.active{background:linear-gradient(180deg,rgba(255,255,255,.08) 0%,rgba(255,255,255,.03) 100%);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.08)}
    .nav-btn.active::after{background:#d7b27a}
    .backroom-user{display:flex;justify-content:flex-end;gap:10px;align-items:center;flex-wrap:nowrap;padding:12px 16px;background:linear-gradient(180deg,rgba(79,58,34,.92) 0%,rgba(58,42,24,.98) 100%);border-left:1px solid rgba(255,255,255,.06);position:relative;min-width:430px;overflow:visible}
    .backroom-user::before{content:"";position:absolute;left:-1px;top:14px;bottom:14px;width:1px;background:rgba(255,255,255,.08)}
    .backroom-search{display:flex;align-items:center;min-width:200px;max-width:280px;flex:0 1 260px;height:44px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 8px 18px rgba(0,0,0,.08)}
    .backroom-search input{flex:1;min-width:0;height:100%;border:0;background:transparent;color:#fff;padding:0 14px;font:700 13px/1.2 Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
    .backroom-search input::placeholder{color:rgba(255,255,255,.58)}
    .backroom-search input:focus{outline:none}
    .backroom-search button{appearance:none;border:0;border-left:1px solid rgba(255,255,255,.1);background:transparent;color:#fff;height:100%;padding:0 14px;font-weight:800;cursor:pointer}
    .backroom-search button:hover{background:rgba(255,255,255,.08)}
    .top-chip{padding:8px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);font-size:12px;color:rgba(255,255,255,.72);flex:0 0 auto;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .top-chip strong{color:#fff}
    .quick-apps{position:relative}
    .quick-apps-btn,.top-icon-btn,.header-action-btn{appearance:none;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);color:#fff;border-radius:12px;padding:10px 12px;font-weight:800;cursor:pointer;transition:background .18s ease,border-color .18s ease,transform .18s ease;display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
    .quick-apps-btn:hover,.top-icon-btn:hover,.header-action-btn:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.22);transform:translateY(-1px)}
    .quick-apps-btn::before{content:"☰";font-size:13px;line-height:1}
    .quick-apps-panel{position:absolute;top:calc(100% + 12px);right:0;left:auto;min-width:420px;display:none;padding:14px;background:#3f2e1e;border:1px solid rgba(255,255,255,.08);border-radius:20px;box-shadow:0 22px 44px rgba(15,23,42,.28);z-index:40}
    .quick-apps.open .quick-apps-panel{display:block}
    .quick-apps-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    .quick-app-card{appearance:none;border:1px solid rgba(255,255,255,.08);background:linear-gradient(180deg,#5b4328 0%,#46311d 100%);color:#fff;border-radius:16px;padding:14px;display:flex;flex-direction:column;align-items:flex-start;gap:8px;cursor:pointer;min-height:104px;transition:transform .18s ease,border-color .18s ease,background .18s ease}
    .quick-app-card:hover{transform:translateY(-2px);border-color:rgba(180,138,79,.48);background:linear-gradient(180deg,#71522f 0%,#4c3720 100%)}
    .quick-app-card b{font-size:14px}
    .quick-app-card span{font-size:12px;line-height:1.4;color:rgba(255,255,255,.7);text-align:left}
    .quick-app-icon{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:rgba(255,255,255,.08);font-size:15px}
    .top-icon-group{display:flex;align-items:center;gap:8px;flex:0 0 auto}
    .top-icon-btn .dot{width:8px;height:8px;border-radius:999px;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.18)}
    .contract-toolbar{display:grid;gap:0;background:linear-gradient(180deg,#f6f4ef 0%,#efe8dc 100%);border:1px solid #d9cdb9;border-radius:18px;box-shadow:0 12px 24px rgba(15,23,42,.06);margin:0 0 16px;overflow:hidden}
    .contract-toolbar-row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 12px}
    .contract-toolbar-row.top{background:linear-gradient(180deg,#f9f6f1 0%,#f1eadf 100%);border-bottom:1px solid #dfd2be}
    .contract-toolbar-row.bottom{background:#fff;justify-content:flex-start}
    .toolbar-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap;min-width:0}
    .toolbar-group.grow{flex:1 1 auto}
    .wheel-btn{
      appearance:none;border:1px solid #cfc0a8;background:linear-gradient(180deg,#fff 0%,#f2ebe0 100%);
      color:#3f2f1f;border-radius:10px;padding:9px 12px;font-size:12px;font-weight:800;cursor:pointer;
      box-shadow:inset 0 1px 0 rgba(255,255,255,.75);display:inline-flex;align-items:center;gap:8px;white-space:nowrap
    }
    .wheel-btn:hover{border-color:#b79d77;background:linear-gradient(180deg,#fff 0%,#ede3d2 100%)}
    .wheel-btn.primary{background:linear-gradient(180deg,#8e6d3d 0%,#775729 100%);border-color:#78592e;color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.18)}
    .wheel-btn.success{background:linear-gradient(180deg,#0f766e 0%,#0b5d57 100%);border-color:#0f766e;color:#fff}
    .wheel-btn.warn{background:linear-gradient(180deg,#fff7e9 0%,#f6e7c2 100%);border-color:#dfbf72;color:#8a5a00}
    .wheel-btn.danger{background:linear-gradient(180deg,#fff2f1 0%,#f7ddda 100%);border-color:#e2b2ae;color:#a12f28}
    .wheel-btn.slim{padding:8px 10px;font-size:11px;border-radius:9px}
    .toolbar-badge{
      display:grid;gap:3px;min-width:120px;padding:8px 10px;border:1px solid #dbcdb8;border-radius:12px;
      background:linear-gradient(180deg,#fff 0%,#f7f3eb 100%)
    }
    .toolbar-badge .k{font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;color:#6b5a47}
    .toolbar-badge .v{font-size:13px;font-weight:800;color:#1f2937;line-height:1.2}
    .toolbar-titlebox{display:flex;align-items:center;gap:10px;min-width:260px}
    .toolbar-titlebox .mark{
